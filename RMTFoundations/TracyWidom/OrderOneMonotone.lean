theorem airy_anchor_three_certificate_all_binder_joint_probe :
    airyAiReal (-3)<0 ∧ airyBoundaryVector (-3)≠0 ∧
      (-380/1000:ℝ)≤airyAiReal (-3) ∧ (526/1000:ℝ)≤airyEnergy (-3) ∧
      (∀ j<(55:ℕ), ∀ x∈Icc ((1/4:ℝ)+(j:ℝ)*(1/20))
