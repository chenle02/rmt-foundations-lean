/-- Kernel-checked finite arithmetic totals the lower-square rectangle areas. -/
theorem airy_anchor_three_rectangle_area :
    (1/20:ℝ)*(∑ j∈Finset.range 55,airyAnchorThreeRectq j)=51614777/80000000 := by
  norm_num [Finset.sum_range_succ,airyAnchorThreeRectq]

/-- The ACTUAL first square certificate at a genuinely negative Airy anchor. -/
theorem airy_anchor_three_square_certificate :
    (1/5:ℝ)≤airyAiReal (-3)+(airyEnergy (-3)+
      ‖airyBoundaryVector (-3)+airyHankelShift (-3) (airyBoundaryVector (-3))‖^2)/2 := by
  have hs := airy_anchor_three_scalar_boxes
  apply airy_boundary_of_rectangle_margin (-3) (1/4) (1/20) (526/1000) (-380/1000) (1/5)
    55 airyAnchorThreeRectq (by norm_num) (by norm_num) hs.1 hs.2.2.2.2
    airy_anchor_three_rectangle_table
  rw [airy_anchor_three_rectangle_area]
  norm_num

/-- The concrete integral certificate feeds the same canonical physical resolvent. -/
theorem airy_anchor_three_canonical_boundary_lower :
    (1/5:ℝ)≤airyAiReal (-3)+inner ℝ (airyBoundaryVector (-3))
      (Ring.inverse (1-airyHankelShift (-3)) (airyBoundaryVector (-3))) :=
  airy_anchor_three_square_certificate.trans (airy_square_one_term_lower (-3))

/-- Positive derivative at the certified negative-sign physical anchor. -/
theorem airy_anchor_three_TW1R_derivative_pos : 0<deriv TW1R (-3) := by
  rw [(hasDerivAt_TW1R_canonical_resolvent (-3)).deriv]
  have hb : 0<airyAiReal (-3)+inner ℝ (airyBoundaryVector (-3))
      (Ring.inverse (1-airyHankelShift (-3)) (airyBoundaryVector (-3))) := by
    linarith [airy_anchor_three_canonical_boundary_lower]
  exact div_pos (mul_pos (TW1R_positive_bounds (-3)).1 hb) (by norm_num)

