    airy_eigenbasis_inverse_quadratic_hasSum 0 b lam hd (airyBoundaryVector 0),
    airy_rankOne_operatorDet_eigenbasis 0 b lam hd⟩

theorem airy_canonical_resolvent_identification_all_binder_joint_probe :
    0 < TW1R 0 ∧ airyBoundaryVector 0 ≠ 0 ∧
    (∑' n, airyBoundaryFredholmCoefficient 0 n*(-1:ℝ)^n) =
      TW1R 0*(airyAiReal 0 + inner ℝ (airyBoundaryVector 0)
        (Ring.inverse (1-airyHankelShift 0) (airyBoundaryVector 0))) ∧
    HasDerivAt TW1R
      (TW1R 0*(airyAiReal 0 + inner ℝ (airyBoundaryVector 0)
