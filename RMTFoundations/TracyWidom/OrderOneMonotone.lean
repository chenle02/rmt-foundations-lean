/-- Initial actual scalar boxes propagate to a whole negative-coordinate cell. -/
theorem airy_negative_scalar_cell_box
    (lo hi c d al ah bl bh A T : ℝ /- [definition] -/ )
    (hlo : (-27/5:ℝ)≤lo /- [standing] -/ )
    (hhi : hi≤0 /- [standing] -/ )
    (hc : c∈Icc lo hi /- [standing] -/ )
    (hcenter : al≤airyAiReal c ∧ airyAiReal c≤ah ∧ bl≤deriv airyAiReal c ∧ deriv airyAiReal c≤bh /- [standing] -/ )
    (hdist : ∀ u∈Icc lo hi,|u-c|≤d /- [standing] -/ )
    (hA : 0≤A ∧ -A≤al-d ∧ ah+d≤A /- [standing] -/ )
    (hT : 0≤T ∧ -T≤lo ∧ hi≤T /- [standing] -/ )
    : ∀ u∈Icc lo hi,al-d≤airyAiReal u ∧ airyAiReal u≤ah+d ∧
      bl-T*A*d≤deriv airyAiReal u ∧ deriv airyAiReal u≤bh+T*A*d := by
  have hval (u : ℝ) (hu : u∈Icc lo hi) : al-d≤airyAiReal u ∧ airyAiReal u≤ah+d := by
    have hw : u∈Icc (-27/5:ℝ) 0 := ⟨hlo.trans hu.1,hu.2.trans hhi⟩
    have hcw : c∈Icc (-27/5:ℝ) 0 := ⟨hlo.trans hc.1,hc.2.trans hhi⟩
    have hv := abs_le.mp (airy_rational_window_value_variation u c hw hcw)
    have hd := hdist u hu
    constructor <;> linarith [hcenter.1,hcenter.2.1,hv.1,hv.2]
  have hAi : ∀ u∈Icc lo hi,|airyAiReal u|≤A := by
    intro u hu
    have hh := hval u hu
    apply abs_le.mpr
    constructor <;> linarith [hA.2.1,hA.2.2,hh.1,hh.2]
  have hcoord : ∀ u∈Icc lo hi,|u|≤T := by
    intro u hu
    apply abs_le.mpr
    exact ⟨hT.2.1.trans hu.1,hu.2.trans hT.2.2⟩
  intro u hu
  have hv := hval u hu
  have hp := abs_le.mp (airy_cell_derivative_variation lo hi c u A T hc hu hAi hcoord hA.1 hT.1)
  have he := mul_le_mul_of_nonneg_left (hdist u hu) (mul_nonneg hT.1 hA.1)
  exact ⟨hv.1,hv.2,by linarith [hcenter.2.2.1,hp.1],by linarith [hcenter.2.2.2,hp.2]⟩

def realBoxMulLo
    (a b c d : ℝ /- [definition] -/ )
    : ℝ := min (min (a*c) (a*d)) (min (b*c) (b*d))
def realBoxMulHi
    (a b c d : ℝ /- [definition] -/ )
    : ℝ := max (max (a*c) (a*d)) (max (b*c) (b*d))
theorem real_box_mul_hull
    (u v a b c d : ℝ /- [definition] -/ )
    (hu : a≤u ∧ u≤b /- [standing] -/ )
    (hv : c≤v ∧ v≤d /- [standing] -/ )
    : realBoxMulLo a b c d≤u*v ∧ u*v≤realBoxMulHi a b c d := by
  apply real_box_mul u v a b c d _ _ hu hv
  · unfold realBoxMulLo
    exact ⟨(min_le_left _ _).trans (min_le_left _ _),(min_le_left _ _).trans (min_le_right _ _),
      (min_le_right _ _).trans (min_le_left _ _),(min_le_right _ _).trans (min_le_right _ _)⟩
  · unfold realBoxMulHi
    exact ⟨(le_max_left _ _).trans (le_max_left _ _),(le_max_right _ _).trans (le_max_left _ _),
      (le_max_left _ _).trans (le_max_right _ _),(le_max_right _ _).trans (le_max_right _ _)⟩
def airyRowBoxNumLo
    (al ah bl bh vl vh pl ph : ℝ /- [definition] -/ )
    : ℝ := realBoxMulLo vl vh bl bh-realBoxMulHi al ah pl ph
def airyRowBoxNumHi
    (al ah bl bh vl vh pl ph : ℝ /- [definition] -/ )
    : ℝ := realBoxMulHi vl vh bl bh-realBoxMulLo al ah pl ph
noncomputable def airyRowBoxLo
    (xl xh al ah bl bh vl vh pl ph : ℝ /- [definition] -/ )
    : ℝ := vl+realBoxMulLo (airyRowBoxNumLo al ah bl bh vl vh pl ph)
      (airyRowBoxNumHi al ah bl bh vl vh pl ph) (1/xh) (1/xl)
noncomputable def airyRowBoxHi
    (xl xh al ah bl bh vl vh pl ph : ℝ /- [definition] -/ )
    : ℝ := vh+realBoxMulHi (airyRowBoxNumLo al ah bl bh vl vh pl ph)
      (airyRowBoxNumHi al ah bl bh vl vh pl ph) (1/xh) (1/xl)
noncomputable def realBoxSquareFloor
    (a b : ℝ /- [definition] -/ )
    : ℝ := if 0≤a then a^2 else if b≤0 then b^2 else 0
theorem real_box_square_floor
    (u a b q : ℝ /- [definition] -/ )
    (hu : a≤u ∧ u≤b /- [standing] -/ )
    (hq : q≤realBoxSquareFloor a b /- [standing] -/ )
    : q≤u^2 := by
  apply real_box_sq_lower u a b q hu
  unfold realBoxSquareFloor at hq
  split_ifs at hq with ha hb
  · exact Or.inr (Or.inl ⟨ha,hq⟩)
  · exact Or.inr (Or.inr ⟨hb,hq⟩)
  · exact Or.inl hq
/-- A signed scalar enclosure certifies the physical row on a positive coordinate cell. -/
theorem airy_row_square_of_scalar_boxes
    (s x xl xh al ah bl bh vl vh pl ph q : ℝ /- [definition] -/ )
    (hx : x∈Icc xl xh /- [standing] -/ )
    (hxl : 0<xl /- [standing] -/ )
    (hs : al≤airyAiReal s ∧ airyAiReal s≤ah ∧ bl≤deriv airyAiReal s ∧ deriv airyAiReal s≤bh /- [standing] -/ )
    (ht : vl≤airyAiReal (s+x) ∧ airyAiReal (s+x)≤vh ∧ pl≤deriv airyAiReal (s+x) ∧ deriv airyAiReal (s+x)≤ph /- [standing] -/ )
    (hq : q≤realBoxSquareFloor (airyRowBoxLo xl xh al ah bl bh vl vh pl ph)
      (airyRowBoxHi xl xh al ah bl bh vl vh pl ph)  /- [standing] -/ )
    : q≤airyCompletedRow s x^2 := by
  have hmb := real_box_mul_hull (airyAiReal (s+x)) (deriv airyAiReal s)
    vl vh bl bh ⟨ht.1,ht.2.1⟩ ⟨hs.2.2.1,hs.2.2.2⟩
  have hma := real_box_mul_hull (airyAiReal s) (deriv airyAiReal (s+x))
    al ah pl ph ⟨hs.1,hs.2.1⟩ ⟨ht.2.2.1,ht.2.2.2⟩
  have hn : airyRowBoxNumLo al ah bl bh vl vh pl ph≤
      airyAiReal (s+x)*deriv airyAiReal s-airyAiReal s*deriv airyAiReal (s+x) ∧
      airyAiReal (s+x)*deriv airyAiReal s-airyAiReal s*deriv airyAiReal (s+x)≤
        airyRowBoxNumHi al ah bl bh vl vh pl ph := by
    unfold airyRowBoxNumLo airyRowBoxNumHi
    constructor <;> linarith [hmb.1,hmb.2,hma.1,hma.2]
  have hxpos := hxl.trans_le hx.1
  have hinv : 1/xh≤1/x ∧ 1/x≤1/xl :=
    ⟨one_div_le_one_div_of_le hxpos hx.2,one_div_le_one_div_of_le hxl hx.1⟩
  have hf := real_box_mul_hull
    (airyAiReal (s+x)*deriv airyAiReal s-airyAiReal s*deriv airyAiReal (s+x)) (1/x)
    (airyRowBoxNumLo al ah bl bh vl vh pl ph) (airyRowBoxNumHi al ah bl bh vl vh pl ph)
    (1/xh) (1/xl) hn hinv
  apply real_box_square_floor _ _ _ q _ hq
  unfold airyRowBoxLo airyRowBoxHi airyCompletedRow
  rw [airy_completed_row_wronskian s x hxpos.ne']
  simp only [div_eq_mul_inv] at hf ⊢
  simp only [one_div,mul_comm (deriv airyAiReal (s+x)) (airyAiReal s)] at hf ⊢
  constructor <;> linarith [ht.1,ht.2.1,hf.1,hf.2]


/-- Signed scalar boxes certify the actual negative-shift Airy energy. -/
theorem airy_energy_lower_of_scalar_boxes
    (s sh al ah bl bh e : ℝ /- [definition] -/ )
    (hsh : s ≤ sh ∧ sh ≤ 0 /- [standing] -/ )
