/-- Resolvent completion of the square. The square inverse acts on g+B g,
so no sign of the odd spectral contribution is required. Conditional. -/
theorem resolvent_square_completion
    {E : Type* /- [definition] -/ }
    [NormedAddCommGroup E /- [definition] -/ ]
    [InnerProductSpace ℝ E /- [definition] -/ ]
    (B R S : E →L[ℝ] E /- [definition] -/ )
    (hsym : ∀ x y, inner ℝ (B x) y = inner ℝ x (B y)  /- [standing] -/ )
    (hright : ∀ x, R x - B (R x) = x /- [standing] -/ )
    (hsleft : ∀ x, S (x - B (B x)) = x /- [standing] -/ )
    (g : E /- [definition] -/ )
    : inner ℝ g (R g) = inner ℝ g g / 2 +
        inner ℝ (g + B g) (S (g + B g)) / 2 := by
  have hb : B (R g) = R g - g := by
    apply eq_sub_iff_add_eq.mpr
    simpa [add_comm] using (sub_eq_iff_eq_add.mp (hright g)).symm
  have hd : R g - B (B (R g)) = g + B g := by
    rw [hb, map_sub, hb]
    abel
  have hs : S (g + B g) = R g := by
    rw [← hd]
    exact hsleft (R g)
  rw [hs, inner_add_left, hsym, hb, inner_sub_right]
  ring

/-- First two terms of the POSITIVE square resolvent, applied to the
completed-square vector. This permits negative eigenvalues of B. -/
theorem resolvent_square_two_term_lower
    {E : Type* /- [definition] -/ }
    [NormedAddCommGroup E /- [definition] -/ ]
    [InnerProductSpace ℝ E /- [definition] -/ ]
    (B R S : E →L[ℝ] E /- [definition] -/ )
    (hK : ‖B ∘L B‖ < 1 /- [standing] -/ )
    (hsym : ∀ x y, inner ℝ (B x) y = inner ℝ x (B y)  /- [standing] -/ )
    (hright : ∀ x, R x - B (R x) = x /- [standing] -/ )
    (hsright : ∀ x, S x - B (B (S x)) = x /- [standing] -/ )
    (hsleft : ∀ x, S (x - B (B x)) = x /- [standing] -/ )
    (g : E /- [definition] -/ )
    : (inner ℝ g g + ‖g + B g‖^2 + ‖B (g + B g)‖^2) / 2 ≤
        inner ℝ g (R g) := by
  have hsymK : ∀ x y, inner ℝ ((B ∘L B) x) y = inner ℝ x ((B ∘L B) y) := by
    intro x y
    exact (hsym (B x) y).trans (hsym x (B y))
  have h := contraction_resolvent_polynomial_lower (B ∘L B) S hK hsymK
    hsright hsleft (g + B g)
  have he : inner ℝ (g+B g) ((B ∘L B) (g+B g)) = ‖B (g+B g)‖^2 := by
    rw [ContinuousLinearMap.comp_apply, ← hsym, real_inner_self_eq_norm_sq]
  rw [he,real_inner_self_eq_norm_sq] at h
  rw [resolvent_square_completion B R S hsym hright hsleft g]
  linarith

theorem airy_resolvent_square_completion
    (s : ℝ /- [definition] -/ )
    : airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) =
      airyAiReal s + airyEnergy s / 2 +
        inner ℝ (airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s))
          (Ring.inverse (1-airyKernelShift s)
            (airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s))) / 2 := by
  have he := resolvent_square_completion (airyHankelShift s)
    (Ring.inverse (1-airyHankelShift s)) (Ring.inverse (1-airyKernelShift s))
    (isSelfAdjoint_airyHankelShift s).isSymmetric
    (contraction_ringInverse_right _ (norm_airyHankelShift_lt_one s))
    (contraction_ringInverse_left _ (norm_airyKernelShift_lt_one s)) (airyBoundaryVector s)
  rw [airyBoundaryVector_inner_self] at he
  linarith

/-- Canonical all-shift bound; both inverse identities are discharged. -/
theorem airy_square_two_term_lower
    (s : ℝ /- [definition] -/ )
    : airyAiReal s + (airyEnergy s +
        ‖airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s)‖^2 +
        ‖airyHankelShift s (airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s))‖^2) / 2 ≤
      airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  have he := resolvent_square_two_term_lower (airyHankelShift s)
    (Ring.inverse (1-airyHankelShift s)) (Ring.inverse (1-airyKernelShift s))
    (norm_airyKernelShift_lt_one s) (isSelfAdjoint_airyHankelShift s).isSymmetric
    (contraction_ringInverse_right _ (norm_airyHankelShift_lt_one s))
    (contraction_ringInverse_right _ (norm_airyKernelShift_lt_one s))
    (contraction_ringInverse_left _ (norm_airyKernelShift_lt_one s)) (airyBoundaryVector s)
  rw [airyBoundaryVector_inner_self] at he
  linarith

theorem airy_square_one_term_lower
    (s : ℝ /- [definition] -/ )
    : airyAiReal s + (airyEnergy s +
        ‖airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s)‖^2) / 2 ≤
      airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  have h := airy_square_two_term_lower s
  nlinarith [sq_nonneg ‖airyHankelShift s
    (airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s))‖]

/-- Expanded certificate, exposing its exact gain over the cubic bound. -/
theorem airy_square_one_term_expanded
    (s : ℝ /- [definition] -/ )
    : airyAiReal s + (airyEnergy s +
        ‖airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s)‖^2) / 2 =
      airyAiReal s + airyEnergy s +
        (∫ x, airyAiReal (s+x) * airyKernelIntegral (x+s) s ∂halfLineMeasure) +
        ‖airyHankelShift s (airyBoundaryVector s)‖^2 / 2 := by
  rw [norm_add_sq_real,airyBoundaryVector_cubic_moment]
  have he := airyBoundaryVector_inner_self s
  rw [real_inner_self_eq_norm_sq] at he
  rw [he]
  ring

/-- Positive square is insufficient for a sign claim about H+H² or a
negative-offset boundary. All operators and vectors are nonzero. -/
theorem square_positive_sign_counterprobe :
    ∃ B R S : ℝ →L[ℝ] ℝ, ∃ g a : ℝ,
      g ≠ 0 ∧ B g ≠ 0 ∧ a < 0 ∧ ‖B‖ < 1 ∧ ‖B ∘L B‖ < 1 ∧
      (∀ x y, inner ℝ (B x) y = inner ℝ x (B y)) ∧
      (∀ x, R x-B (R x)=x) ∧ (∀ x, R (x-B x)=x) ∧
      (∀ x, S x-B (B (S x))=x) ∧ (∀ x, S (x-B (B x))=x) ∧
      (∀ x, 0 ≤ inner ℝ x (B (B x))) ∧
      inner ℝ g ((B+B ∘L B) g) < 0 ∧
      a+inner ℝ g (R g) < 0 ∧
      inner ℝ g (R g) = inner ℝ g g/2 + inner ℝ (g+B g) (S (g+B g))/2 := by
  let B : ℝ →L[ℝ] ℝ := (-1/2:ℝ) • ContinuousLinearMap.id ℝ ℝ
  let R : ℝ →L[ℝ] ℝ := (2/3:ℝ) • ContinuousLinearMap.id ℝ ℝ
  let S : ℝ →L[ℝ] ℝ := (4/3:ℝ) • ContinuousLinearMap.id ℝ ℝ
  refine ⟨B,R,S,1,-1,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩
  · norm_num
  · norm_num [B]
  · norm_num
  · norm_num [B,norm_smul,ContinuousLinearMap.norm_id]
  · calc ‖B ∘L B‖ ≤ ‖B‖*‖B‖ := ContinuousLinearMap.opNorm_comp_le _ _
         _ < 1 := by norm_num [B,norm_smul,ContinuousLinearMap.norm_id]
  · intro x y
    simp [B,mul_assoc]
    ring
  · intro x
    simp [B,R]
    ring
  · intro x
    simp [B,R]
    ring
  · intro x
    simp [B,S]
    ring
  · intro x
    simp [B,S]
    ring
  · intro x
    have hsB : ∀ y z, inner ℝ (B y) z = inner ℝ y (B z) := by
      intro y z
      simp [B,mul_assoc]
      ring
    rw [← hsB x (B x),real_inner_self_eq_norm_sq]
    exact sq_nonneg _
  · norm_num [B,ContinuousLinearMap.comp_apply,ContinuousLinearMap.add_apply]
  · norm_num [R]
  · norm_num [B,R,S]

/-- Actual negative Airy shift simultaneously inhabits ALL canonical square
premises and both bounds. No positivity certificate is assumed. -/
theorem airy_square_all_binder_joint_probe :
    ∃ s : ℝ, s < 0 ∧ airyAiReal s < 0 ∧ airyBoundaryVector s ≠ 0 ∧
      ‖airyHankelShift s‖ < 1 ∧ ‖airyKernelShift s‖ < 1 ∧
      (∀ x, Ring.inverse (1-airyHankelShift s) x -
        airyHankelShift s (Ring.inverse (1-airyHankelShift s) x) = x) ∧
      (∀ x, Ring.inverse (1-airyKernelShift s) x -
        airyKernelShift s (Ring.inverse (1-airyKernelShift s) x) = x) ∧
      (∀ x, Ring.inverse (1-airyKernelShift s) (x-airyKernelShift s x) = x) ∧
      airyAiReal s + (airyEnergy s +
        ‖airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s)‖^2 +
        ‖airyHankelShift s (airyBoundaryVector s + airyHankelShift s (airyBoundaryVector s))‖^2)/2 ≤
      airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  obtain ⟨s,hs,ha⟩ := Ai_negative_witness
  exact ⟨s,hs,ha,airyBoundaryVector_ne_zero s,norm_airyHankelShift_lt_one s,
    norm_airyKernelShift_lt_one s,contraction_ringInverse_right _ (norm_airyHankelShift_lt_one s),
    contraction_ringInverse_right _ (norm_airyKernelShift_lt_one s),
    contraction_ringInverse_left _ (norm_airyKernelShift_lt_one s),airy_square_two_term_lower s⟩

/-- The square-resolvent expansion consists of genuine nonnegative squared
norms, even for a symmetric operator with negative eigenvalues. -/
theorem square_resolvent_norms_hasSum
    {E : Type* /- [definition] -/ }
    [NormedAddCommGroup E /- [definition] -/ ]
    [InnerProductSpace ℝ E /- [definition] -/ ]
    [CompleteSpace E /- [definition] -/ ]
    (B : E →L[ℝ] E /- [definition] -/ )
    (hB : ‖B‖ < 1 /- [standing] -/ )
    (hsym : ∀ x y, inner ℝ (B x) y = inner ℝ x (B y)  /- [standing] -/ )
    (g : E /- [definition] -/ )
    : HasSum (fun n : ℕ => ‖(B^n) g‖^2)
      (inner ℝ g (Ring.inverse (1-B ∘L B) g)) := by
  have hK : ‖B ∘L B‖ < 1 := by
    have hn := ContinuousLinearMap.opNorm_comp_le B B
    nlinarith [norm_nonneg B]
  have h := ((hasSum_geom_series_inverse (B ∘L B) hK).mapL
    (ContinuousLinearMap.apply ℝ E g)).mapL (innerSL ℝ g)
  convert! h using 1
  funext n
  have hp : (B ∘L B)^n = B^n * B^n := by
    have he : B ∘L B = B^2 := by rw [pow_two]; rfl
    rw [he,← pow_mul,show 2*n=n+n by omega,pow_add]
  change ‖(B^n) g‖^2 = inner ℝ g (((B ∘L B)^n) g)
  rw [hp,ContinuousLinearMap.mul_apply]
  have hsymn := (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr hsym).pow n
  have hs : ∀ x y, inner ℝ ((B^n) x) y = inner ℝ x ((B^n) y) :=
    ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp hsymn
  rw [← hs g ((B^n) g),real_inner_self_eq_norm_sq]

theorem airy_completed_square_norms_hasSum
    (s : ℝ /- [definition] -/ )
    : HasSum (fun n : ℕ => ‖(airyHankelShift s^n)
        (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s))‖^2)
      (2*(airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)))-
        2*airyAiReal s-airyEnergy s) := by
  have h := square_resolvent_norms_hasSum (airyHankelShift s)
    (norm_airyHankelShift_lt_one s) (isSelfAdjoint_airyHankelShift s).isSymmetric
    (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s))
  convert! h using 1
  have he := airy_resolvent_square_completion s
  change _ = inner ℝ (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s))
    (Ring.inverse (1-airyKernelShift s)
      (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s)))
  linarith

/-- Every finite completed-square certificate is a true lower bound for the
physical boundary resolvent, without a numeric sign premise. -/
theorem airy_completed_square_finite_lower
    (s : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    : airyAiReal s+(airyEnergy s+
        ∑ n ∈ Finset.range N, ‖(airyHankelShift s^n)
          (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s))‖^2)/2 ≤
      airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  have h := airy_completed_square_norms_hasSum s
  have hl := h.summable.sum_le_tsum (Finset.range N) (fun n hn => sq_nonneg _) 
  rw [h.tsum_eq] at hl
  linarith

/-- Exact assembly condition: global monotonicity is equivalent to the sign
of the ALREADY IDENTIFIED canonical physical boundary, not an assumed bridge. -/
theorem monotone_TW1R_iff_canonical_boundary_nonneg :
    Monotone TW1R ↔ ∀ s : ℝ, 0 ≤ airyAiReal s+inner ℝ (airyBoundaryVector s)
      (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  constructor
  · intro hm s
    have hd : 0 ≤ deriv TW1R s := hm.deriv_nonneg
    rw [(hasDerivAt_TW1R_canonical_resolvent s).deriv] at hd
    have ht := (TW1R_positive_bounds s).1
    nlinarith
  · intro ha
    apply monotone_of_hasDerivAt_nonneg hasDerivAt_TW1R_canonical_resolvent
    intro s
    exact div_nonneg (mul_nonneg (TW1R_positive_bounds s).1.le (ha s)) (by norm_num)


/-- Nonzero actual Airy row jointly inhabits the full series and ALL finite
truncations. Its energy is strictly positive. -/
theorem airy_completed_series_joint_probe :
    ∃ s : ℝ, airyBoundaryVector s ≠ 0 ∧ 0 < airyEnergy s ∧
      HasSum (fun n : ℕ => ‖(airyHankelShift s^n)
        (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s))‖^2)
      (2*(airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)))-
        2*airyAiReal s-airyEnergy s) ∧
      (∀ N : ℕ, airyAiReal s+(airyEnergy s+
        ∑ n ∈ Finset.range N, ‖(airyHankelShift s^n)
          (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s))‖^2)/2 ≤
      airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) :=
  ⟨0,airyBoundaryVector_ne_zero 0,airyEnergy_pos 0,airy_completed_square_norms_hasSum 0,
    airy_completed_square_finite_lower 0⟩

/-- Control the completed-square vector by independent vector and operator
errors. No positivity of either approximate operator is presumed. -/
theorem completed_vector_error
    {E : Type* /- [definition] -/ }
    [NormedAddCommGroup E /- [definition] -/ ]
    [NormedSpace ℝ E /- [definition] -/ ]
    (B C : E →L[ℝ] E /- [definition] -/ )
    (g h : E /- [definition] -/ )
    (ε δ : ℝ /- [definition] -/ )
    (hB : ‖B‖ ≤ 1 /- [standing] -/ )
    (hg : ‖g-h‖ ≤ ε /- [standing] -/ )
    (hBC : ‖B-C‖ ≤ δ /- [standing] -/ )
    : ‖(g+B g)-(h+C h)‖ ≤ 2*ε+δ*‖h‖ := by
  have he : (g+B g)-(h+C h) = (g-h)+B (g-h)+(B-C) h := by
    simp only [map_sub,ContinuousLinearMap.sub_apply]
    abel
  rw [he]
  calc
    ‖(g-h)+B (g-h)+(B-C) h‖ ≤ ‖g-h‖+‖B (g-h)‖+‖(B-C) h‖ :=
      by
        calc _ ≤ ‖(g-h)+B (g-h)‖+‖(B-C) h‖ := norm_add_le _ _
             _ ≤ ‖g-h‖+‖B (g-h)‖+‖(B-C) h‖ := by gcongr; exact norm_add_le _ _
    _ ≤ ‖g-h‖+‖B‖*‖g-h‖+‖B-C‖*‖h‖ := by
      gcongr
      · exact B.le_opNorm (g-h)
      · exact (B-C).le_opNorm h
    _ ≤ ε+1*ε+δ*‖h‖ := by
      gcongr
    _ = 2*ε+δ*‖h‖ := by ring

/-- Turn any certified norm error into a nonnegative lower radius. -/
theorem norm_radius_of_error
    {E : Type* /- [definition] -/ }
    [NormedAddCommGroup E /- [definition] -/ ]
    (g h : E /- [definition] -/ )
    (ε : ℝ /- [definition] -/ )
    (hg : ‖g-h‖ ≤ ε /- [standing] -/ )
    : max 0 (‖h‖-ε) ≤ ‖g‖ := by
  apply max_le (norm_nonneg _)
  have hn := norm_sub_norm_le h g
  rw [norm_sub_rev] at hn
  linarith

/-- All error-transfer premises jointly hold on a nonzero negative contraction,
with nonzero operator and vector errors, rather than only at zero errors. -/
theorem completed_vector_error_joint_probe :
    ∃ B C : ℝ →L[ℝ] ℝ, ∃ g h ε δ : ℝ,
      B 1 ≠ 0 ∧ C 1 ≠ 0 ∧ g ≠ 0 ∧ h ≠ 0 ∧ g ≠ h ∧ B ≠ C ∧
      0 < ε ∧ 0 < δ ∧ ‖B‖ ≤ 1 ∧ ‖g-h‖ ≤ ε ∧ ‖B-C‖ ≤ δ ∧
      ‖(g+B g)-(h+C h)‖ ≤ 2*ε+δ*‖h‖ := by
  let B : ℝ →L[ℝ] ℝ := (-1/2:ℝ) • ContinuousLinearMap.id ℝ ℝ
  let C : ℝ →L[ℝ] ℝ := (-1/4:ℝ) • ContinuousLinearMap.id ℝ ℝ
  refine ⟨B,C,1,2,1,1/4,?_,?_,by norm_num,by norm_num,by norm_num,?_,
    by norm_num,by norm_num,?_,by norm_num,?_,?_⟩
  · norm_num [B]
  · norm_num [C]
  · intro he
    have h := congrArg (fun T : ℝ →L[ℝ] ℝ => T 1) he
    norm_num [B,C] at h
  · norm_num [B,norm_smul,ContinuousLinearMap.norm_id]
  · have he : B-C = (-1/4:ℝ) • ContinuousLinearMap.id ℝ ℝ := by
      ext x
      simp [B,C]
      ring
    rw [he]
    norm_num [norm_smul,ContinuousLinearMap.norm_id]
  · norm_num [B,C]

/-- A sound error budget for transferring independently certified finite
approximations to the actual infinite-dimensional boundary lower bound.
This theorem supplies NO missing interval estimates or positivity premise. -/
theorem airy_completed_square_error_lower
    (s b η ε δ : ℝ /- [definition] -/ )
    (h : Lp ℝ 2 halfLineMeasure /- [standing] -/ )
    (C : Lp ℝ 2 halfLineMeasure →L[ℝ] Lp ℝ 2 halfLineMeasure /- [definition] -/ )
    (ha : |airyAiReal s-b| ≤ η /- [standing] -/ )
    (hg : ‖airyBoundaryVector s-h‖ ≤ ε /- [standing] -/ )
    (hC : ‖airyHankelShift s-C‖ ≤ δ /- [standing] -/ )
    : b-η+((max 0 (‖h‖-ε))^2+
        (max 0 (‖h+C h‖-(2*ε+δ*‖h‖)))^2)/2 ≤
      airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  have hr1 := norm_radius_of_error (airyBoundaryVector s) h ε hg
  have herr := completed_vector_error (airyHankelShift s) C (airyBoundaryVector s) h ε δ
    (norm_airyHankelShift_lt_one s).le hg hC
  have hr2 := norm_radius_of_error
    (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s)) (h+C h)
    (2*ε+δ*‖h‖) herr
  have hs1 := sq_le_sq₀ (le_max_left (0:ℝ) _) (norm_nonneg _) |>.mpr hr1
  have hs2 := sq_le_sq₀ (le_max_left (0:ℝ) _) (norm_nonneg _) |>.mpr hr2
  have haa := (abs_le.mp ha).1
  have hl := airy_square_one_term_lower s
  rw [airyBoundaryVector_norm_sq] at hs1
  nlinarith

/-- Every error-budget binder is jointly inhabited by the same genuine
nonzero Airy row and actual Hankel operator; no unsatisfiable bundle is used. -/
theorem airy_completed_square_error_joint_probe :
    ∃ s b η ε δ : ℝ, ∃ h : Lp ℝ 2 halfLineMeasure,
      ∃ C : Lp ℝ 2 halfLineMeasure →L[ℝ] Lp ℝ 2 halfLineMeasure,
      h ≠ 0 ∧ b > 0 ∧ |airyAiReal s-b| ≤ η ∧
      ‖airyBoundaryVector s-h‖ ≤ ε ∧ ‖airyHankelShift s-C‖ ≤ δ ∧
      b-η+((max 0 (‖h‖-ε))^2+
        (max 0 (‖h+C h‖-(2*ε+δ*‖h‖)))^2)/2 ≤
      airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  refine ⟨0,airyAiReal 0,0,0,0,airyBoundaryVector 0,airyHankelShift 0,
    airyBoundaryVector_ne_zero 0,airyAiReal_zero_pos,?_,?_,?_,?_⟩
  · simp
  · simp
  · simp
  · exact airy_completed_square_error_lower 0 (airyAiReal 0) 0 0 0
      (airyBoundaryVector 0) (airyHankelShift 0) (by simp) (by simp) (by simp)

/-- Actual monotonicity on the nonnegative half-line, assembled from the
physical derivative and the unconditional boundary positivity. -/
theorem strictMonoOn_TW1R_nonnegative : StrictMonoOn TW1R (Ici 0) := by
  apply strictMonoOn_of_deriv_pos (convex_Ici 0) TW1R_continuous.continuousOn
  intro s hs
  have hn : 0 ≤ s := interior_subset hs
