/-- Completed-row representative is continuous on the actual real half-line. -/
theorem airyCompletedRow_continuous
    (s : ℝ /- [definition] -/ )
    : Continuous (airyCompletedRow s) := by
  change Continuous (fun x : ℝ => airyAiReal (s+x)+airyKernelIntegral (x+s) s)
