  let v : ℝ := ∑ n ∈ Finset.range 32,normalizedHGCoeff (4/3) n*(-3:ℝ)^n
  have hu : (-694730/1000000:ℝ)≤u ∧ u≤-694729/1000000 := ⟨hp.1,hp.2.1⟩
  have hv : (-170217/1000000:ℝ)≤v ∧ v≤-170216/1000000 := hp.2.2
  have hb : (774/1000:ℝ)≤deriv airyAiReal 0*(-3) ∧ deriv airyAiReal 0*(-3)≤777/1000 := by
    constructor <;> linarith [hi.2.2.1,hi.2.2.2]
  have hl0 : (356/1000:ℝ)*(-694730/1000000)≤airyAiReal 0*u := by
    calc _ ≤ airyAiReal 0*(-694730/1000000) := mul_le_mul_of_nonpos_right hi.2.1 (by norm_num)
         _ ≤ airyAiReal 0*u := mul_le_mul_of_nonneg_left hu.1 airyAiReal_zero_pos.le
  have hh0 : airyAiReal 0*u≤(355/1000:ℝ)*(-694729/1000000) := by
    calc _ ≤ airyAiReal 0*(-694729/1000000) := mul_le_mul_of_nonneg_left hu.2 airyAiReal_zero_pos.le
         _ ≤ _ := mul_le_mul_of_nonpos_right hi.1 (by norm_num)
  have hl1 : (777/1000:ℝ)*(-170217/1000000)≤deriv airyAiReal 0*(-3)*v := by
    calc _ ≤ deriv airyAiReal 0*(-3)*(-170217/1000000) := mul_le_mul_of_nonpos_right hb.2 (by norm_num)
         _ ≤ _ := mul_le_mul_of_nonneg_left hv.1 (by linarith [hb.1])
  have hh1 : deriv airyAiReal 0*(-3)*v≤(774/1000:ℝ)*(-170216/1000000) := by
