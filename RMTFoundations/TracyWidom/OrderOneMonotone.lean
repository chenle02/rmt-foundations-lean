/-- Pointwise representative of the genuine completed square. -/
noncomputable def airyCompletedRow
    (s x : ℝ /- [definition] -/ )
    : ℝ := airyAiReal (s+x)+airyKernelIntegral (x+s) s

/-- Both genuine L2 summands have this continuous scalar representative. -/
theorem airy_completed_row_apply_ae
    (s : ℝ /- [definition] -/ )
    : airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s) =ᵐ[halfLineMeasure]
      airyCompletedRow s := by
  filter_upwards [Lp.coeFn_add (airyBoundaryVector s) (airyHankelShift s (airyBoundaryVector s)),
    airyBoundaryVector_apply_ae s,airyBoundaryVector_hankel_apply_ae s] with x h0 h1 h2
  simp only [h0,Pi.add_apply,h1,h2,airyCompletedRow]

/-- The actual square is integrable; no quadrature or tail premise is needed. -/
theorem airy_completed_row_sq_integrable
    (s : ℝ /- [definition] -/ )
    : Integrable (fun x => airyCompletedRow s x^2) halfLineMeasure := by
  apply ((Lp.memLp (airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s))).integrable_sq).congr
  filter_upwards [airy_completed_row_apply_ae s] with x hx
  rw [hx]

/-- Exact scalar integral of the physical completed-square norm. -/
theorem airy_completed_row_sq_integral
    (s : ℝ /- [definition] -/ )
    : ∫ x, airyCompletedRow s x^2 ∂halfLineMeasure =
      ‖airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s)‖^2 := by
  rw [← real_inner_self_eq_norm_sq,L2.inner_def]
  apply integral_congr_ae
  filter_upwards [airy_completed_row_apply_ae s] with x hx
  simp only [hx,real_inner_self_eq_norm_sq,Real.norm_eq_abs,sq_abs]

/-- Restrict the positive square to any measurable window: omitted tails cannot
invalidate a lower certificate. -/
theorem airy_restricted_square_lower
    (s : ℝ /- [definition] -/ )
    (U : Set ℝ /- [definition] -/ )
    : airyAiReal s+(airyEnergy s+
        ∫ x in U, airyCompletedRow s x^2 ∂halfLineMeasure)/2 ≤
      airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  have hl := setIntegral_le_integral (s := U) (airy_completed_row_sq_integrable s)
    (Eventually.of_forall fun x => sq_nonneg (airyCompletedRow s x))
  rw [airy_completed_row_sq_integral s] at hl
  linarith [airy_square_one_term_lower s]

/-- Concrete nonzero Airy data jointly inhabit the restricted-square theorems,
including a nonempty finite rational integration window. -/
theorem airy_restricted_square_joint_probe :
    ∃ s : ℝ, airyBoundaryVector s ≠ 0 ∧ airyEnergy s > 0 ∧
      Integrable (fun x => airyCompletedRow s x^2) halfLineMeasure ∧
      airyAiReal s+(airyEnergy s+
        ∫ x in Icc (1/4:ℝ) 3, airyCompletedRow s x^2 ∂halfLineMeasure)/2 ≤
      airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) :=
  ⟨0,airyBoundaryVector_ne_zero 0,airyEnergy_pos 0,airy_completed_row_sq_integrable 0,
    airy_restricted_square_lower 0 (Icc (1/4) 3)⟩


/-- Actual Airy decay, with the exponential majorant. -/
theorem airy_scalar_tendsto_zero : Tendsto airyAiReal atTop (𝓝 0) := by
  obtain ⟨C,hC,h⟩ := airyAiReal_abs_le_exp'
  have ht := Real.tendsto_exp_neg_atTop_nhds_zero.const_mul C
  simp only [mul_zero] at ht
  exact squeeze_zero_norm' (Eventually.of_forall fun x => by simpa only [Real.norm_eq_abs] using h x) ht

/-- The first derivative decays, derived from the actual energy identity. -/
theorem airy_scalar_deriv_tendsto_zero : Tendsto (deriv airyAiReal) atTop (𝓝 0) := by
  obtain ⟨C,hC,h⟩ := airyAiReal_abs_le_exp'
  have ht : Tendsto (fun t : ℝ => t * (airyAiReal t)^2) atTop (𝓝 0) := by
    apply squeeze_zero'
      (by filter_upwards [eventually_ge_atTop 0] with t ht; positivity)
      (by
        filter_upwards [eventually_ge_atTop 0] with t ht
        calc t*(airyAiReal t)^2 = t*|airyAiReal t|^2 := by rw [sq_abs]
             _ ≤ t*(C*Real.exp (-t))^2 := mul_le_mul_of_nonneg_left
               (pow_le_pow_left₀ (abs_nonneg _) (h t) 2) ht
             _ = C^2*(t*Real.exp (-(2*t))) := by rw [mul_pow,exp_neg_sq]; ring
             _ ≤ C^2*Real.exp (-t) := by
               apply mul_le_mul_of_nonneg_left _ (sq_nonneg C)
               calc t*Real.exp (-(2*t)) ≤ Real.exp t*Real.exp (-(2*t)) :=
                      mul_le_mul_of_nonneg_right (by linarith [Real.add_one_le_exp t]) (Real.exp_pos _).le
                    _ = Real.exp (-t) := by rw [← Real.exp_add]; ring_nf)
      (by simpa using Real.tendsto_exp_neg_atTop_nhds_zero.const_mul (C^2))
  have ht2 : Tendsto (fun t => (deriv airyAiReal t)^2) atTop (𝓝 0) := by
    convert! airyEnergy_tendsto_zero.add ht using 1 <;> simp [airyEnergy]
  have hn : Tendsto (fun t => ‖deriv airyAiReal t‖) atTop (𝓝 0) := by
    convert! Real.continuous_sqrt.continuousAt.tendsto.comp ht2 using 1 <;>
      simp [Function.comp_def,Real.sqrt_sq_eq_abs,Real.norm_eq_abs]
  exact tendsto_zero_iff_norm_tendsto_zero.mpr hn

/-- Exact off-diagonal Airy-kernel formula from the physical integral and ODE. -/
theorem airyKernelIntegral_wronskian
    (x y : ℝ /- [definition] -/ )
    (hne : x ≠ y /- [standing] -/ )
    : airyKernelIntegral x y =
      (airyAiReal x * deriv airyAiReal y-deriv airyAiReal x * airyAiReal y)/(x-y) := by
  let F : ℝ → ℝ := fun t =>
    (airyAiReal (x+t)*deriv airyAiReal (y+t)-deriv airyAiReal (x+t)*airyAiReal (y+t))/(y-x)
  have hd : ∀ t, HasDerivAt F (airyAiReal (x+t)*airyAiReal (y+t)) t := by
    intro t
    have hx := (hasDerivAt_id t).const_add x
    have hy := (hasDerivAt_id t).const_add y
    have h1 := (hasDerivAt_airyAiReal' (x+t)).comp t hx
    have h2 := (hasDerivAt_airyAiReal' (y+t)).comp t hy
    have h3 := (hasDerivAt_deriv_airyAiReal' (x+t)).comp t hx
    have h4 := (hasDerivAt_deriv_airyAiReal' (y+t)).comp t hy
    convert! ((h1.mul h4).sub (h3.mul h2)).div_const (y-x) using 1
    dsimp [Function.comp_def]
    field_simp [sub_ne_zero.mpr hne.symm]
    ring
  have tx := tendsto_atTop_add_const_left atTop x tendsto_id
  have ty := tendsto_atTop_add_const_left atTop y tendsto_id
  have ht : Tendsto F atTop (𝓝 0) := by
    convert! (((airy_scalar_tendsto_zero.comp tx).mul
      (airy_scalar_deriv_tendsto_zero.comp ty)).sub
      ((airy_scalar_deriv_tendsto_zero.comp tx).mul
        (airy_scalar_tendsto_zero.comp ty))).div_const (y-x) using 1 <;> simp [F]
  have he := integral_Ioi_of_hasDerivAt_of_tendsto
    ((hd 0).continuousAt.continuousWithinAt) (fun t _ => hd t)
    (integrable_airyAiReal_mul_Ioi x y) ht
  change (∫ t in Ioi 0, airyAiReal (x+t)*airyAiReal (y+t)) = _
  rw [he]
  dsimp [F]
  simp only [add_zero]
  field_simp [sub_ne_zero.mpr hne,sub_ne_zero.mpr hne.symm]
  ring

/-- The completed square can be evaluated by two scalar Airy values away from x=0. -/
theorem airy_completed_row_wronskian
    (s x : ℝ /- [definition] -/ )
    (hx : x ≠ 0 /- [standing] -/ )
    : airyAiReal (s+x)+airyKernelIntegral (x+s) s =
      airyAiReal (s+x)+
        (airyAiReal (s+x)*deriv airyAiReal s-deriv airyAiReal (s+x)*airyAiReal s)/x := by
  rw [airyKernelIntegral_wronskian (x+s) s (by intro he; apply hx; linarith)]
  simp only [add_comm x s,add_sub_cancel_left]

/-- All off-diagonal binders are jointly inhabited by genuine nonzero Airy data. -/
theorem airy_wronskian_joint_probe :
    ∃ s x : ℝ, s ≠ x ∧ x ≠ 0 ∧ airyAiReal s ≠ 0 ∧
      airyKernelIntegral x s =
        (airyAiReal x*deriv airyAiReal s-deriv airyAiReal x*airyAiReal s)/(x-s) ∧
      airyAiReal (s+x)+airyKernelIntegral (x+s) s =
        airyAiReal (s+x)+(airyAiReal (s+x)*deriv airyAiReal s-
          deriv airyAiReal (s+x)*airyAiReal s)/x := by
  refine ⟨0,1,by norm_num,by norm_num,airyAiReal_zero_pos.ne',?_,?_⟩
  · exact airyKernelIntegral_wronskian 1 0 (by norm_num)
  · exact airy_completed_row_wronskian 0 1 (by norm_num)



/-- A geometric ratio on the actual tail suffices for an explicit truncation error. -/
theorem ratio_tail_remainder
    {E : Type* /- [definition] -/ }
    [NormedAddCommGroup E /- [definition] -/ ]
    [NormedSpace ℝ E /- [definition] -/ ]
    (f : ℕ → E /- [definition] -/ )
    (a : E /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hq0 : 0 ≤ q /- [standing] -/ )
    (hq1 : q < 1 /- [standing] -/ )
    (hf : Summable f /- [standing] -/ )
    (ha : ∑' n, f n = a /- [standing] -/ )
    (hr : ∀ n, N ≤ n → ‖f (n+1)‖ ≤ q*‖f n‖ /- [standing] -/ )
    : ‖a-∑ n ∈ Finset.range N, f n‖ ≤ ‖f N‖/(1-q) := by
  have hm : ∀ k : ℕ, ‖f (k+N)‖ ≤ ‖f N‖*q^k := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      calc ‖f (k+1+N)‖ = ‖f (k+N+1)‖ := by congr 2; omega
           _ ≤ q*‖f (k+N)‖ := hr _ (by omega)
           _ ≤ q*(‖f N‖*q^k) := mul_le_mul_of_nonneg_left ih hq0
           _ = ‖f N‖*q^(k+1) := by rw [pow_succ]; ring
  have ht : ‖∑' k, f (k+N)‖ ≤ ‖f N‖/(1-q) := by
    have hg := (hasSum_geometric_of_lt_one hq0 hq1).mul_left ‖f N‖
    exact (tsum_of_norm_bounded hg hm).trans_eq (by ring)
  have he := hf.sum_add_tsum_nat_add N
  rw [ha] at he
  have he2 : a-∑ n ∈ Finset.range N, f n = ∑' k, f (k+N) := by
    rw [← he]
    abel
  rwa [he2]

/-- Genuine hypergeometric coefficient ratio for a positive real parameter. -/
theorem hg_actual_term_norm_ratio
    (b : ℝ /- [definition] -/ )
    (w : ℂ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    (hb : 0 < b /- [standing] -/ )
    : ‖complex_regularizedHGFunCoeff 0 {(b:ℂ)} (n+1)*w^(n+1)‖ =
      ‖complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*w^n‖*‖w‖ /
        ((b+n)*(n+1)) := by
  have hbn : (b:ℂ) ≠ -(n:ℂ) := by
    intro he
    have hh := congrArg Complex.re he
    simp only [Complex.ofReal_re,Complex.neg_re,Complex.natCast_re] at hh
    have hn : (0:ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  rw [complex_regularizedHGFunCoeff_add_one (a := 0) (b := {(b:ℂ)})
    (by intro z hz; have hz1 := Multiset.mem_singleton.mp hz; subst z; exact hbn)]
  simp only [Multiset.map_zero,Multiset.prod_zero,Multiset.map_singleton,Multiset.prod_singleton]
  rw [pow_succ,norm_mul,norm_mul,norm_div,norm_mul,norm_mul]
  have hnorm1 : ‖(b:ℂ)+(n:ℂ)‖ = b+n := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_add,Complex.norm_real,Real.norm_eq_abs,
      abs_of_pos (by positivity)]
  have hnorm2 : ‖(n:ℂ)+1‖ = n+1 := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_one, ← Complex.ofReal_add,
      Complex.norm_real,Real.norm_eq_abs,abs_of_pos (by positivity)]
  rw [hnorm1,hnorm2]
  simp only [norm_one,norm_mul]
  ring

/-- Certified actual hypergeometric tail bound, with a directly checkable ratio budget. -/
theorem hg_actual_remainder
    (b : ℝ /- [definition] -/ )
    (w : ℂ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hb : 0 < b /- [standing] -/ )
    (hq0 : 0 ≤ q /- [standing] -/ )
    (hq1 : q < 1 /- [standing] -/ )
    (hw : ‖w‖ ≤ q*((b+N)*(N+1))  /- [standing] -/ )
    : ‖complex_regularizedHGFun 0 {(b:ℂ)} w-
        ∑ n ∈ Finset.range N, complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*w^n‖ ≤
      ‖complex_regularizedHGFunCoeff 0 {(b:ℂ)} N*w^N‖/(1-q) := by
  have hs : Summable (fun n => complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*w^n) := by
    have hs := (complex_regularizedHGFunSeries 0 {(b:ℂ)}).summable
      (x := w) (by rw [complex_radius_regularizedHGFunSeries_zero_eq_top]; simp)
    convert! hs using 1
    ext n
    simp [complex_regularizedHGFunSeries,smul_eq_mul,mul_comm]
  apply ratio_tail_remainder _ _ N q hq0 hq1 hs
    (complex_regularizedHGFun_zero_singleton_eq_tsum (b:ℂ) w).symm
  intro n hn
  rw [hg_actual_term_norm_ratio b w n hb]
  have hd : 0 < (b+(n:ℝ))*((n:ℝ)+1) := by positivity
  apply (div_le_iff₀ hd).mpr
  have hden : (b+(N:ℝ))*((N:ℝ)+1) ≤ (b+(n:ℝ))*((n:ℝ)+1) := by
    have hnn : (N:ℝ) ≤ n := by exact_mod_cast hn
    gcongr
  have hww : ‖w‖ ≤ q*((b+(n:ℝ))*((n:ℝ)+1)) :=
    hw.trans (mul_le_mul_of_nonneg_left hden hq0)
  calc ‖complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*w^n‖*‖w‖ ≤
        ‖complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*w^n‖*(q*((b+n)*(n+1))) :=
          mul_le_mul_of_nonneg_left hww (norm_nonneg _)
       _ = q*‖complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*w^n‖*((b+n)*(n+1)) := by ring

/-- All remainder binders have a positive-parameter, nonzero-input joint instance. -/
theorem hg_remainder_all_binder_joint_probe :
    ∃ b : ℝ, ∃ w : ℂ, ∃ N : ℕ, ∃ q : ℝ,
      0 < b ∧ w ≠ 0 ∧ 0 < q ∧ q < 1 ∧ ‖w‖ ≤ q*((b+N)*(N+1)) ∧
      ‖complex_regularizedHGFun 0 {(b:ℂ)} w-
        ∑ n ∈ Finset.range N, complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*w^n‖ ≤
      ‖complex_regularizedHGFunCoeff 0 {(b:ℂ)} N*w^N‖/(1-q) := by
  refine ⟨2/3,1,4,1/2,by norm_num,one_ne_zero,by norm_num,by norm_num,?_,?_⟩
  · norm_num
  · exact hg_actual_remainder (2/3) 1 4 (1/2) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num)


/-- Exponential Taylor remainder from its genuine absolutely convergent series. -/
theorem real_exp_ratio_remainder
    (x : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hq0 : 0 ≤ q /- [standing] -/ )
    (hq1 : q < 1 /- [standing] -/ )
    (hx : |x| ≤ q*(N+1)  /- [standing] -/ )
    : |Real.exp x-∑ n ∈ Finset.range N,x^n/(n.factorial:ℝ)| ≤
      |x|^N/(N.factorial:ℝ)/(1-q) := by
  have hs : HasSum (fun n : ℕ => x^n/(n.factorial:ℝ)) (Real.exp x) := by
    simpa only [Real.exp_eq_exp_ℝ] using hasSum_pow_div_factorial x
  have hr : ∀ n : ℕ, N ≤ n → ‖x^(n+1)/((n+1).factorial:ℝ)‖ ≤
      q*‖x^n/(n.factorial:ℝ)‖ := by
    intro n hn
    have hnp : (0:ℝ)<n+1 := by positivity
    have hnN : (N:ℝ)≤n := by exact_mod_cast hn
    have hxn : |x|≤q*(n+1) := hx.trans (by gcongr)
    have hfact : (0:ℝ)<n.factorial := by exact_mod_cast Nat.factorial_pos n
    simp only [norm_div,Real.norm_eq_abs,Nat.factorial_succ,Nat.cast_mul,
      Nat.cast_add,Nat.cast_one,pow_succ,abs_mul,abs_pow,abs_of_pos hnp,abs_of_pos hfact]
    apply (div_le_iff₀ (mul_pos hnp hfact)).mpr
    have hpow : 0≤|x|^n := pow_nonneg (abs_nonneg _) n
    calc |x|^n*|x| ≤ |x|^n*(q*(n+1)) := mul_le_mul_of_nonneg_left hxn hpow
         _ = q*(|x|^n/(n.factorial:ℝ))*((n+1)*(n.factorial:ℝ)) := by field_simp
  have h := ratio_tail_remainder (fun n => x^n/(n.factorial:ℝ)) (Real.exp x) N q hq0 hq1
    hs.summable hs.tsum_eq hr
  simpa only [Real.norm_eq_abs,abs_div,abs_pow,abs_of_nonneg (Nat.cast_nonneg (α := ℝ) N.factorial)] using h

/-- Uniform exact-rational Taylor error on the normalization integration interval. -/
theorem exp_neg_cube_uniform_remainder
    (x : ℝ /- [definition] -/ )
    (hx0 : 0 ≤ x /- [standing] -/ )
    (hx2 : x ≤ 2 /- [standing] -/ )
    : |Real.exp (-x^3)-∑ n ∈ Finset.range 32,(-x^3)^n/(n.factorial:ℝ)| ≤ 1/1000000 := by
  have hb : |-x^3|≤8 := by
    rw [abs_neg,abs_of_nonneg (pow_nonneg hx0 3)]
    calc x^3≤(2:ℝ)^3 := pow_le_pow_left₀ hx0 hx2 3
         _ = 8 := by norm_num
  have h := real_exp_ratio_remainder (-x^3) 32 (1/2) (by norm_num) (by norm_num) (by nlinarith)
  apply h.trans
  calc |-x^3|^32/((32:ℕ).factorial:ℝ)/(1-1/2) ≤ (8:ℝ)^32/((32:ℕ).factorial:ℝ)/(1-1/2) := by gcongr
       _ ≤ 1/1000000 := by norm_num

/-- Nonzero normalization point instantiates the full exponential truncation budget. -/
theorem exp_normalization_joint_probe :
    ∃ x : ℝ, 0<x ∧ x≤2 ∧
      |Real.exp (-x^3)-∑ n ∈ Finset.range 32,(-x^3)^n/(n.factorial:ℝ)|≤1/1000000 :=
  ⟨1,by norm_num,by norm_num,exp_neg_cube_uniform_remainder 1 (by norm_num) (by norm_num)⟩


/-- Fixed exact-rational Taylor polynomial for the nonsingular gamma integrals. -/
noncomputable def cubeExpPartial
    (x : ℝ /- [definition] -/ )
    : ℝ := ∑ n ∈ Finset.range 32,(-x^3)^n/(n.factorial:ℝ)

theorem cubeExpPartial_continuous : Continuous cubeExpPartial := by
  unfold cubeExpPartial
  fun_prop

/-- Exact integral of every Taylor monomial, with its cubic degree intact. -/
theorem cube_exp_monomial_integral
    (n : ℕ /- [definition] -/ )
    : (∫ x in (0:ℝ)..2, (-x^3)^n/(n.factorial:ℝ)) =
      (-1:ℝ)^n*(2:ℝ)^(3*n+1)/((n.factorial:ℝ)*(3*n+1)) := by
  have he : (fun x : ℝ => (-x^3)^n/(n.factorial:ℝ)) =
      fun x => ((-1:ℝ)^n/(n.factorial:ℝ))*x^(3*n) := by
    funext x
    rw [← neg_one_mul (x^3),mul_pow,← pow_mul]
    ring
  rw [he,intervalIntegral.integral_const_mul,integral_pow]
  simp only [Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,Nat.cast_one,zero_pow (by omega : 3*n+1≠0),sub_zero]
  have hf : (n.factorial:ℝ)≠0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hh : 3*(n:ℝ)+1≠0 := by positivity
  field_simp [hf,hh] <;> ring

/-- Exact integral of the x-weighted normalization polynomial. -/
theorem cube_exp_weighted_monomial_integral
    (n : ℕ /- [definition] -/ )
    : (∫ x in (0:ℝ)..2, x*((-x^3)^n/(n.factorial:ℝ))) =
      (-1:ℝ)^n*(2:ℝ)^(3*n+2)/((n.factorial:ℝ)*(3*n+2)) := by
  have he : (fun x : ℝ => x*((-x^3)^n/(n.factorial:ℝ))) =
      fun x => ((-1:ℝ)^n/(n.factorial:ℝ))*x^(3*n+1) := by
    funext x
    rw [← neg_one_mul (x^3),mul_pow,← pow_mul,pow_succ]
    ring
  rw [he,intervalIntegral.integral_const_mul,integral_pow]
  simp only [Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,Nat.cast_one,
    zero_pow (by omega : 3*n+1+1≠0),sub_zero]
  have hp : (3*n+1)+1=3*n+2 := by omega
  rw [hp]
  have hf : (n.factorial:ℝ)≠0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hh : 3*(n:ℝ)+2≠0 := by positivity
  field_simp [hf,hh] <;> ring

/-- Kernel-checked rational integral range; no floating arithmetic is used. -/
theorem cube_exp_partial_integral_bounds :
    (267886/100000:ℝ) ≤ 3*(∫ x in (0:ℝ)..2, cubeExpPartial x) ∧
      3*(∫ x in (0:ℝ)..2, cubeExpPartial x) ≤ 267887/100000 := by
  have he : (∫ x in (0:ℝ)..2,cubeExpPartial x) =
      ∑ n ∈ Finset.range 32,(-1:ℝ)^n*(2:ℝ)^(3*n+1)/((n.factorial:ℝ)*(3*n+1)) := by
    unfold cubeExpPartial
    rw [intervalIntegral.integral_finsetSum (fun n _ => by apply Continuous.intervalIntegrable; fun_prop)]
    exact Finset.sum_congr rfl (fun n _ => cube_exp_monomial_integral n)
  rw [he]
  norm_num [Finset.sum_range_succ]

/-- Kernel-checked rational range for the second normalization polynomial. -/
theorem cube_exp_partial_weighted_integral_bounds :
    (135395/100000:ℝ) ≤ 3*(∫ x in (0:ℝ)..2, x*cubeExpPartial x) ∧
      3*(∫ x in (0:ℝ)..2, x*cubeExpPartial x) ≤ 135396/100000 := by
  have he : (∫ x in (0:ℝ)..2,x*cubeExpPartial x) =
      ∑ n ∈ Finset.range 32,(-1:ℝ)^n*(2:ℝ)^(3*n+2)/((n.factorial:ℝ)*(3*n+2)) := by
    simp only [cubeExpPartial,Finset.mul_sum]
    rw [intervalIntegral.integral_finsetSum (fun n _ => by apply Continuous.intervalIntegrable; fun_prop)]
    exact Finset.sum_congr rfl (fun n _ => cube_exp_weighted_monomial_integral n)
  rw [he]
  norm_num [Finset.sum_range_succ]

/-- Both exact polynomial integrals are strictly positive nondegenerate data. -/
theorem normalization_polynomial_joint_probe :
    cubeExpPartial 0 = 1 ∧ 0 < ∫ x in (0:ℝ)..2,cubeExpPartial x ∧
      0 < ∫ x in (0:ℝ)..2,x*cubeExpPartial x := by
  refine ⟨?_,?_,?_⟩
  · norm_num [cubeExpPartial,Finset.sum_range_succ]
  · linarith [cube_exp_partial_integral_bounds.1]
  · linarith [cube_exp_partial_weighted_integral_bounds.1]

/-- The genuine compact gamma integral is within a kernel-checked rational
error of the exact Taylor polynomial integral. -/
theorem cube_exp_compact_integral_error :
    |(∫ x in (0:ℝ)..2,Real.exp (-x^3))-(∫ x in (0:ℝ)..2,cubeExpPartial x)| ≤ 2/1000000 := by
  rw [← intervalIntegral.integral_sub
    (by apply Continuous.intervalIntegrable; fun_prop) (cubeExpPartial_continuous.intervalIntegrable _ _)]
  have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0:ℝ)) (b := 2)
    (C := (1/1000000:ℝ)) (f := fun x => Real.exp (-x^3)-cubeExpPartial x) (fun x hx => by
      rw [uIoc_of_le (by norm_num : (0:ℝ)≤2)] at hx
      have hx2 : x≤2 := hx.2
      have hx0 : 0≤x := hx.1.le
      simpa only [Real.norm_eq_abs,cubeExpPartial] using exp_neg_cube_uniform_remainder x hx0 hx2)
  norm_num only [abs_of_pos (by norm_num : (0:ℝ)<2),sub_zero,Real.norm_eq_abs] at h
  linarith

/-- Error in the x-weighted compact integral is controlled by x<=2. -/
theorem cube_exp_compact_weighted_integral_error :
    |(∫ x in (0:ℝ)..2,x*Real.exp (-x^3))-(∫ x in (0:ℝ)..2,x*cubeExpPartial x)| ≤ 4/1000000 := by
  rw [← intervalIntegral.integral_sub
    (by apply Continuous.intervalIntegrable; fun_prop)
    (by apply Continuous.intervalIntegrable; exact continuous_id.mul cubeExpPartial_continuous)]
  have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0:ℝ)) (b := 2)
    (C := (2/1000000:ℝ)) (f := fun x => x*Real.exp (-x^3)-x*cubeExpPartial x) (fun x hx => by
      rw [uIoc_of_le (by norm_num : (0:ℝ)≤2)] at hx
      have hx2 : x≤2 := hx.2
      have hx0 : 0≤x := hx.1.le
      rw [← mul_sub,Real.norm_eq_abs,abs_mul,abs_of_nonneg hx0]
      have hb : |Real.exp (-x^3)-cubeExpPartial x|≤1/1000000 :=
        exp_neg_cube_uniform_remainder x hx0 hx2
      calc x*|Real.exp (-x^3)-cubeExpPartial x|≤2*(1/1000000) := by gcongr
           _ = 2/1000000 := by ring)
  norm_num only [abs_of_pos (by norm_num : (0:ℝ)<2),sub_zero,Real.norm_eq_abs] at h
  linarith

/-- Actual finite normalization integrals now have rational bounds, rather
than floating approximations supplied as hypotheses. -/
theorem actual_compact_gamma_integral_bounds :
    (26788/10000:ℝ)≤3*(∫ x in (0:ℝ)..2,Real.exp (-x^3)) ∧
      3*(∫ x in (0:ℝ)..2,Real.exp (-x^3))≤26789/10000 ∧
      (13539/10000:ℝ)≤3*(∫ x in (0:ℝ)..2,x*Real.exp (-x^3)) ∧
      3*(∫ x in (0:ℝ)..2,x*Real.exp (-x^3))≤13540/10000 := by
  have he := abs_le.mp cube_exp_compact_integral_error
  have hew := abs_le.mp cube_exp_compact_weighted_integral_error
  have hp := cube_exp_partial_integral_bounds
  have hpw := cube_exp_partial_weighted_integral_bounds
  constructor
  · linarith
  constructor
  · linarith
  constructor <;> linarith

/-- The same genuine positive exponential supplies all compact-integral theorems. -/
theorem actual_compact_gamma_joint_probe :
    Real.exp (-1)>0 ∧
      (26788/10000:ℝ)≤3*(∫ x in (0:ℝ)..2,Real.exp (-x^3)) ∧
      3*(∫ x in (0:ℝ)..2,Real.exp (-x^3))≤26789/10000 ∧
      (13539/10000:ℝ)≤3*(∫ x in (0:ℝ)..2,x*Real.exp (-x^3)) ∧
      3*(∫ x in (0:ℝ)..2,x*Real.exp (-x^3))≤13540/10000 :=
  ⟨Real.exp_pos _,actual_compact_gamma_integral_bounds⟩


/-- The Airy normalization gamma value as a nonsingular cube-exponential integral. -/
theorem gamma_one_third_cube_integral :
    Real.Gamma (1/3) = 3*(∫ x in Ioi (0:ℝ), Real.exp (-x^3)) := by
  rw [Real.Gamma_eq_integral (by norm_num : (0:ℝ)<1/3)]
  have he := integral_comp_rpow_Ioi_of_pos
    (g := fun y : ℝ => Real.exp (-y)*y^((1/3:ℝ)-1)) (by norm_num : (0:ℝ)<3)
  rw [← he,← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro x hx
  have hx0 : 0<x := hx
  simp only [smul_eq_mul]
  norm_num only at *
  rw [← Real.rpow_mul hx0.le]
  norm_num
  field_simp [hx0.ne'] <;> ring

/-- The other Airy normalization gamma value uses the same bounded nonsingular integral. -/
theorem gamma_two_thirds_cube_integral :
    Real.Gamma (2/3) = 3*(∫ x in Ioi (0:ℝ), x*Real.exp (-x^3)) := by
  rw [Real.Gamma_eq_integral (by norm_num : (0:ℝ)<2/3)]
  have he := integral_comp_rpow_Ioi_of_pos
    (g := fun y : ℝ => Real.exp (-y)*y^((2/3:ℝ)-1)) (by norm_num : (0:ℝ)<3)
  rw [← he,← integral_const_mul]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro x hx
  have hx0 : 0<x := hx
  simp only [smul_eq_mul]
  norm_num only at *
  rw [← Real.rpow_mul hx0.le]
  norm_num
  simp only [Real.rpow_neg_one]
  field_simp [hx0.ne'] <;> ring

/-- The nonsingular normalization integrand is genuinely integrable. -/
theorem cube_exp_integrable : IntegrableOn (fun x : ℝ => Real.exp (-x^3)) (Ioi 0) := by
  apply ((integrableOn_exp_neg_Ioi 0).const_mul (Real.exp 1)).mono'
    (by fun_prop)
  filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with x hx
  have hx0 : 0≤x := le_of_lt hx
  have hcube : x-1≤x^3 := by
    by_cases hx1 : x≤1
    · nlinarith [pow_nonneg hx0 3]
    · have hx1' : 1≤x := le_of_not_ge hx1
      nlinarith [sq_nonneg (x-1),mul_nonneg (sq_nonneg (x-1)) hx0]
  rw [Real.norm_eq_abs,abs_of_pos (Real.exp_pos _),← Real.exp_add]
  exact Real.exp_le_exp.mpr (by linarith)

/-- Nonzero normalization data inhabit both exact integral identities together. -/
theorem gamma_normalization_joint_probe :
    0 < Real.Gamma (1/3) ∧ 0 < Real.Gamma (2/3) ∧
      Real.Gamma (1/3) = 3*(∫ x in Ioi (0:ℝ), Real.exp (-x^3)) ∧
      Real.Gamma (2/3) = 3*(∫ x in Ioi (0:ℝ), x*Real.exp (-x^3)) :=
  ⟨Real.Gamma_pos_of_pos (by norm_num),Real.Gamma_pos_of_pos (by norm_num),
    gamma_one_third_cube_integral,gamma_two_thirds_cube_integral⟩

/-- FTC tail identity uses a positive derivative and its actual zero limit. -/
theorem cube_exp_square_tail
    (a : ℝ /- [definition] -/ )
    : IntegrableOn (fun x : ℝ => x^2*Real.exp (-x^3)) (Ioi a) ∧
      (∫ x in Ioi a,x^2*Real.exp (-x^3))=Real.exp (-a^3)/3 := by
  have hd : ∀ x ∈ Ici a,HasDerivAt (fun y : ℝ => -Real.exp (-y^3)/3)
      (x^2*Real.exp (-x^3)) x := by
    intro x _
    convert! (((Real.hasDerivAt_exp (-x^3)).comp x
      (((hasDerivAt_id x).pow 3).neg)).neg.div_const 3) using 1 <;> simp only [id_eq] <;> ring
  have hp : ∀ x ∈ Ioi a,0≤x^2*Real.exp (-x^3) := by intro x _; positivity
  have hz : Tendsto (fun x : ℝ => -Real.exp (-x^3)/3) atTop (𝓝 0) := by
    simpa using ((Real.tendsto_exp_neg_atTop_nhds_zero.comp
      (tendsto_pow_atTop (by norm_num : (3:ℕ)≠0))).neg.div_const 3)
  refine ⟨integrableOn_Ioi_deriv_of_nonneg' hd hp hz,?_⟩
  simpa only [sub_neg_eq_add,zero_add,neg_div,neg_neg,zero_sub] using integral_Ioi_of_hasDerivAt_of_nonneg' hd hp hz

/-- The weighted gamma integrand is dominated by two genuinely integrable functions. -/
theorem cube_exp_weighted_integrable :
    IntegrableOn (fun x : ℝ => x*Real.exp (-x^3)) (Ioi 0) := by
  apply (cube_exp_integrable.add (cube_exp_square_tail 0).1).mono' (by fun_prop)
  filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with x hx
  have hx0 : 0≤x := le_of_lt hx
  rw [Real.norm_eq_abs,abs_of_nonneg (by positivity : 0≤x*Real.exp (-x^3))]
  change x*Real.exp (-x^3)≤Real.exp (-x^3)+x^2*Real.exp (-x^3)
  have hb : x≤1+x^2 := by nlinarith [sq_nonneg (x-1/2)]
  nlinarith [mul_nonneg (sub_nonneg.mpr hb) (Real.exp_pos (-x^3)).le]

/-- A positive Taylor lower bound controls the exact exponential tail constant. -/
theorem exp_neg_eight_rational_bound : Real.exp (-8)≤(1/2500:ℝ) := by
  have h := Real.sum_le_exp_of_nonneg (by norm_num : (0:ℝ)≤8) 16
  have hl : (2500:ℝ)≤∑ n ∈ Finset.range 16,(8:ℝ)^n/(n.factorial:ℝ) := by
    norm_num [Finset.sum_range_succ]
  rw [Real.exp_neg]
  simpa only [one_div] using (inv_le_inv₀ (Real.exp_pos 8) (by norm_num : (0:ℝ)<2500)).mpr (hl.trans h)

/-- Both infinite tails are bounded by a positive derivative tail; omitted
square-certificate tails never require this estimate. -/
theorem cube_exp_normalization_tail_bounds :
    0≤(∫ x in Ioi (2:ℝ),Real.exp (-x^3)) ∧
      (∫ x in Ioi (2:ℝ),Real.exp (-x^3))≤1/30000 ∧
      0≤(∫ x in Ioi (2:ℝ),x*Real.exp (-x^3)) ∧
      (∫ x in Ioi (2:ℝ),x*Real.exp (-x^3))≤1/15000 := by
  have hf : IntegrableOn (fun x : ℝ => Real.exp (-x^3)) (Ioi 2) := cube_exp_integrable.mono_set (by intro x hx; exact lt_trans (by norm_num : (0:ℝ)<2) hx)
  have hfw : IntegrableOn (fun x : ℝ => x*Real.exp (-x^3)) (Ioi 2) := cube_exp_weighted_integrable.mono_set (by intro x hx; exact lt_trans (by norm_num : (0:ℝ)<2) hx)
  have hs := (cube_exp_square_tail 2).1
  have h1 : (∫ x in Ioi (2:ℝ),Real.exp (-x^3))≤
      (∫ x in Ioi (2:ℝ),(x^2*Real.exp (-x^3))/4) := by
    apply integral_mono_ae hf (hs.div_const 4)
    filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with x hx
    have hx2 : 2<x := hx
    have hsq : 4≤x^2 := by nlinarith
    nlinarith [mul_nonneg (sub_nonneg.mpr hsq) (Real.exp_pos (-x^3)).le]
  have h2 : (∫ x in Ioi (2:ℝ),x*Real.exp (-x^3))≤
      (∫ x in Ioi (2:ℝ),(x^2*Real.exp (-x^3))/2) := by
    apply integral_mono_ae hfw (hs.div_const 2)
    filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with x hx
    have hx2 : 2<x := hx
    have hsq : 2*x≤x^2 := by nlinarith
    nlinarith [mul_nonneg (sub_nonneg.mpr hsq) (Real.exp_pos (-x^3)).le]
  rw [integral_div,(cube_exp_square_tail 2).2] at h1 h2
  norm_num only at h1 h2
  have he := exp_neg_eight_rational_bound
  refine ⟨integral_nonneg_of_ae ?_,by linarith,integral_nonneg_of_ae ?_,by linarith⟩
  · filter_upwards [] with x; exact (Real.exp_pos _).le
  · filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with x hx
    have hx0 : 0≤x := le_of_lt (lt_trans (by norm_num : (0:ℝ)<2) hx)
    positivity

/-- Actual full gamma values have rational intervals including their infinite tails. -/
theorem actual_gamma_rational_bounds :
    (26788/10000:ℝ)≤Real.Gamma (1/3) ∧ Real.Gamma (1/3)≤26790/10000 ∧
      (13539/10000:ℝ)≤Real.Gamma (2/3) ∧ Real.Gamma (2/3)≤13542/10000 := by
  have he : Ioc (0:ℝ) 2 ∪ Ioi 2=Ioi 0 := by ext x; simp
  have hd : Disjoint (Ioc (0:ℝ) 2) (Ioi 2) := by
    apply Set.disjoint_left.mpr
    intro x hx hy
    exact (not_lt_of_ge hx.2) hy
  have split1 : (∫ x in Ioi (0:ℝ),Real.exp (-x^3))=
      (∫ x in (0:ℝ)..2,Real.exp (-x^3))+(∫ x in Ioi (2:ℝ),Real.exp (-x^3)) := by
    rw [← he,setIntegral_union hd measurableSet_Ioi
      (cube_exp_integrable.mono_set (by intro x hx; exact hx.1))
      (cube_exp_integrable.mono_set (by intro x hx; exact lt_trans (by norm_num : (0:ℝ)<2) hx))]
    rw [intervalIntegral.integral_of_le (by norm_num : (0:ℝ)≤2)]
  have split2 : (∫ x in Ioi (0:ℝ),x*Real.exp (-x^3))=
      (∫ x in (0:ℝ)..2,x*Real.exp (-x^3))+(∫ x in Ioi (2:ℝ),x*Real.exp (-x^3)) := by
    rw [← he,setIntegral_union hd measurableSet_Ioi
      (cube_exp_weighted_integrable.mono_set (by intro x hx; exact hx.1))
      (cube_exp_weighted_integrable.mono_set (by intro x hx; exact lt_trans (by norm_num : (0:ℝ)<2) hx))]
    rw [intervalIntegral.integral_of_le (by norm_num : (0:ℝ)≤2)]
  rw [gamma_one_third_cube_integral,gamma_two_thirds_cube_integral,split1,split2]
  have hc := actual_compact_gamma_integral_bounds
  have ht := cube_exp_normalization_tail_bounds
  constructor
  · linarith [hc.1,ht.1]
  constructor
  · linarith [hc.2.1,ht.2.1]
  constructor <;> linarith [hc.2.2.1,hc.2.2.2,ht.2.2.1,ht.2.2.2]

/-- One actual nonzero gamma instance satisfies both complete rational enclosures. -/
theorem actual_gamma_bounds_joint_probe :
    0<Real.Gamma (1/3) ∧ 0<Real.Gamma (2/3) ∧
      (26788/10000:ℝ)≤Real.Gamma (1/3) ∧ Real.Gamma (1/3)≤26790/10000 ∧
      (13539/10000:ℝ)≤Real.Gamma (2/3) ∧ Real.Gamma (2/3)≤13542/10000 :=
  ⟨Real.Gamma_pos_of_pos (by norm_num),Real.Gamma_pos_of_pos (by norm_num),actual_gamma_rational_bounds⟩

/-- Kernel-checked cubic comparisons give the actual irrational powers
needed by the gamma normalizations. -/
theorem airy_normalization_power_bounds :
    (480749/1000000:ℝ)≤(3:ℝ)^(-2/3:ℝ) ∧ (3:ℝ)^(-2/3:ℝ)≤480750/1000000 ∧
      (693361/1000000:ℝ)≤(3:ℝ)^(-1/3:ℝ) ∧ (3:ℝ)^(-1/3:ℝ)≤693362/1000000 := by
  have hp : (0:ℝ)<(3:ℝ)^(-2/3:ℝ) := Real.rpow_pos_of_pos (by norm_num) _
  have hq : (0:ℝ)<(3:ℝ)^(-1/3:ℝ) := Real.rpow_pos_of_pos (by norm_num) _
  have hc : ((3:ℝ)^(-2/3:ℝ))^3=(1/9:ℝ) := by
    rw [← Real.rpow_natCast _ 3,← Real.rpow_mul (by norm_num : (0:ℝ)≤3)]
    norm_num [Real.rpow_neg,Real.rpow_natCast]
  have hd : ((3:ℝ)^(-1/3:ℝ))^3=(1/3:ℝ) := by
    rw [← Real.rpow_natCast _ 3,← Real.rpow_mul (by norm_num : (0:ℝ)≤3)]
    norm_num [Real.rpow_neg,Real.rpow_natCast]
  refine ⟨?_,?_,?_,?_⟩
  · by_contra hn
    have hh : ((3:ℝ)^(-2/3:ℝ))^3≤(480749/1000000:ℝ)^3 := by gcongr; exact (not_le.mp hn).le
    rw [hc] at hh
    norm_num at hh
  · by_contra hn
    have hh : (480750/1000000:ℝ)^3≤((3:ℝ)^(-2/3:ℝ))^3 := by gcongr; exact (not_le.mp hn).le
    rw [hc] at hh
    norm_num at hh
  · by_contra hn
    have hh : ((3:ℝ)^(-1/3:ℝ))^3≤(693361/1000000:ℝ)^3 := by gcongr; exact (not_le.mp hn).le
    rw [hd] at hh
    norm_num at hh
  · by_contra hn
    have hh : (693362/1000000:ℝ)^3≤((3:ℝ)^(-1/3:ℝ))^3 := by gcongr; exact (not_le.mp hn).le
    rw [hd] at hh
    norm_num at hh

/-- Both initial-value intervals use the SAME genuine Airy function and
include the exact infinite gamma tails. -/
theorem airy_actual_initial_rational_bounds :
    (355/1000:ℝ)≤airyAiReal 0 ∧ airyAiReal 0≤356/1000 ∧
      (-259/1000:ℝ)≤deriv airyAiReal 0 ∧ deriv airyAiReal 0≤-258/1000 := by
  have hg := actual_gamma_rational_bounds
  have hp := airy_normalization_power_bounds
  have hgp : 0<Real.Gamma (1/3) := Real.Gamma_pos_of_pos (by norm_num)
  have hgq : 0<Real.Gamma (2/3) := Real.Gamma_pos_of_pos (by norm_num)
  have hs : deriv airyAiReal 0=-((3:ℝ)^(-1/3:ℝ)/Real.Gamma (1/3)) := by
    have h43 : (3:ℝ)^(-4/3:ℝ)*3=(3:ℝ)^(-1/3:ℝ) := by
      rw [show (3:ℝ)^(-4/3:ℝ)*3=(3:ℝ)^(-4/3:ℝ)*(3:ℝ)^(1:ℝ) by rw [Real.rpow_one],
        ← Real.rpow_add (by norm_num : (0:ℝ)<3)]
      congr 1
      norm_num
    rw [deriv_airyAiReal_zero,real_Gamma_four_thirds,div_div_eq_mul_div,h43]
  rw [airyAiReal_zero,hs]
  refine ⟨(le_div_iff₀ hgq).mpr ?_,(div_le_iff₀ hgq).mpr ?_,?_,?_⟩
  · nlinarith [hg.2.2.2,hp.1]
  · nlinarith [hg.2.2.1,hp.2.1]
  · have hh : (3:ℝ)^(-1/3:ℝ)/Real.Gamma (1/3)≤259/1000 :=
      (div_le_iff₀ hgp).mpr (by nlinarith [hg.1,hp.2.2.2])
    linarith
  · have hh : (258/1000:ℝ)≤(3:ℝ)^(-1/3:ℝ)/Real.Gamma (1/3) :=
      (le_div_iff₀ hgp).mpr (by nlinarith [hg.2.1,hp.2.2.1])
    linarith

/-- The interval premises used by rational scalar evaluation are jointly
inhabited by the actual nonzero initial data. -/
theorem airy_initial_bounds_joint_probe :
    airyAiReal 0≠0 ∧ deriv airyAiReal 0≠0 ∧
      (355/1000:ℝ)≤airyAiReal 0 ∧ airyAiReal 0≤356/1000 ∧
      (-259/1000:ℝ)≤deriv airyAiReal 0 ∧ deriv airyAiReal 0≤-258/1000 :=
  ⟨airyAiReal_zero_pos.ne',deriv_airyAiReal_zero_neg.ne,airy_actual_initial_rational_bounds⟩
/-- Finite approximation using the ACTUAL hypergeometric coefficients. -/
noncomputable def complexAiryPartial
    (z : ℂ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    : ℂ := (3:ℂ)^(-2/3:ℂ)*
        (∑ n ∈ Finset.range N, complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} n*(z^3/9)^n)-
      (3:ℂ)^(-4/3:ℂ)*z*
        (∑ n ∈ Finset.range N, complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} n*(z^3/9)^n)

/-- Explicit geometric remainder for the actual Airy function at EVERY complex point. -/
theorem complex_airy_actual_remainder
    (z : ℂ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hq0 : 0 ≤ q /- [standing] -/ )
    (hq1 : q < 1 /- [standing] -/ )
    (hz : ‖z^3/9‖ ≤ q*((2/3+(N:ℝ))*(N+1))  /- [standing] -/ )
    : ‖complex_airyAi z-complexAiryPartial z N‖ ≤
      (‖(3:ℂ)^(-2/3:ℂ)‖*‖complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} N*(z^3/9)^N‖+
        ‖(3:ℂ)^(-4/3:ℂ)‖*‖z‖*‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} N*(z^3/9)^N‖)/(1-q) := by
  have hz2 : ‖z^3/9‖ ≤ q*((4/3+(N:ℝ))*(N+1)) := by
    apply hz.trans
    gcongr
    norm_num
  have h0 := hg_actual_remainder (2/3) (z^3/9) N q (by norm_num) hq0 hq1 hz
  have h1 := hg_actual_remainder (4/3) (z^3/9) N q (by norm_num) hq0 hq1 hz2
  norm_num only [Complex.ofReal_div,Complex.ofReal_ofNat] at h0 h1
  simp only [norm_mul] at h0 h1
  have he : complex_airyAi z-complexAiryPartial z N =
      (3:ℂ)^(-2/3:ℂ)*(complex_regularizedHGFun 0 {(2/3:ℂ)} (z^3/9)-
        ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} n*(z^3/9)^n)-
      (3:ℂ)^(-4/3:ℂ)*z*(complex_regularizedHGFun 0 {(4/3:ℂ)} (z^3/9)-
        ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} n*(z^3/9)^n) := by
    unfold complex_airyAi complexAiryPartial
    ring
  rw [he]
  calc _ ≤ ‖(3:ℂ)^(-2/3:ℂ)*(complex_regularizedHGFun 0 {(2/3:ℂ)} (z^3/9)-
          ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} n*(z^3/9)^n)‖+
        ‖(3:ℂ)^(-4/3:ℂ)*z*(complex_regularizedHGFun 0 {(4/3:ℂ)} (z^3/9)-
          ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} n*(z^3/9)^n)‖ := norm_sub_le _ _
       _ ≤ ‖(3:ℂ)^(-2/3:ℂ)‖*
            (‖complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} N*(z^3/9)^N‖/(1-q))+
          ‖(3:ℂ)^(-4/3:ℂ)‖*‖z‖*
            (‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} N*(z^3/9)^N‖/(1-q)) := by
         simp only [norm_mul]
         gcongr
       _ = _ := by ring

/-- Real scalar remainder of the actual Airy function; real-part truncation has
no larger error than the complex series. -/
theorem airy_actual_scalar_remainder
    (x : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hq0 : 0 ≤ q /- [standing] -/ )
    (hq1 : q < 1 /- [standing] -/ )
    (hx : |x^3/9| ≤ q*((2/3+(N:ℝ))*(N+1))  /- [standing] -/ )
    : |airyAiReal x-(complexAiryPartial (x:ℂ) N).re| ≤
      (‖(3:ℂ)^(-2/3:ℂ)‖*‖complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} N*((x:ℂ)^3/9)^N‖+
        ‖(3:ℂ)^(-4/3:ℂ)‖*|x| * ‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} N*((x:ℂ)^3/9)^N‖)/(1-q) := by
  have hx2 : ‖(x:ℂ)^3/9‖ ≤ q*((2/3+(N:ℝ))*(N+1)) := by
    convert! hx using 1
    rw [← Complex.ofReal_pow, ← Complex.ofReal_ofNat, ← Complex.ofReal_div,
      Complex.norm_real,Real.norm_eq_abs]
  have hh := complex_airy_actual_remainder (x:ℂ) N q hq0 hq1 hx2
  simp only [Complex.norm_real,Real.norm_eq_abs] at hh
  have hl : |airyAiReal x-(complexAiryPartial (x:ℂ) N).re| ≤
      ‖complex_airyAi (x:ℂ)-complexAiryPartial (x:ℂ) N‖ := by
    simpa only [Complex.sub_re,airyAiReal] using
      Complex.abs_re_le_norm (complex_airyAi (x:ℂ)-complexAiryPartial (x:ℂ) N)
  exact hl.trans hh

/-- Nonzero negative shift jointly inhabits all scalar-remainder binders with
an explicit rational ratio budget. -/
theorem airy_scalar_remainder_all_binder_joint_probe :
    ∃ x : ℝ, ∃ N : ℕ, ∃ q : ℝ, x < 0 ∧ 0 < q ∧ q < 1 ∧
      |x^3/9| ≤ q*((2/3+(N:ℝ))*(N+1)) ∧
      |airyAiReal x-(complexAiryPartial (x:ℂ) N).re| ≤
      (‖(3:ℂ)^(-2/3:ℂ)‖*‖complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} N*((x:ℂ)^3/9)^N‖+
        ‖(3:ℂ)^(-4/3:ℂ)‖*|x| * ‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} N*((x:ℂ)^3/9)^N‖)/(1-q) := by
  refine ⟨-3,8,1/2,by norm_num,by norm_num,by norm_num,by norm_num,?_⟩
  exact airy_actual_scalar_remainder (-3) 8 (1/2) (by norm_num) (by norm_num) (by norm_num)

/-- Rational recurrence after removing the actual gamma normalization factor. -/
noncomputable def normalizedHGCoeff
    (b : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    : ℝ := match n with
      | 0 => 1
      | k+1 => normalizedHGCoeff b k/((b+k)*(k+1))

/-- Actual coefficients factor into their actual initial value and rational recurrence. -/
theorem actual_hg_coeff_normalized
    (b : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    (hb : 0 < b /- [standing] -/ )
    : complex_regularizedHGFunCoeff 0 {(b:ℂ)} n =
      complex_regularizedHGFunCoeff 0 {(b:ℂ)} 0*(normalizedHGCoeff b n:ℂ) := by
  induction n with
  | zero => simp [normalizedHGCoeff]
  | succ n ih =>
    have hbn : (b:ℂ) ≠ -(n:ℂ) := by
      intro he
      have hh := congrArg Complex.re he
      simp only [Complex.ofReal_re,Complex.neg_re,Complex.natCast_re] at hh
      linarith [Nat.cast_nonneg (α := ℝ) n]
    rw [complex_regularizedHGFunCoeff_add_one (a := 0) (b := {(b:ℂ)})
      (by intro z hz; have hz1 := Multiset.mem_singleton.mp hz; subst z; exact hbn)]
    simp only [Multiset.map_zero,Multiset.prod_zero,Multiset.map_singleton,Multiset.prod_singleton]
    rw [ih]
    simp only [normalizedHGCoeff,Complex.ofReal_div,Complex.ofReal_mul,Complex.ofReal_add,
      Complex.ofReal_natCast,Complex.ofReal_one]
    ring

/-- For positive real parameters all normalized coefficients are positive. -/
theorem normalized_hg_coeff_positive
    (b : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    (hb : 0 < b /- [standing] -/ )
    : 0 < normalizedHGCoeff b n := by
  induction n with
  | zero => norm_num [normalizedHGCoeff]
  | succ n ih => simp only [normalizedHGCoeff]; positivity

/-- Exact-rational coefficient budget covering the full scalar evaluation range |x|<=6. -/
theorem normalized_airy_tail_rational_budget :
    (0:ℝ)<normalizedHGCoeff (2/3) 32 ∧
      (0:ℝ)<normalizedHGCoeff (4/3) 32 ∧
      2*normalizedHGCoeff (2/3) 32*(24:ℝ)^32≤1/10^20 ∧
      12*normalizedHGCoeff (4/3) 32*(24:ℝ)^32≤1/10^20 := by
  norm_num [normalizedHGCoeff]

/-- All normalization binders are inhabited jointly, with nonzero exact coefficients. -/
theorem normalized_hg_coeff_joint_probe :
    ∃ b : ℝ, 0 < b ∧
      (∀ n : ℕ, complex_regularizedHGFunCoeff 0 {(b:ℂ)} n =
        complex_regularizedHGFunCoeff 0 {(b:ℂ)} 0*(normalizedHGCoeff b n:ℂ)) ∧
      (∀ n : ℕ, 0 < normalizedHGCoeff b n) :=
  ⟨2/3,by norm_num,fun n => actual_hg_coeff_normalized (2/3) n (by norm_num),
    fun n => normalized_hg_coeff_positive (2/3) n (by norm_num)⟩


/-- Normalize the actual finite hypergeometric sum without changing its coefficients. -/
theorem actual_hg_partial_normalized
    (b x : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (hb : 0 < b /- [standing] -/ )
    : (∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(b:ℂ)} n*(x:ℂ)^n) =
      complex_regularizedHGFunCoeff 0 {(b:ℂ)} 0*
        ((∑ n ∈ Finset.range N,normalizedHGCoeff b n*x^n:ℝ):ℂ) := by
  rw [Complex.ofReal_sum,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n _
  rw [actual_hg_coeff_normalized b n hb]
  push_cast
  ring

/-- The actual Airy Taylor polynomial has only its two genuine initial values
as nonrational coefficients. -/
theorem airy_partial_normalized
    (x : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    : (complexAiryPartial (x:ℂ) N).re =
      airyAiReal 0*(∑ n ∈ Finset.range N,normalizedHGCoeff (2/3) n*(x^3/9)^n)+
      deriv airyAiReal 0*x*(∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n) := by
  have h0 : (3:ℂ)^(-2/3:ℂ)*complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} 0 =
      (airyAiReal 0:ℂ) := by
    rw [airyAiReal_ofReal,Complex.ofReal_zero,complex_airyAi_zero]
    simp [complex_regularizedHGFunCoeff,div_eq_mul_inv]
  have h1 : (3:ℂ)^(-4/3:ℂ)*complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} 0 =
      -((deriv airyAiReal (0:ℝ):ℝ):ℂ) := by
    simp only [complex_regularizedHGFunCoeff,Multiset.map_zero,Multiset.prod_zero,
      Multiset.map_singleton,Multiset.prod_singleton,Nat.factorial_zero,Nat.cast_one,
      Nat.cast_zero,add_zero,one_mul]
    rw [deriv_airyAiReal_zero]
    rw [show (-4/3:ℂ)=((-4/3:ℝ):ℂ) by norm_num,complex_three_cpow_ofReal,
      show (4/3:ℂ)=((4/3:ℝ):ℂ) by norm_num,Complex.Gamma_ofReal]
    push_cast
    ring
  have he : complexAiryPartial (x:ℂ) N =
      ((airyAiReal 0*(∑ n ∈ Finset.range N,normalizedHGCoeff (2/3) n*(x^3/9)^n)+
      deriv airyAiReal 0*x*(∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n):ℝ):ℂ) := by
    unfold complexAiryPartial
    have ha := actual_hg_partial_normalized (2/3) (x^3/9) N (by norm_num)
    have hb := actual_hg_partial_normalized (4/3) (x^3/9) N (by norm_num)
    norm_num only [Complex.ofReal_div,Complex.ofReal_pow,Complex.ofReal_ofNat] at ha hb
    rw [ha,hb]
    simp only [Complex.ofReal_add,Complex.ofReal_mul]
    linear_combination h0*
      ((∑ n ∈ Finset.range N,normalizedHGCoeff (2/3) n*(x^3/9)^n:ℝ):ℂ)-
      h1*(x:ℂ)*((∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n:ℝ):ℂ)
  rw [he,Complex.ofReal_re]

/-- All normalized finite-sum binders have the SAME actual Airy initial data. -/
theorem airy_normalized_polynomial_joint_probe :
    airyAiReal 0 ≠ 0 ∧ deriv airyAiReal 0 ≠ 0 ∧
      (complexAiryPartial (-3:ℂ) 8).re =
        airyAiReal 0*(∑ n ∈ Finset.range 8,normalizedHGCoeff (2/3) n*(-3:ℝ)^n)+
        deriv airyAiReal 0*(-3)*(∑ n ∈ Finset.range 8,normalizedHGCoeff (4/3) n*(-3:ℝ)^n) := by
  refine ⟨airyAiReal_zero_pos.ne',deriv_airyAiReal_zero_neg.ne,?_⟩
  have hh := airy_partial_normalized (-3) 8
  norm_num only [show (-3:ℝ)^3/9=(-3:ℝ) by norm_num] at hh
  simpa using hh

/-- The two complex normalization factors are exactly the actual Airy initial values. -/
theorem airy_actual_normalization_factors :
    (3:ℂ)^(-2/3:ℂ)*complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} 0=(airyAiReal 0:ℂ) ∧
      (3:ℂ)^(-4/3:ℂ)*complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} 0=-((deriv airyAiReal (0:ℝ):ℝ):ℂ) := by
  constructor
  · rw [airyAiReal_ofReal,Complex.ofReal_zero,complex_airyAi_zero]
    simp [complex_regularizedHGFunCoeff,div_eq_mul_inv]
  · simp only [complex_regularizedHGFunCoeff,Multiset.map_zero,Multiset.prod_zero,
      Multiset.map_singleton,Multiset.prod_singleton,Nat.factorial_zero,Nat.cast_one,
      Nat.cast_zero,add_zero,one_mul]
    rw [deriv_airyAiReal_zero]
    rw [show (-4/3:ℂ)=((-4/3:ℝ):ℂ) by norm_num,complex_three_cpow_ofReal,
      show (4/3:ℂ)=((4/3:ℝ):ℂ) by norm_num,Complex.Gamma_ofReal]
    push_cast
    ring

/-- Fully normalized Airy remainder now contains only genuine initial values
and exact-rational recurrences. -/
theorem airy_actual_normalized_remainder
    (x : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hq0 : 0≤q /- [standing] -/ )
    (hq1 : q<1 /- [standing] -/ )
    (hx : |x^3/9|≤q*((2/3+(N:ℝ))*(N+1))  /- [standing] -/ )
    : |airyAiReal x-(airyAiReal 0*(∑ n ∈ Finset.range N,normalizedHGCoeff (2/3) n*(x^3/9)^n)+
        deriv airyAiReal 0*x*(∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n))|≤
      (|airyAiReal 0| *normalizedHGCoeff (2/3) N+
        |deriv airyAiReal 0| *|x| * normalizedHGCoeff (4/3) N)*|x^3/9|^N/(1-q) := by
  have h := airy_actual_scalar_remainder x N q hq0 hq1 hx
  rw [airy_partial_normalized x N] at h
  have e0 := actual_hg_coeff_normalized (2/3) N (by norm_num)
  have e1 := actual_hg_coeff_normalized (4/3) N (by norm_num)
  norm_num only [Complex.ofReal_div,Complex.ofReal_ofNat] at e0 e1
  rw [e0,e1] at h
  have hn0 : ‖(3:ℂ)^(-2/3:ℂ)‖*‖complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} 0‖=|airyAiReal 0| := by
    simpa only [norm_mul,Complex.norm_real,Real.norm_eq_abs] using congrArg norm airy_actual_normalization_factors.1
  have hn1 : ‖(3:ℂ)^(-4/3:ℂ)‖*‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} 0‖=|deriv airyAiReal 0| := by
    simpa only [norm_mul,norm_neg,Complex.norm_real,Real.norm_eq_abs] using congrArg norm airy_actual_normalization_factors.2
  have hw : ‖(x:ℂ)^3/9‖=|x^3/9| := by
    rw [← Complex.ofReal_pow,← Complex.ofReal_ofNat,← Complex.ofReal_div,Complex.norm_real,Real.norm_eq_abs]
  simp only [norm_mul,norm_pow,Complex.norm_real,Real.norm_eq_abs,hw,
    abs_of_pos (normalized_hg_coeff_positive (2/3) N (by norm_num)),
    abs_of_pos (normalized_hg_coeff_positive (4/3) N (by norm_num))] at h
  convert! h using 1
  rw [← hn0,← hn1]
  ring

/-- A uniform rational actual Airy error on the entire grid's evaluation range. -/
theorem airy_actual_uniform_rational_remainder
    (x : ℝ /- [definition] -/ )
    (hx : |x|≤6 /- [standing] -/ )
    : |airyAiReal x-(airyAiReal 0*(∑ n ∈ Finset.range 32,normalizedHGCoeff (2/3) n*(x^3/9)^n)+
        deriv airyAiReal 0*x*(∑ n ∈ Finset.range 32,normalizedHGCoeff (4/3) n*(x^3/9)^n))|≤1/10^18 := by
  have hw : |x^3/9|≤24 := by
    rw [abs_div,abs_pow]
    norm_num only [abs_of_pos (by norm_num : (0:ℝ)<9)]
    calc |x|^3/9≤(6:ℝ)^3/9 := by gcongr
         _ = 24 := by norm_num
  have h := airy_actual_normalized_remainder x 32 (1/2) (by norm_num) (by norm_num) (by norm_num; linarith)
  have hi := airy_actual_initial_rational_bounds
  have h0 : |airyAiReal 0|≤1 := by rw [abs_of_pos airyAiReal_zero_pos]; linarith [hi.2.1]
  have h1 : |deriv airyAiReal 0|≤1 := by rw [abs_of_neg deriv_airyAiReal_zero_neg]; linarith [hi.2.2.1]
  have hc := normalized_airy_tail_rational_budget
  have hc0 := hc.1.le
  have hc1 := hc.2.1.le
  apply h.trans
  calc (|airyAiReal 0| *normalizedHGCoeff (2/3) 32+
        |deriv airyAiReal 0| *|x| * normalizedHGCoeff (4/3) 32)*|x^3/9|^32/(1-(1/2:ℝ))≤
      (1*normalizedHGCoeff (2/3) 32+1*6*normalizedHGCoeff (4/3) 32)*(24:ℝ)^32/(1-(1/2:ℝ)) := by gcongr
       _ = 2*normalizedHGCoeff (2/3) 32*(24:ℝ)^32+
          12*normalizedHGCoeff (4/3) 32*(24:ℝ)^32 := by ring
       _ ≤ 1/10^18 := by linarith [hc.2.2.1,hc.2.2.2]

/-- Nonzero negative input instantiates the uniform actual error, with the
same already-certified initial values. -/
theorem airy_uniform_error_joint_probe :
    ∃ x : ℝ,x<0 ∧ |x|≤6 ∧
      |airyAiReal x-(airyAiReal 0*(∑ n ∈ Finset.range 32,normalizedHGCoeff (2/3) n*(x^3/9)^n)+
        deriv airyAiReal 0*x*(∑ n ∈ Finset.range 32,normalizedHGCoeff (4/3) n*(x^3/9)^n))|≤1/10^18 :=
  ⟨-3,by norm_num,by norm_num,airy_actual_uniform_rational_remainder (-3) (by norm_num)⟩

/-- Exact rational finite-series evaluations at a genuinely negative Airy level. -/
theorem airy_minus_three_polynomial_bounds :
    (-694730/1000000:ℝ)≤∑ n ∈ Finset.range 32,normalizedHGCoeff (2/3) n*(-3:ℝ)^n ∧
      (∑ n ∈ Finset.range 32,normalizedHGCoeff (2/3) n*(-3:ℝ)^n)≤-694729/1000000 ∧
      (-170217/1000000:ℝ)≤∑ n ∈ Finset.range 32,normalizedHGCoeff (4/3) n*(-3:ℝ)^n ∧
      (∑ n ∈ Finset.range 32,normalizedHGCoeff (4/3) n*(-3:ℝ)^n)≤-170216/1000000 := by
  norm_num [Finset.sum_range_succ,normalizedHGCoeff]

/-- Kernel-checked actual Airy enclosure in the negative-sign part of the window. -/
theorem airy_actual_minus_three_bounds :
    (-380/1000:ℝ)≤airyAiReal (-3) ∧ airyAiReal (-3)≤-378/1000 := by
  have hp := airy_minus_three_polynomial_bounds
  have hi := airy_actual_initial_rational_bounds
  have he := abs_le.mp (airy_actual_uniform_rational_remainder (-3) (by norm_num))
