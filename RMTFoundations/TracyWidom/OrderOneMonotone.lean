import RMTFoundations.TracyWidom.OrderOneBounds
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
namespace RMTFoundations.TWOneMonotone
open MeasureTheory Set Filter
open scoped Topology ENNReal InnerProductSpace BigOperators
open RMTFoundations.Fredholm RMTFoundations.Airy RMTFoundations.AiryBounds
open RMTFoundations.AiryKernel RMTFoundations.TWOneBounds
noncomputable def finiteDetDerivative
    (n : ℕ /- [definition] -/)
    (M V : Matrix (Fin n) (Fin n) ℝ /- [definition] -/) : ℝ :=
  ∑ j, (M.updateCol j (fun i => V i j)).det

theorem finiteDetDerivative_leibniz
    (n : ℕ /- [definition] -/)
    (M V : Matrix (Fin n) (Fin n) ℝ /- [definition] -/) :
    finiteDetDerivative n M V =
      ∑ σ : Equiv.Perm (Fin n), (Equiv.Perm.sign σ : ℝ) *
        ∑ j, (∏ i ∈ Finset.univ.erase j, M (σ i) i) * V (σ j) j := by
  classical
  unfold finiteDetDerivative
  simp_rw [Matrix.det_apply']
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro σ hσ
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  congr 1
  rw [← Finset.prod_erase_mul _ _ (Finset.mem_univ j)]
  simp only [Matrix.updateCol_self]
  congr 1
  apply Finset.prod_congr rfl
  intro i hi
  exact Matrix.updateCol_ne (Finset.ne_of_mem_erase hi)

theorem hasDerivAt_matrix_det
    (n : ℕ /- [definition] -/)
    (M : ℝ → Matrix (Fin n) (Fin n) ℝ /- [definition] -/)
    (V : Matrix (Fin n) (Fin n) ℝ /- [definition] -/)
    (s : ℝ /- [definition] -/)
    (hd : ∀ i j, HasDerivAt (fun t => M t i j) (V i j) s /- [standing] -/) :
    HasDerivAt (fun t => (M t).det) (finiteDetDerivative n (M s) V) s := by
  classical
  rw [finiteDetDerivative_leibniz]
  simp_rw [Matrix.det_apply']
  apply HasDerivAt.fun_sum
  intro σ hσ
  apply HasDerivAt.const_mul
  simpa only [smul_eq_mul] using
    HasDerivAt.fun_finsetProd (fun i (_ : i ∈ Finset.univ) => hd (σ i) i)


/-- Additivity of the division-free determinant differential. -/
theorem finiteDetDerivative_add
    (n : ℕ /- [definition] -/ )
    (M V W : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    : finiteDetDerivative n M (V + W) =
      finiteDetDerivative n M V + finiteDetDerivative n M W := by
  classical
  simp only [finiteDetDerivative_leibniz, Matrix.add_apply, mul_add,
    Finset.sum_add_distrib]

/-- Homogeneity of the division-free determinant differential. -/
theorem finiteDetDerivative_smul
    (n : ℕ /- [definition] -/ )
    (M V : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (c : ℝ /- [definition] -/ )
    : finiteDetDerivative n M (c • V) = c * finiteDetDerivative n M V := by
  classical
  unfold finiteDetDerivative
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  simpa only [Matrix.smul_apply,smul_eq_mul,Pi.smul_def] using
    Matrix.det_updateCol_smul M j c (fun i => V i j)

/-- A shift of every coordinate by t/2 is literally the kernel shift by t. -/
theorem airy_minor_diagonal_translation
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (s t : ℝ /- [definition] -/ )
    : kernelMinor (fun u v => airyAiReal (u+v+s+t)) n x =
      kernelMinor (fun u v => airyAiReal (u+v+s)) n (fun i => x i+t/2) := by
  have he : (fun i j : Fin n => airyAiReal (x i+x j+s+t)) =
      (fun i j : Fin n => airyAiReal ((x i+t/2)+(x j+t/2)+s)) := by
    funext i j
    congr 1
    ring
  exact congrArg Matrix.det he

/-- Actual all-order Airy-minor shift derivative. -/
theorem hasDerivAt_airy_minor_shift
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    : HasDerivAt (fun t => kernelMinor (fun u v => airyAiReal (u+v+t)) n x)
      (finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
        (fun i j => deriv airyAiReal (x i+x j+s))) s := by
  apply hasDerivAt_matrix_det
  intro i j
  simpa only [Function.comp_def,mul_one] using
    (hasDerivAt_airyAiReal' (x i+x j+s)).comp s
      ((hasDerivAt_id s).const_add (x i+x j))

/-- A matrix differential commutes with any finite sum of directions. -/
theorem finiteDetDerivative_sum
    {κ : Type* /- [definition] -/ }
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (V : κ → Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (u : Finset κ /- [definition] -/ )
    : finiteDetDerivative n M (∑ k ∈ u, V k) =
      ∑ k ∈ u, finiteDetDerivative n M (V k) := by
  classical
  induction u using Finset.induction_on with
  | empty => simp [finiteDetDerivative_leibniz]
  | insert a u ha ih =>
    rw [Finset.sum_insert ha,finiteDetDerivative_add,ih,Finset.sum_insert ha]

/-- Coordinate k differentiates its row and its column, including BOTH diagonal terms. -/
noncomputable def coordinateDirection
    (n : ℕ /- [definition] -/ )
    (V : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : Matrix (Fin n) (Fin n) ℝ := fun i j =>
      (if i=k then V i j else 0) + (if j=k then V i j else 0)

/-- Summing coordinate directions gives twice the kernel shift direction. -/
theorem coordinateDirection_sum
    (n : ℕ /- [definition] -/ )
    (V : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    : (∑ k, coordinateDirection n V k) = (2 : ℝ) • V := by
  classical
  ext i j
  simp only [Matrix.sum_apply,Matrix.smul_apply,smul_eq_mul,coordinateDirection,Finset.sum_add_distrib]
  simp [eq_comm,two_mul]

/-- Exact all-order algebra behind simultaneous-coordinate integration by parts. -/
theorem airy_minor_coordinate_derivative_sum
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    : (∑ k, finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
        (coordinateDirection n (fun i j => deriv airyAiReal (x i+x j+s)) k)) =
      2 * finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
        (fun i j => deriv airyAiReal (x i+x j+s)) := by
  rw [← finiteDetDerivative_sum,coordinateDirection_sum,finiteDetDerivative_smul]

/-- The coordinate differential above is the ACTUAL derivative of the Airy minor. -/
theorem hasDerivAt_airy_minor_coordinate
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : HasDerivAt
      (fun t => kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x k t))
      (finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
        (coordinateDirection n (fun i j => deriv airyAiReal (x i+x j+s)) k)) (x k) := by
  classical
  have hu (i : Fin n) : HasDerivAt (fun t => Function.update x k t i)
      (if i=k then 1 else 0) (x k) := by
    by_cases h : i=k
    · subst i; simpa using hasDerivAt_id' (x k)
    · simpa [Function.update_of_ne h,h] using hasDerivAt_const (x k) (x i)
  have hd := hasDerivAt_matrix_det n
    (fun t i j => airyAiReal (Function.update x k t i+Function.update x k t j+s))
    (coordinateDirection n (fun i j => deriv airyAiReal (x i+x j+s)) k) (x k) (by
      intro i j
      have h := (hasDerivAt_airyAiReal'
        (Function.update x k (x k) i+Function.update x k (x k) j+s)).comp (x k)
        (((hu i).add (hu j)).add_const s)
      convert! h using 1
      simp only [Function.update_eq_self]
      unfold coordinateDirection
      split_ifs <;> ring)
  simpa only [Function.update_eq_self,kernelMinor] using hd

/-- Every determinant/coordinate-calculus binder is jointly inhabited with nonzero physical data. -/
theorem airy_minor_coordinate_joint_probe :
    ∃ (n : ℕ) (x : Fin n → ℝ) (s : ℝ) (k : Fin n),
      0 < n ∧ kernelMinor (fun u v => airyAiReal (u+v+s)) n x ≠ 0 ∧
      finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
        (fun i j => deriv airyAiReal (x i+x j+s)) ≠ 0 ∧
      HasDerivAt
        (fun t => kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x k t))
        (finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
          (coordinateDirection n (fun i j => deriv airyAiReal (x i+x j+s)) k)) (x k) := by
  refine ⟨1,fun _ => 0,0,0,by norm_num,?_,?_,hasDerivAt_airy_minor_coordinate _ _ _ _⟩
  · simpa [kernelMinor,Matrix.det_fin_one] using airyAiReal_zero_pos.ne'
  · simpa [finiteDetDerivative,Matrix.det_fin_one] using deriv_airyAiReal_zero_neg.ne

theorem finiteDetDerivative_bound
    (n : ℕ /- [definition] -/)
    (M V : Matrix (Fin n) (Fin n) ℝ /- [definition] -/)
    (C : ℝ /- [definition] -/)
    (a : Fin n → ℝ /- [definition] -/)
    (hC : 0 ≤ C /- [standing] -/)
    (ha : ∀ i, 0 ≤ a i /- [standing] -/)
    (hM : ∀ i j, |M i j| ≤ C * a i * a j /- [standing] -/)
    (hV : ∀ i j, |V i j| ≤ C * a i * a j /- [standing] -/) :
    |finiteDetDerivative n M V| ≤
      (n : ℝ) * (Real.sqrt n * C) ^ n * ∏ i, a i ^ 2 := by
  classical
  unfold finiteDetDerivative
  calc
    |∑ j, (M.updateCol j (fun i => V i j)).det| ≤
        ∑ j, |(M.updateCol j (fun i => V i j)).det| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _j : Fin n, (Real.sqrt n * C) ^ n * ∏ i, a i ^ 2 := by
      apply Finset.sum_le_sum
      intro j hj
      apply weighted_matrix_det_bound n _ C a hC ha
      intro i k
      by_cases hk : k = j
      · subst k
        simpa only [Matrix.updateCol_self] using hV i j
      · simpa only [Matrix.updateCol_ne hk] using hM i k
    _ = _ := by simp [mul_assoc]


/-- Exponential envelope for Ai and its derivative on genuine nonnegative row arguments. -/
theorem airy_entry_pair_bound
    (s : ℝ /- [definition] -/ )
    : ∃ C : ℝ, 0 < C ∧ ∀ x y : ℝ, 0 ≤ x → 0 ≤ y →
      |airyAiReal (x+y+s)| ≤ C * Real.exp (-x/2) * Real.exp (-y/2) ∧
      |deriv airyAiReal (x+y+s)| ≤ C * Real.exp (-x/2) * Real.exp (-y/2) := by
  obtain ⟨C₀,hC₀,hb₀⟩ := airyAiReal_abs_le_exp'
  obtain ⟨C₁,hC₁,hb₁⟩ := airy_deriv_halfline_exp_bound s
  let C := max (C₀*Real.exp (-s)) (C₁*Real.exp (-s/2))
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro x y hx hy
  have h0 : |airyAiReal (x+y+s)| ≤
      (C₀*Real.exp (-s))*Real.exp (-x/2)*Real.exp (-y/2) := by
    calc
      _ ≤ C₀*Real.exp (-(x+y+s)) := hb₀ _
      _ ≤ C₀*Real.exp (-s + -x/2 + -y/2) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith)) hC₀.le
      _ = _ := by rw [Real.exp_add,Real.exp_add]; ring
  have h1 : |deriv airyAiReal (x+y+s)| ≤
      (C₁*Real.exp (-s/2))*Real.exp (-x/2)*Real.exp (-y/2) := by
    calc
      _ ≤ C₁*Real.exp (-(x+y+s)/2) := hb₁ _ (by linarith)
      _ = _ := by
        rw [show -(x+y+s)/2 = -s/2 + -x/2 + -y/2 by ring,
          Real.exp_add,Real.exp_add]; ring
  constructor
  · exact h0.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.exp_pos _).le) (Real.exp_pos _).le)
  · exact h1.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.exp_pos _).le) (Real.exp_pos _).le)

/-- The full minor and its coordinate derivative have integrable one-coordinate envelopes. -/
theorem airy_minor_coordinate_envelope
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (hx : ∀ i, 0 ≤ x i /- [standing] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : ∃ K : ℝ, 0 ≤ K ∧ ∀ t : ℝ, 0 ≤ t →
      |kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x k t)| ≤ K*Real.exp (-t) ∧
      |finiteDetDerivative n
        (fun i j => airyAiReal (Function.update x k t i+Function.update x k t j+s))
        (coordinateDirection n
          (fun i j => deriv airyAiReal (Function.update x k t i+Function.update x k t j+s)) k)|
        ≤ ((n:ℝ)*K)*Real.exp (-t) := by
  classical
  obtain ⟨C,hC,hb⟩ := airy_entry_pair_bound s
  let K := (Real.sqrt n * (2*C))^n
  refine ⟨K,by dsimp [K]; positivity,?_⟩
  intro t ht
  let y := Function.update x k t
  have hy : ∀ i, 0 ≤ y i := by
    intro i; by_cases h : i=k
    · subst i; simpa [y] using ht
    · simpa [y,Function.update_of_ne h] using hx i
  have ha : ∀ i, 0 ≤ Real.exp (-y i/2) := fun i => (Real.exp_pos _).le
  have hm : ∀ i j, |airyAiReal (y i+y j+s)| ≤
      (2*C)*Real.exp (-y i/2)*Real.exp (-y j/2) := by
    intro i j
    exact (hb _ _ (hy i) (hy j)).1.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (show C ≤ 2*C by linarith) (ha i)) (ha j))
  have hv : ∀ i j, |coordinateDirection n (fun i j => deriv airyAiReal (y i+y j+s)) k i j| ≤
      (2*C)*Real.exp (-y i/2)*Real.exp (-y j/2) := by
    intro i j
    have he := (hb _ _ (hy i) (hy j)).2
    have hp : 0 ≤ C*Real.exp (-y i/2)*Real.exp (-y j/2) := by positivity
    unfold coordinateDirection
    calc
      _ ≤ |if i=k then deriv airyAiReal (y i+y j+s) else 0| +
          |if j=k then deriv airyAiReal (y i+y j+s) else 0| := abs_add_le _ _
      _ ≤ (2*C)*Real.exp (-y i/2)*Real.exp (-y j/2) := by
        split_ifs <;> (try simp only [abs_zero]) <;> nlinarith
  have hw : (∏ i, (Real.exp (-y i/2))^2) ≤ Real.exp (-t) := by
    have he (i : Fin n) : (Real.exp (-y i/2))^2 = Real.exp (-y i) := by
      rw [pow_two,←Real.exp_add]; congr 1; ring
    simp_rw [he]
    rw [←Finset.prod_erase_mul _ _ (Finset.mem_univ k)]
    have hp : (∏ i ∈ Finset.univ.erase k, Real.exp (-y i)) ≤ 1 := by
      apply Finset.prod_le_one₀
      · intro i _; positivity
      · intro i _
        exact (Real.exp_le_exp.mpr (neg_nonpos.mpr (hy i))).trans_eq (Real.exp_zero)
    simpa [y] using mul_le_mul_of_nonneg_right hp (Real.exp_pos (-y k)).le
  constructor
  · exact (weighted_matrix_det_bound n _ (2*C) _ (by positivity) ha hm).trans
      (mul_le_mul_of_nonneg_left hw (by positivity))
  · exact (finiteDetDerivative_bound n _ _ (2*C) _ (by positivity) ha hm hv).trans
      (by simpa only [K,mul_assoc] using
        mul_le_mul_of_nonneg_left hw (show 0 ≤ (n:ℝ)*K by positivity))

/-- The actual derivative integrand is continuous, including its zero endpoint. -/
theorem airy_minor_coordinate_integrand_continuous
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : Continuous (fun t => finiteDetDerivative n
        (fun i j => airyAiReal (Function.update x k t i+Function.update x k t j+s))
        (coordinateDirection n
          (fun i j => deriv airyAiReal (Function.update x k t i+Function.update x k t j+s)) k)) := by
  classical
  simp_rw [finiteDetDerivative_leibniz]
  apply continuous_finsetSum
  intro σ _
  apply Continuous.const_mul
  apply continuous_finsetSum
  intro j _
  apply Continuous.mul
  · apply continuous_finsetProd
    intro i _
    apply Ai_continuous.comp
    have h (i : Fin n) : Continuous (fun t => Function.update x k t i) := by
      by_cases h : i=k
      · subst i; simp only [Function.update_self]; fun_prop
      · simpa [Function.update_of_ne h] using continuous_const
    exact ((h _).add (h _)).add continuous_const
  · unfold coordinateDirection
    split_ifs <;> try exact continuous_const
    all_goals
      have hc : Continuous (fun t => deriv airyAiReal
          (Function.update x k t (σ j)+Function.update x k t j+s)) := by
        apply continuous_deriv_airyAiReal.comp
        have h (i : Fin n) : Continuous (fun t => Function.update x k t i) := by
          by_cases h : i=k
          · subst i; simp only [Function.update_self]; fun_prop
          · simpa [Function.update_of_ne h] using continuous_const
        exact ((h _).add (h _)).add continuous_const
      fun_prop

/-- Integration by parts produces the ACTUAL boundary minor at every order. -/
theorem airy_minor_coordinate_integral_boundary
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (hx : ∀ i, 0 ≤ x i /- [standing] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : (∫ t, finiteDetDerivative n
        (fun i j => airyAiReal (Function.update x k t i+Function.update x k t j+s))
        (coordinateDirection n
          (fun i j => deriv airyAiReal (Function.update x k t i+Function.update x k t j+s)) k)
        ∂halfLineMeasure) =
      -kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x k 0) := by
  classical
  let f := fun t => kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x k t)
  let df := fun t => finiteDetDerivative n
    (fun i j => airyAiReal (Function.update x k t i+Function.update x k t j+s))
    (coordinateDirection n
      (fun i j => deriv airyAiReal (Function.update x k t i+Function.update x k t j+s)) k)
  have hd (t : ℝ) : HasDerivAt f (df t) t := by
    have he (r : ℝ) : Function.update (Function.update x k t) k r =
        Function.update x k r := by
      funext i
      by_cases h : i=k
      · subst i; simp
      · simp [Function.update_of_ne h]
    simpa [f,df,he] using
      hasDerivAt_airy_minor_coordinate n (Function.update x k t) s k
  obtain ⟨K,hK,hb⟩ := airy_minor_coordinate_envelope n x hx s k
  have hi : IntegrableOn df (Ioi 0) := by
    apply ((integrableOn_exp_neg_Ioi 0).const_mul ((n:ℝ)*K)).mono'
      (airy_minor_coordinate_integrand_continuous n x s k).aestronglyMeasurable
    apply ae_restrict_of_forall_mem measurableSet_Ioi
    intro t ht
    simpa only [Real.norm_eq_abs] using (hb t ht.le).2
  have hf : Tendsto f atTop (𝓝 0) := by
    apply squeeze_zero_norm' (eventually_atTop.2 ⟨0,fun t ht => by
      simpa only [f,Real.norm_eq_abs] using (hb t ht).1⟩)
    simpa using Real.tendsto_exp_neg_atTop_nhds_zero.const_mul K
  have he := integral_Ioi_of_hasDerivAt_of_tendsto'
    (fun t _ => hd t) hi hf
  simpa only [zero_sub,halfLineMeasure,f,df] using he
/-- Every boundary-integration binder holds jointly on a nonzero actual Airy minor. -/
theorem airy_minor_boundary_joint_probe :
    ∃ (n : ℕ) (x : Fin n → ℝ) (s : ℝ) (k : Fin n),
      0 < n ∧ (∀ i, 0 ≤ x i) ∧
      kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x k 0) ≠ 0 ∧
      (∫ t, finiteDetDerivative n
        (fun i j => airyAiReal (Function.update x k t i+Function.update x k t j+s))
        (coordinateDirection n
          (fun i j => deriv airyAiReal (Function.update x k t i+Function.update x k t j+s)) k)
        ∂halfLineMeasure) =
      -kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x k 0) ∧
      (∫ t, finiteDetDerivative n
        (fun i j => airyAiReal (Function.update x k t i+Function.update x k t j+s))
        (coordinateDirection n
          (fun i j => deriv airyAiReal (Function.update x k t i+Function.update x k t j+s)) k)
        ∂halfLineMeasure) < 0 := by
  let x : Fin 1 → ℝ := fun _ => 0
  have hx : ∀ i, 0 ≤ x i := by intro i; exact le_rfl
  have he := airy_minor_coordinate_integral_boundary 1 x hx 0 0
  have hp : 0 < kernelMinor (fun u v => airyAiReal (u+v+0)) 1 (Function.update x 0 0) := by
    simpa [kernelMinor,Matrix.det_fin_one,x] using airyAiReal_zero_pos
  exact ⟨1,x,0,0,by norm_num,hx,hp.ne',he,he.trans_lt (neg_neg_of_pos hp)⟩




/-- Signed spectra give an absolutely convergent real log-determinant expansion. -/
theorem signed_log_tprod
    {ι : Type* /- [definition] -/ }
    (lam : ι → ℝ /- [definition] -/ )
    (ha : Summable (fun i => ‖lam i‖)  /- [standing] -/ )
    (hlt : ∀ i, lam i < 1 /- [standing] -/ )
    : Summable (fun i => Real.log (1-lam i)) ∧
      Real.log (∏' i, (1-lam i)) = ∑' i, Real.log (1-lam i) := by
  have hs : Summable (fun i => Real.log (1-lam i)) := by
    simpa only [sub_eq_add_neg] using
      Real.summable_log_one_add_of_summable ha.of_norm.neg
  refine ⟨hs, ?_⟩
  rw [← Real.rexp_tsum_eq_tprod (fun i => sub_pos.mpr (hlt i)) hs, Real.log_exp]

/-- The exact signed eigenvalue expansion of the actual TW1 logarithm. -/
theorem log_TW1R_eigenbasis
    {ι : Type* /- [definition] -/ }
    (s : ℝ /- [definition] -/ )
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (lam : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, airyHankelShift s (b i) = lam i • b i /- [standing] -/ )
    : Summable (fun i => Real.log (1-lam i)) ∧
      Real.log (TW1R s) = ∑' i, Real.log (1-lam i) := by
  letI := airyL2_basis_countable b
  have hn := norm_airyHankelShift_lt_one s
  have hl : ∀ i, lam i < 1 := by
    intro i
    have h := (airyHankelShift s).le_opNorm (b i)
    rw [hd i, norm_smul, b.orthonormal.norm_eq_one i, Real.norm_eq_abs,
      mul_one, mul_one] at h
    exact (le_abs_self _).trans_lt (h.trans_lt hn)
  have hp : TW1R s = ∏' i, (1-lam i) := by
    simpa only [TW1R, TW1, B_fredholm_physical, Complex.ofReal_neg,
      Complex.ofReal_one, neg_one_mul, sub_eq_add_neg] using
        airy_eigenbasis_product_on s b lam hd (-1)
  rw [hp]
  exact signed_log_tprod lam (airy_eigenbasis_absolute_on s b lam hd) hl

/-- A negative spectral mode is a negative boundary-resolvent contribution. -/
theorem negative_mode_boundary_contribution
    (lam a : ℝ /- [definition] -/ )
    (hl : lam < 0 /- [standing] -/ )
    (ha : a ≠ 0 /- [standing] -/ )
    : lam * a^2 / (1-lam) < 0 := by
  exact div_neg_of_neg_of_pos
    (mul_neg_of_neg_of_pos hl (sq_pos_of_ne_zero ha)) (by linarith)

/-- Strict contraction alone does not force the signed boundary sum positive. -/
theorem signed_boundary_counterprobe :
    ∃ (lam a : Fin 2 → ℝ),
      (∀ i, |lam i| < 1) ∧ (∀ i, a i ≠ 0) ∧
      (∃ i, 0 < lam i) ∧ (∃ i, lam i < 0) ∧
      (∑ i, lam i*a i^2/(1-lam i)) < 0 := by
  refine ⟨![1/4,-1/2], ![1,2], ?_, ?_, ⟨0, ?_⟩, ⟨1, ?_⟩, ?_⟩
  · intro i; fin_cases i <;> norm_num
  · intro i; fin_cases i <;> norm_num
  · norm_num
  · norm_num
  · norm_num [Fin.sum_univ_two]

/-- Uniform strict spectral radius controls both indices of the logarithmic series. -/
theorem signed_log_power_absolute
    {ι : Type* /- [definition] -/ }
    (lam : ι → ℝ /- [definition] -/ )
    (ha : Summable (fun i => ‖lam i‖)  /- [standing] -/ )
    (r : ℝ /- [definition] -/ )
    (hr : 0 ≤ r /- [standing] -/ )
    (hr1 : r < 1 /- [standing] -/ )
    (hb : ∀ i, |lam i| ≤ r /- [standing] -/ )
    : Summable (fun p : ι × ℕ => ‖lam p.1 ^ (p.2+1) / (p.2+1 : ℝ)‖) := by
  have hg : Summable (fun k : ℕ => r ^ k) := summable_geometric_of_lt_one hr hr1
  have hmajor := ha.mul_of_nonneg hg (fun i => norm_nonneg (lam i)) (fun k => pow_nonneg hr k)
  apply Summable.of_nonneg_of_le (fun p => norm_nonneg _) _ hmajor
  intro p
  rw [Real.norm_eq_abs, abs_div, abs_pow,
    abs_of_pos (show 0 < (p.2+1 : ℝ) by positivity)]
  have hden : (1 : ℝ) ≤ p.2+1 := by have h := Nat.cast_nonneg (α := ℝ) p.2; linarith
  calc
    |lam p.1| ^ (p.2+1) / (p.2+1 : ℝ) ≤ |lam p.1| ^ (p.2+1) :=
      div_le_self (by positivity) hden
    _ ≤ |lam p.1| * r ^ p.2 := by
      rw [pow_succ]
      exact (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (abs_nonneg _) (hb _) _) (abs_nonneg _)).trans_eq (mul_comm _ _)
    _ = ‖lam p.1‖ * r ^ p.2 := by rw [Real.norm_eq_abs]

/-- Absolutely convergent trace-power expansion, valid for signed eigenvalues. -/
theorem signed_log_tprod_power_series
    {ι : Type* /- [definition] -/ }
    (lam : ι → ℝ /- [definition] -/ )
    (ha : Summable (fun i => ‖lam i‖)  /- [standing] -/ )
    (r : ℝ /- [definition] -/ )
    (hr : 0 ≤ r /- [standing] -/ )
    (hr1 : r < 1 /- [standing] -/ )
    (hb : ∀ i, |lam i| ≤ r /- [standing] -/ )
    : -Real.log (∏' i, (1-lam i)) =
      ∑' k : ℕ, (∑' i, lam i ^ (k+1)) / (k+1 : ℝ) := by
  have hlt : ∀ i, |lam i| < 1 := fun i => (hb i).trans_lt hr1
  rw [(signed_log_tprod lam ha (fun i => (le_abs_self _).trans_lt (hlt i))).2,
    ← tsum_neg]
  calc
    (∑' i, -Real.log (1-lam i)) = ∑' i, ∑' k : ℕ, lam i^(k+1)/(k+1 : ℝ) := by
      apply tsum_congr
      intro i
      exact (Real.hasSum_pow_div_log_of_abs_lt_one (hlt i)).tsum_eq.symm
    _ = ∑' k : ℕ, ∑' i, lam i^(k+1)/(k+1 : ℝ) :=
      (signed_log_power_absolute lam ha r hr hr1 hb).of_norm.tsum_comm.symm
    _ = _ := by simp_rw [tsum_div_const]

/-- The actual Airy TW1 logarithm has the signed trace-power expansion. -/
theorem log_TW1R_power_series
    {ι : Type* /- [definition] -/ }
    (s : ℝ /- [definition] -/ )
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (lam : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, airyHankelShift s (b i) = lam i • b i /- [standing] -/ )
    : Summable (fun p : ι × ℕ => ‖lam p.1^(p.2+1)/(p.2+1 : ℝ)‖) ∧
      -Real.log (TW1R s) = ∑' k : ℕ, (∑' i, lam i^(k+1))/(k+1 : ℝ) := by
  letI := airyL2_basis_countable b
  have ha := airy_eigenbasis_absolute_on s b lam hd
  have hb : ∀ i, |lam i| ≤ ‖airyHankelShift s‖ := by
    intro i
    simpa only [hd i,norm_smul,b.orthonormal.norm_eq_one i,Real.norm_eq_abs,mul_one]
      using (airyHankelShift s).le_opNorm (b i)
  have hp : TW1R s = ∏' i, (1-lam i) := by
    simpa only [TW1R, TW1, B_fredholm_physical, Complex.ofReal_neg,
      Complex.ofReal_one, neg_one_mul, sub_eq_add_neg] using
        airy_eigenbasis_product_on s b lam hd (-1)
  refine ⟨signed_log_power_absolute lam ha _ (norm_nonneg _)
    (norm_airyHankelShift_lt_one s) hb, ?_⟩
  rw [hp]
  exact signed_log_tprod_power_series lam ha _ (norm_nonneg _)
    (norm_airyHankelShift_lt_one s) hb

/-- All generic log-series binders have a common mixed-sign, nonzero instance. -/
theorem signed_log_power_joint_probe :
    ∃ (lam : Fin 2 → ℝ) (r : ℝ),
      Summable (fun i => ‖lam i‖) ∧ 0 ≤ r ∧ r < 1 ∧
      (∀ i, |lam i| ≤ r) ∧ (∃ i, 0 < lam i) ∧ (∃ i, lam i < 0) ∧
      Summable (fun p : Fin 2 × ℕ => ‖lam p.1^(p.2+1)/(p.2+1 : ℝ)‖) ∧
      -Real.log (∏' i, (1-lam i)) = ∑' k : ℕ, (∑' i, lam i^(k+1))/(k+1 : ℝ) := by
  let lam : Fin 2 → ℝ := ![1/2,-1/3]
  have ha : Summable (fun i => ‖lam i‖) := (hasSum_fintype _).summable
  have hb : ∀ i, |lam i| ≤ (3/4 : ℝ) := by
    intro i; fin_cases i <;> norm_num [lam]
  refine ⟨lam,3/4,ha,by norm_num,by norm_num,hb,⟨0,by norm_num [lam]⟩,
    ⟨1,by norm_num [lam]⟩,signed_log_power_absolute lam ha _ (by norm_num) (by norm_num) hb,
    signed_log_tprod_power_series lam ha _ (by norm_num) (by norm_num) hb⟩

/-- The actual nonzero Airy operator jointly supplies every spectral log premise. -/
theorem airy_log_power_joint_probe
    (s : ℝ /- [definition] -/ )
    : ∃ (ι : Type) (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)) (lam : ι → ℝ),
      (∀ i, airyHankelShift s (b i) = lam i • b i) ∧
      Summable (fun i => ‖lam i‖) ∧ ‖airyHankelShift s‖ < 1 ∧
      airyBoundaryVector s ≠ 0 ∧
      Summable (fun p : ι × ℕ => ‖lam p.1^(p.2+1)/(p.2+1 : ℝ)‖) ∧
      -Real.log (TW1R s) = ∑' k : ℕ, (∑' i, lam i^(k+1))/(k+1 : ℝ) := by
  obtain ⟨ι,b,lam,hd⟩ := compact_symmetric_real_eigenbasis (airyHankelShift s)
    (isTraceClass_airyHankelShift s).isCompactOperator
    (ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp (isSelfAdjoint_airyHankelShift s))
  letI := airyL2_basis_countable b
  exact ⟨ι,b,lam,hd,airy_eigenbasis_absolute_on s b lam hd,
    norm_airyHankelShift_lt_one s,airyBoundaryVector_ne_zero s,
    (log_TW1R_power_series s b lam hd).1,(log_TW1R_power_series s b lam hd).2⟩

/-- Positive trace, strict contraction, and determinant in (0,1) still do not fix the signed boundary sum. -/
theorem signed_positive_trace_counterprobe :
    ∃ (lam a : Fin 2 → ℝ),
      (∀ i, |lam i| < 1) ∧ (∀ i, a i ≠ 0) ∧
      0 < (∑ i, lam i) ∧ 0 < (∏ i, (1-lam i)) ∧ (∏ i, (1-lam i)) < 1 ∧
      (∑ i, lam i*a i^2/(1-lam i)) < 0 := by
  refine ⟨![3/5,-2/5],![1,4],?_,?_,?_,?_,?_,?_⟩
  · intro i; fin_cases i <;> norm_num
  · intro i; fin_cases i <;> norm_num
  all_goals norm_num [Fin.sum_univ_two,Fin.prod_univ_two]

/-- A genuine mixed-sign Hellmann--Feynman model has a decreasing determinant at zero. -/
theorem signed_HF_curve_counterprobe :
    HasDerivAt
      (fun t : ℝ => (1-(3/5:ℝ)*Real.exp (-t/2))*(1+(2/5:ℝ)*Real.exp (-8*t)))
      (-43/50) 0 := by
  have h1 := (Real.hasDerivAt_exp ((-(id (0:ℝ)))/2)).comp (0:ℝ) ((hasDerivAt_id (0:ℝ)).neg.div_const 2)
  have h2 := (Real.hasDerivAt_exp ((-8:ℝ)*id (0:ℝ))).comp (0:ℝ) ((hasDerivAt_id (0:ℝ)).const_mul (-8))
  have h := ((h1.const_mul (3/5:ℝ)).const_sub 1).mul
    ((h2.const_mul (2/5:ℝ)).const_add 1)
  convert! h using 1 <;> simp [Function.comp_def,id_eq] <;> ring




/-- Unconditional optimized lower certificate for the genuine Airy boundary resolvent.
Its scalar sign in the compact negative window is deliberately not asserted. -/
theorem airy_actual_tangent_lower
    (s : ℝ /- [definition] -/ )
    : 0 < airyEnergy s - (∫ x, airyAiReal (s+x) * airyKernelIntegral (x+s) s ∂halfLineMeasure) ∧
      airyAiReal s + (airyEnergy s)^2 /
        (airyEnergy s - (∫ x, airyAiReal (s+x) * airyKernelIntegral (x+s) s ∂halfLineMeasure)) ≤
      airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  have hn := norm_airyHankelShift_lt_one s
  have hs : ∀ x y, inner ℝ (airyHankelShift s x) y = inner ℝ x (airyHankelShift s y) :=
    ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mp (isSelfAdjoint_airyHankelShift s)
  have h := contraction_resolvent_tangent_lower (airyHankelShift s)
    (Ring.inverse (1-airyHankelShift s)) hn hs
    (contraction_ringInverse_right (airyHankelShift s) hn)
    (contraction_ringInverse_left (airyHankelShift s) hn)
    (airyBoundaryVector s) (airyBoundaryVector_ne_zero s)
  rw [airyBoundaryVector_inner_self,airyBoundaryVector_cubic_moment] at h
  exact ⟨h.1,add_le_add le_rfl h.2⟩

/-- The two numerically tested certificates bound the same canonical inverse,
with every operator premise discharged at every real shift. -/
theorem airy_actual_cubic_lower
    (s : ℝ /- [definition] -/ )
    : airyAiReal s + airyEnergy s +
        (∫ x, airyAiReal (s+x) * airyKernelIntegral (x+s) s ∂halfLineMeasure) ≤
      airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  have hn := norm_airyHankelShift_lt_one s
  exact airy_boundary_cubic_lower (Ring.inverse (1-airyHankelShift s)) s hn
    (contraction_ringInverse_right (airyHankelShift s) hn)
    (contraction_ringInverse_left (airyHankelShift s) hn)

/-- Joint nondegenerate physical inhabitant; no numeric sign or inverse premise is assumed. -/
theorem airy_actual_certificates_joint_probe
    (s : ℝ /- [definition] -/ )
    : airyBoundaryVector s ≠ 0 ∧ 0 < airyEnergy s ∧
      0 < airyEnergy s - (∫ x, airyAiReal (s+x) * airyKernelIntegral (x+s) s ∂halfLineMeasure) ∧
      airyAiReal s + (airyEnergy s)^2 /
        (airyEnergy s - (∫ x, airyAiReal (s+x) * airyKernelIntegral (x+s) s ∂halfLineMeasure)) ≤
      airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) ∧
      airyAiReal s + airyEnergy s +
        (∫ x, airyAiReal (s+x) * airyKernelIntegral (x+s) s ∂halfLineMeasure) ≤
      airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) :=
  ⟨airyBoundaryVector_ne_zero s,airyEnergy_pos s,(airy_actual_tangent_lower s).1,
    (airy_actual_tangent_lower s).2,airy_actual_cubic_lower s⟩



/- Calculus identities for the order-one Fredholm distribution. -/
noncomputable def kernelMinorDerivative
    {α : Type* /- [definition] -/ }
    (k dk : α → α → ℝ /- [definition] -/)
    (n : ℕ /- [definition] -/)
    (x : Fin n → α /- [definition] -/) : ℝ :=
  finiteDetDerivative n (fun i j => k (x i) (x j)) (fun i j => dk (x i) (x j))

theorem hasDerivAt_kernelMinor
    {α : Type* /- [definition] -/ }
    (k : ℝ → α → α → ℝ /- [definition] -/)
    (dk : α → α → ℝ /- [definition] -/)
    (s : ℝ /- [definition] -/)
    (hd : ∀ x y, HasDerivAt (fun t => k t x y) (dk x y) s /- [standing] -/)
    (n : ℕ /- [definition] -/)
    (x : Fin n → α /- [definition] -/) :
    HasDerivAt (fun t => kernelMinor (k t) n x) (kernelMinorDerivative (k s) dk n x) s :=
  hasDerivAt_matrix_det n _ _ s (fun i j => hd (x i) (x j))

theorem kernelMinorDerivative_measurable
    {α : Type* /- [definition] -/ }
    [MeasurableSpace α /- [definition] -/ ]
    (k dk : α → α → ℝ /- [definition] -/)
    (hk : Measurable (Function.uncurry k) /- [standing] -/ )
    (hd : Measurable (Function.uncurry dk) /- [standing] -/ )
    (n : ℕ /- [definition] -/) : Measurable (kernelMinorDerivative k dk n) := by
  classical
  unfold kernelMinorDerivative
  simp_rw [finiteDetDerivative_leibniz]
  apply Finset.measurable_sum
  intro σ hσ
  apply measurable_const.mul
  apply Finset.measurable_sum
  intro j hj
  apply Measurable.mul
  · apply Finset.measurable_prod
    intro i hi
    have hp : Measurable (fun x : Fin n → α => (x (σ i),x i)) :=
      (measurable_pi_apply (σ i)).prodMk (measurable_pi_apply i)
    simpa only [Function.comp_def,Function.uncurry_apply_pair] using hk.comp hp
  · have hp : Measurable (fun x : Fin n → α => (x (σ j),x j)) :=
      (measurable_pi_apply (σ j)).prodMk (measurable_pi_apply j)
    simpa only [Function.comp_def,Function.uncurry_apply_pair] using hd.comp hp

theorem kernelMinorDerivative_bound
    {α : Type* /- [definition] -/ }
    (k dk : α → α → ℝ /- [definition] -/)
    (C : ℝ /- [definition] -/)
    (a : α → ℝ /- [definition] -/)
    (hC : 0 ≤ C /- [standing] -/)
    (ha : ∀ x, 0 ≤ a x /- [standing] -/)
    (hk : ∀ x y, |k x y| ≤ C * a x * a y /- [standing] -/)
    (hd : ∀ x y, |dk x y| ≤ C * a x * a y /- [standing] -/)
    (n : ℕ /- [definition] -/)
    (x : Fin n → α /- [definition] -/) :
    |kernelMinorDerivative k dk n x| ≤
      (n : ℝ) * (Real.sqrt n * C) ^ n * ∏ i, a (x i) ^ 2 :=
  finiteDetDerivative_bound n _ _ C (fun i => a (x i)) hC
    (fun i => ha (x i)) (fun i j => hk (x i) (x j)) (fun i j => hd (x i) (x j))

theorem hadamardDerivative_summable
    (M : ℝ /- [definition] -/)
    (hM : 0 ≤ M /- [standing] -/) :
    Summable (fun n : ℕ => (n : ℝ) * hadamardMajorant M n) := by
  refine Summable.of_nonneg_of_le (fun n => by unfold hadamardMajorant; positivity)
    (fun n => ?_) (hadamardMajorant_summable (2 * M) (by positivity))
  have hn : (n : ℝ) ≤ (2 : ℝ) ^ n := by
    induction n with
    | zero => norm_num
    | succ n ih =>
      have hp : (1 : ℝ) ≤ (2 : ℝ) ^ n := one_le_pow₀ (by norm_num)
      simp only [Nat.cast_succ,pow_succ]
      linarith
  unfold hadamardMajorant
  calc
    (n : ℝ) * ((Real.sqrt n * M) ^ n / (n.factorial : ℝ)) ≤
      (2 : ℝ) ^ n * ((Real.sqrt n * M) ^ n / (n.factorial : ℝ)) :=
      mul_le_mul_of_nonneg_right hn (by positivity)
    _ = (Real.sqrt n * (2 * M)) ^ n / (n.factorial : ℝ) := by rw [mul_pow]; ring


noncomputable def kernelCoefficientDerivative
    {α : Type* /- [definition] -/ }
    [MeasurableSpace α /- [definition] -/ ]
    (μ : Measure α /- [definition] -/)
    (k dk : α → α → ℝ /- [definition] -/)
    (n : ℕ /- [definition] -/) : ℝ :=
  (∫ x, kernelMinorDerivative k dk n x ∂Measure.pi (fun _ => μ)) / (n.factorial : ℝ)

theorem hasDerivAt_kernelCoefficient
    {α : Type* /- [definition] -/ }
    [MeasurableSpace α /- [definition] -/ ]
    (μ : Measure α /- [definition] -/)
    [SigmaFinite μ /- [definition] -/ ]
    (k dk : ℝ → α → α → ℝ /- [definition] -/)
    (s : ℝ /- [definition] -/)
    (U : Set ℝ /- [definition] -/)
    (hU : U ∈ 𝓝 s /- [standing] -/)
    (C : ℝ /- [definition] -/)
    (a : α → ℝ /- [definition] -/)
    (hC : 0 ≤ C /- [standing] -/)
    (ha : ∀ x, 0 ≤ a x /- [standing] -/)
    (ha2 : Integrable (fun x => a x ^ 2) μ /- [standing] -/)
    (hk : ∀ t, Measurable (Function.uncurry (k t)) /- [standing] -/ )
    (hd : ∀ t, Measurable (Function.uncurry (dk t)) /- [standing] -/ )
    (hdif : ∀ t x y, HasDerivAt (fun r => k r x y) (dk t x y) t /- [standing] -/)
    (hb : ∀ t ∈ U, ∀ x y, |k t x y| ≤ C * a x * a y /- [standing] -/)
    (hdb : ∀ t ∈ U, ∀ x y, |dk t x y| ≤ C * a x * a y /- [standing] -/)
    (n : ℕ /- [definition] -/) :
    HasDerivAt (fun t => kernelCoefficient μ (k t) n)
      (kernelCoefficientDerivative μ (k s) (dk s) n) s := by
  have hs : s ∈ U := mem_of_mem_nhds hU
  have hi : Integrable (fun x : Fin n → α => ∏ i, a (x i) ^ 2)
      (Measure.pi (fun _ => μ)) := Integrable.fintype_prod (fun _ => ha2)
  have hkint := kernelMinor_integrable_of_minor_bound μ (k s) a C ha2 (hk s)
    (fun m x => weighted_kernel_minor_bound_pow m (k s) C a x hC ha (hb s hs)) n
  have hdint := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := Measure.pi (fun _ : Fin n => μ))
    (F := fun t x => kernelMinor (k t) n x)
    (F' := fun t x => kernelMinorDerivative (k t) (dk t) n x)
    (bound := fun x => (n : ℝ) * (Real.sqrt n * C) ^ n * ∏ i, a (x i) ^ 2)
    hU (Eventually.of_forall (fun t => (kernelMinor_measurable (k t) (hk t) n).aestronglyMeasurable))
    hkint (kernelMinorDerivative_measurable (k s) (dk s) (hk s) (hd s) n).aestronglyMeasurable
    (Eventually.of_forall (fun x t ht => by
      simpa only [Real.norm_eq_abs] using kernelMinorDerivative_bound (k t) (dk t) C a
        hC ha (hb t ht) (hdb t ht) n x))
    (hi.const_mul _) (Eventually.of_forall (fun x t _ => hasDerivAt_kernelMinor k (dk t) t (hdif t) n x))
  exact hdint.2.div_const _

theorem kernelCoefficientDerivative_bound
    {α : Type* /- [definition] -/ }
    [MeasurableSpace α /- [definition] -/ ]
    (μ : Measure α /- [definition] -/)
    [SigmaFinite μ /- [definition] -/ ]
    (k dk : α → α → ℝ /- [definition] -/)
    (C : ℝ /- [definition] -/)
    (a : α → ℝ /- [definition] -/)
    (hC : 0 ≤ C /- [standing] -/)
    (ha : ∀ x, 0 ≤ a x /- [standing] -/)
    (ha2 : Integrable (fun x => a x ^ 2) μ /- [standing] -/)
    (hk : ∀ x y, |k x y| ≤ C * a x * a y /- [standing] -/)
    (hd : ∀ x y, |dk x y| ≤ C * a x * a y /- [standing] -/)
    (n : ℕ /- [definition] -/) :
    |kernelCoefficientDerivative μ k dk n| ≤
      (n : ℝ) * hadamardMajorant (C * ∫ x, a x ^ 2 ∂μ) n := by
  have hi : Integrable (fun x : Fin n → α => ∏ i, a (x i) ^ 2)
      (Measure.pi (fun _ => μ)) := Integrable.fintype_prod (fun _ => ha2)
  have hh := norm_integral_le_of_norm_le (f := kernelMinorDerivative k dk n)
    (hi.const_mul ((n : ℝ) * (Real.sqrt n * C) ^ n))
    (Eventually.of_forall (fun x => by
      simpa only [Real.norm_eq_abs] using kernelMinorDerivative_bound k dk C a hC ha hk hd n x))
  rw [integral_const_mul, integral_fintype_prod_eq_pow (fun x => a x ^ 2)] at hh
  unfold kernelCoefficientDerivative
  rw [abs_div, abs_of_nonneg (show (0 : ℝ) ≤ n.factorial by positivity)]
  calc
    _ ≤ ((n : ℝ) * (Real.sqrt n * C) ^ n * (∫ x, a x ^ 2 ∂μ) ^ n) / (n.factorial : ℝ) :=
      div_le_div_of_nonneg_right (by simpa only [Real.norm_eq_abs, Fintype.card_fin] using hh) (by positivity)
    _ = _ := by unfold hadamardMajorant; simp only [mul_pow]; ring

/- Locally dominated differentiation of the real kernel Fredholm series. -/
theorem hasDerivAt_real_kernelSeries
    (c dc : ℝ → ℕ → ℝ /- [definition] -/)
    (U : Set ℝ /- [definition] -/)
    (hU : IsOpen U /- [standing] -/)
    (hconn : IsPreconnected U /- [standing] -/)
    (s : ℝ /- [definition] -/)
    (hs : s ∈ U /- [standing] -/)
    (M : ℝ /- [definition] -/)
    (hM : 0 ≤ M /- [standing] -/)
    (hd : ∀ n t, t ∈ U → HasDerivAt (fun r => c r n) (dc t n) t /- [standing] -/)
    (hb : ∀ n t, t ∈ U → |dc t n| ≤ (n : ℝ) * hadamardMajorant M n /- [standing] -/)
    (z : ℝ /- [definition] -/)
    (hc : Summable (fun n => c s n * z ^ n) /- [standing] -/ ) :
    HasDerivAt (fun t => ∑' n, c t n * z ^ n) (∑' n, dc s n * z ^ n) s := by
  apply hasDerivAt_tsum_of_isPreconnected
    (u := fun n : ℕ => (n : ℝ) * hadamardMajorant (M * |z|) n)
    (hadamardDerivative_summable _ (by positivity)) hU hconn
    (fun n t ht => (hd n t ht).mul_const (z ^ n)) ?_ hs hc hs
  intro n t ht
  rw [Real.norm_eq_abs, abs_mul, abs_pow]
  calc
    |dc t n| * |z| ^ n ≤ ((n : ℝ) * hadamardMajorant M n) * |z| ^ n :=
      mul_le_mul_of_nonneg_right (hb n t ht) (by positivity)
    _ = (n : ℝ) * hadamardMajorant (M * |z|) n := by
      unfold hadamardMajorant
      simp only [mul_pow]
      ring


noncomputable def B_shiftDerivativeKernel
    (s x y : ℝ /- [definition] -/) : ℝ :=
  positiveExtension (fun u v => deriv airyAiReal (u + v + s)) x y

noncomputable def airyFredholmDerivativeWeight
    (x : ℝ /- [definition] -/) : ℝ := Real.exp (-x / 2)

theorem airyFredholmDerivativeWeight_sq_integrable :
    Integrable (fun x => airyFredholmDerivativeWeight x ^ 2) halfLineMeasure := by
  have he : (fun x => airyFredholmDerivativeWeight x ^ 2) = fun x : ℝ => Real.exp (-x) := by
    funext x
    unfold airyFredholmDerivativeWeight
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  rw [he]
  exact integrableOn_exp_neg_Ioi 0

theorem B_shiftDerivativeKernel_measurable
    (s : ℝ /- [definition] -/) : Measurable (Function.uncurry (B_shiftDerivativeKernel s)) := by
  apply positiveExtension_measurable
  exact (continuous_deriv_airyAiReal.comp ((continuous_fst.add continuous_snd).add continuous_const)).measurable

theorem hasDerivAt_B_fredholmKernel
    (s x y : ℝ /- [definition] -/) :
    HasDerivAt (fun t => B_fredholmKernel t x y) (B_shiftDerivativeKernel s x y) s := by
  unfold B_fredholmKernel B_shiftDerivativeKernel positiveExtension
  by_cases h : 0 ≤ x ∧ 0 ≤ y
  · simp only [if_pos h]
    simpa only [Function.comp_def,mul_one] using
      (hasDerivAt_airyAiReal (x + y + s)).differentiableAt.hasDerivAt.comp s
        ((hasDerivAt_id s).const_add (x + y))
  · simp only [if_neg h]
    exact hasDerivAt_const s 0

theorem airyFredholm_joint_derivative_bound
    (r : ℝ /- [definition] -/) :
    ∃ C : ℝ, 0 < C ∧ ∀ s : ℝ, r ≤ s → ∀ x y : ℝ,
      |B_fredholmKernel s x y| ≤ C * airyFredholmDerivativeWeight x * airyFredholmDerivativeWeight y ∧
      |B_shiftDerivativeKernel s x y| ≤ C * airyFredholmDerivativeWeight x * airyFredholmDerivativeWeight y := by
  obtain ⟨C₀,hC₀,hb₀⟩ := airyAiReal_abs_le_exp'
  obtain ⟨C₁,hC₁,hb₁⟩ := airy_deriv_halfline_exp_bound r
  let C := max (C₀ * Real.exp (-r)) (C₁ * Real.exp (-r / 2))
  refine ⟨C, (by dsimp [C]; positivity), ?_⟩
  intro s hs x y
  by_cases h : 0 ≤ x ∧ 0 ≤ y
  · have ht : r ≤ x + y + s := by linarith [h.1,h.2]
    have hbase : |airyAiReal (x + y + s)| ≤
        (C₀ * Real.exp (-r)) * airyFredholmDerivativeWeight x * airyFredholmDerivativeWeight y := by
      calc
        |airyAiReal (x + y + s)| ≤ C₀ * Real.exp (-(x + y + s)) := hb₀ _
        _ ≤ C₀ * Real.exp (-r + -x / 2 + -y / 2) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith [h.1,h.2])) hC₀.le
        _ = _ := by unfold airyFredholmDerivativeWeight; rw [Real.exp_add,Real.exp_add]; ring
    have hdiff : |deriv airyAiReal (x + y + s)| ≤
        (C₁ * Real.exp (-r / 2)) * airyFredholmDerivativeWeight x * airyFredholmDerivativeWeight y := by
      calc
        |deriv airyAiReal (x + y + s)| ≤ C₁ * Real.exp (-(x + y + s) / 2) := hb₁ _ ht
        _ ≤ C₁ * Real.exp (-r / 2 + -x / 2 + -y / 2) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith)) hC₁.le
        _ = _ := by unfold airyFredholmDerivativeWeight; rw [Real.exp_add,Real.exp_add]; ring
    simp only [B_fredholmKernel,B_shiftDerivativeKernel,positiveExtension,if_pos h]
    constructor
    · exact hbase.trans (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (le_max_left _ _) (by unfold airyFredholmDerivativeWeight; positivity))
        (by unfold airyFredholmDerivativeWeight; positivity))
    · exact hdiff.trans (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (le_max_right _ _) (by unfold airyFredholmDerivativeWeight; positivity))
        (by unfold airyFredholmDerivativeWeight; positivity))
  · simp only [B_fredholmKernel,B_shiftDerivativeKernel,positiveExtension,if_neg h,abs_zero]
    constructor <;> dsimp [C,airyFredholmDerivativeWeight] <;> positivity

noncomputable def airyFredholmCoefficientShiftDerivative
    (s : ℝ /- [definition] -/)
    (n : ℕ /- [definition] -/) : ℝ :=
  kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel s) (B_shiftDerivativeKernel s) n

theorem hasDerivAt_airyFredholmCoefficient
    (s : ℝ /- [definition] -/)
    (n : ℕ /- [definition] -/) :
    HasDerivAt (fun t => kernelCoefficient halfLineMeasure (B_fredholmKernel t) n)
      (airyFredholmCoefficientShiftDerivative s n) s := by
  obtain ⟨C,hC,hb⟩ := airyFredholm_joint_derivative_bound (s - 1)
  apply hasDerivAt_kernelCoefficient halfLineMeasure B_fredholmKernel B_shiftDerivativeKernel s
    (Ioi (s - 1)) (Ioi_mem_nhds (by linarith)) C airyFredholmDerivativeWeight hC.le
    (fun x => by unfold airyFredholmDerivativeWeight; positivity)
    airyFredholmDerivativeWeight_sq_integrable B_fredholmKernel_measurable B_shiftDerivativeKernel_measurable
    hasDerivAt_B_fredholmKernel
    (fun t ht x y => (hb t ht.le x y).1)
    (fun t ht x y => (hb t ht.le x y).2) n

theorem airyFredholmCoefficientShiftDerivative_local_bound
    (r : ℝ /- [definition] -/) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ s : ℝ, r ≤ s → ∀ n : ℕ,
      |airyFredholmCoefficientShiftDerivative s n| ≤ (n : ℝ) * hadamardMajorant M n := by
  obtain ⟨C,hC,hb⟩ := airyFredholm_joint_derivative_bound r
  refine ⟨C * ∫ x, airyFredholmDerivativeWeight x ^ 2 ∂halfLineMeasure, by positivity, ?_⟩
  intro s hs n
  exact kernelCoefficientDerivative_bound halfLineMeasure (B_fredholmKernel s) (B_shiftDerivativeKernel s)
    C airyFredholmDerivativeWeight hC.le (fun x => by unfold airyFredholmDerivativeWeight; positivity)
    airyFredholmDerivativeWeight_sq_integrable (fun x y => (hb s hs x y).1) (fun x y => (hb s hs x y).2) n

theorem B_fredholm_realSeries_absolute
    (s z : ℝ /- [definition] -/) :
    Summable (fun n => kernelCoefficient halfLineMeasure (B_fredholmKernel s) n * z ^ n) := by
  obtain ⟨C,hC,hb⟩ := B_fredholmKernel_bound_uniform s
  have h := kernelFredholm_absolute_of_minor_bound halfLineMeasure (B_fredholmKernel s)
    (fun x => Real.exp (-x)) C hC.le RMTFoundations.AiryBounds.integrable_exp_square
    (fun n x => weighted_kernel_minor_bound_pow n (B_fredholmKernel s) C (fun x => Real.exp (-x)) x
      hC.le (fun x => (Real.exp_pos _).le) (hb s le_rfl)) (z : ℂ)
  apply Summable.of_norm
  convert h using 1
  funext n
  simp only [← Complex.ofReal_pow, ← Complex.ofReal_mul, Complex.norm_real, Real.norm_eq_abs]

theorem hasDerivAt_B_realFredholmSeries
    (s z : ℝ /- [definition] -/) :
    HasDerivAt (fun t => ∑' n, kernelCoefficient halfLineMeasure (B_fredholmKernel t) n * z ^ n)
      (∑' n, airyFredholmCoefficientShiftDerivative s n * z ^ n) s := by
  obtain ⟨M,hM,hb⟩ := airyFredholmCoefficientShiftDerivative_local_bound (s - 1)
  apply hasDerivAt_real_kernelSeries _ airyFredholmCoefficientShiftDerivative
    (Ioi (s - 1)) isOpen_Ioi (convex_Ioi (s - 1)).isPreconnected s (by simp) M hM
    (fun n t _ => hasDerivAt_airyFredholmCoefficient t n)
    (fun n t ht => hb t ht.le n) z (B_fredholm_realSeries_absolute s z)

theorem TW1R_eq_realFredholmSeries
    (s : ℝ /- [definition] -/) :
    TW1R s = ∑' n, kernelCoefficient halfLineMeasure (B_fredholmKernel s) n * (-1 : ℝ) ^ n := by
  unfold TW1R TW1
  rw [← B_fredholm_physical s (-1)]
  rw [show (-1 : ℂ) = ((-1 : ℝ) : ℂ) by norm_num, kernelFredholm_real_coupling, Complex.ofReal_re]

theorem hasDerivAt_TW1R_series
    (s : ℝ /- [definition] -/) :
    HasDerivAt TW1R (∑' n, airyFredholmCoefficientShiftDerivative s n * (-1 : ℝ) ^ n) s := by
  have he : TW1R = fun t => ∑' n, kernelCoefficient halfLineMeasure (B_fredholmKernel t) n * (-1 : ℝ) ^ n :=
    funext TW1R_eq_realFredholmSeries
  rw [he]
  exact hasDerivAt_B_realFredholmSeries s (-1)

theorem differentiable_TW1R : Differentiable ℝ TW1R :=
  fun s => (hasDerivAt_TW1R_series s).differentiableAt

theorem hasDerivAt_airyHankel_realOperatorDet_series
    {ι : Type* /- [definition] -/ }
    [Countable ι /- [definition] -/ ]
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure) /- [definition] -/ )
    (s z : ℝ /- [definition] -/) :
    HasDerivAt (fun t => realOperatorDet b (airyHankelShift t) z)
      (∑' n, airyFredholmCoefficientShiftDerivative s n * z ^ n) s := by
  have he : (fun t => realOperatorDet b (airyHankelShift t) z) =
      fun t => ∑' n, kernelCoefficient halfLineMeasure (B_fredholmKernel t) n * z ^ n := by
    funext t
    have h := congrArg Complex.re (airyHankelFredholm_eq_realOperatorDet b t z)
    rw [← B_fredholm_physical t (z : ℂ),kernelFredholm_real_coupling,Complex.ofReal_re,Complex.ofReal_re] at h
    exact h.symm
  rw [he]
  exact hasDerivAt_B_realFredholmSeries s z

/-- Absolute convergence of the actual derivative series at every level and coupling. -/
theorem airyFredholmShiftDerivative_absolute
    (s z : ℝ /- [definition] -/) :
    Summable (fun n => ‖airyFredholmCoefficientShiftDerivative s n * z ^ n‖) := by
  obtain ⟨M,hM,hb⟩ := airyFredholmCoefficientShiftDerivative_local_bound s
  refine Summable.of_nonneg_of_le (fun n => norm_nonneg _) (fun n => ?_)
    (hadamardDerivative_summable (M * |z|) (by positivity))
  rw [Real.norm_eq_abs,abs_mul,abs_pow]
  calc
    |airyFredholmCoefficientShiftDerivative s n| * |z| ^ n ≤
      ((n : ℝ) * hadamardMajorant M n) * |z| ^ n :=
      mul_le_mul_of_nonneg_right (hb s le_rfl n) (by positivity)
    _ = (n : ℝ) * hadamardMajorant (M * |z|) n := by unfold hadamardMajorant; simp only [mul_pow]; ring

theorem TW1R_derivative_partial_sums_tendsto
    (s : ℝ /- [definition] -/) :
    Tendsto (fun N => ∑ n ∈ Finset.range N, airyFredholmCoefficientShiftDerivative s n * (-1 : ℝ) ^ n)
      atTop (𝓝 (deriv TW1R s)) := by
  rw [(hasDerivAt_TW1R_series s).deriv]
  exact (Summable.of_norm (airyFredholmShiftDerivative_absolute s (-1))).hasSum.tendsto_sum_nat

theorem hasDerivAt_airyOperatorTW1_series
    (s : ℝ /- [definition] -/) :
    HasDerivAt airyOperatorTW1 (∑' n, airyFredholmCoefficientShiftDerivative s n * (-1 : ℝ) ^ n) s := by
  have he : airyOperatorTW1 = TW1R := funext (fun t => (TW1R_eq_airyOperatorTW1 t).symm)
  rw [he]
  exact hasDerivAt_TW1R_series s

/-- Actual canonical basis, countability, bridge and differentiability at all real couplings. -/
theorem airy_operator_shift_derivative_joint_probe :
    ∃ b : HilbertBasis (canonicalIndex ℝ (Lp ℝ 2 halfLineMeasure)) ℝ (Lp ℝ 2 halfLineMeasure),
      Countable (canonicalIndex ℝ (Lp ℝ 2 halfLineMeasure)) ∧
      IsTraceClass (airyHankelShift 0) ∧ ‖shiftedUnitVector 0‖ = 1 ∧
      B_fredholmKernel 0 0 0 ≠ 0 ∧
      (∀ z : ℝ, kernelFredholm halfLineMeasure (fun x y => airyAiReal (x+y)) (z : ℂ) =
        (realOperatorDet b (airyHankelShift 0) z : ℂ)) ∧
      (∀ z : ℝ, HasDerivAt (fun t => realOperatorDet b (airyHankelShift t) z)
        (∑' n, airyFredholmCoefficientShiftDerivative 0 n * z ^ n) 0) := by
  let b := canonicalBasis ℝ (Lp ℝ 2 halfLineMeasure)
  letI := airyL2_basis_countable b
  refine ⟨b,inferInstance,isTraceClass_airyHankelShift 0,shiftedUnitVector_norm 0,?_,?_,
    hasDerivAt_airyHankel_realOperatorDet_series b 0⟩
  · simpa [B_fredholmKernel,positiveExtension] using airyAiReal_zero_pos.ne'
  · intro z
    simpa only [add_zero] using airyHankelFredholm_eq_realOperatorDet b 0 z


theorem finite_determinant_derivative_joint_probe :
    ∃ (M : ℝ → Matrix (Fin 2) (Fin 2) ℝ) (V : Matrix (Fin 2) (Fin 2) ℝ),
      (∀ i j, HasDerivAt (fun t => M t i j) (V i j) 0) ∧
      (∀ i j, |M 0 i j| ≤ 3 * (1 : ℝ) * 1) ∧
      (∀ i j, |V i j| ≤ 3 * (1 : ℝ) * 1) ∧
      (M 0).det = 3 ∧ finiteDetDerivative 2 (M 0) V = 4 ∧
      HasDerivAt (fun t => (M t).det) 4 0 := by
  classical
  let M : ℝ → Matrix (Fin 2) (Fin 2) ℝ := fun t => !![2 + t,1;1,2 + t]
  let V : Matrix (Fin 2) (Fin 2) ℝ := !![1,0;0,1]
  have hd : ∀ i j, HasDerivAt (fun t => M t i j) (V i j) 0 := by
    intro i j
    fin_cases i <;> fin_cases j
    · change HasDerivAt (fun t : ℝ => 2 + t) 1 0
      simpa using (hasDerivAt_id (0 : ℝ)).const_add 2
    · change HasDerivAt (fun _ : ℝ => 1) 0 0
      exact hasDerivAt_const 0 1
    · change HasDerivAt (fun _ : ℝ => 1) 0 0
      exact hasDerivAt_const 0 1
    · change HasDerivAt (fun t : ℝ => 2 + t) 1 0
      simpa using (hasDerivAt_id (0 : ℝ)).const_add 2
  have hD : finiteDetDerivative 2 (M 0) V = 4 := by
    norm_num [finiteDetDerivative,M,V,Fin.sum_univ_two,Matrix.det_fin_two,Matrix.updateCol_apply]
  refine ⟨M,V,hd,?_,?_,?_,hD,?_⟩
  · intro i j
    fin_cases i <;> fin_cases j <;> norm_num [M]
  · intro i j
    fin_cases i <;> fin_cases j <;> norm_num [V]
  · norm_num [M,Matrix.det_fin_two]
  · simpa only [hD] using hasDerivAt_matrix_det 2 M V 0 hd

/-- The generic integral hypotheses are jointly realized by the actual, nonzero Airy data. -/
theorem airy_shift_differentiation_all_binder_joint_probe :
    ∃ C : ℝ, 0 < C ∧
      (∀ x, 0 < airyFredholmDerivativeWeight x) ∧
      Integrable (fun x => airyFredholmDerivativeWeight x ^ 2) halfLineMeasure ∧
      (∀ t, Measurable (Function.uncurry (B_fredholmKernel t))) ∧
      (∀ t, Measurable (Function.uncurry (B_shiftDerivativeKernel t))) ∧
      (∀ t x y, HasDerivAt (fun r => B_fredholmKernel r x y) (B_shiftDerivativeKernel t x y) t) ∧
      (∀ t ∈ Ioi (-1 : ℝ), ∀ x y,
        |B_fredholmKernel t x y| ≤ C * airyFredholmDerivativeWeight x * airyFredholmDerivativeWeight y ∧
        |B_shiftDerivativeKernel t x y| ≤ C * airyFredholmDerivativeWeight x * airyFredholmDerivativeWeight y) ∧
      B_fredholmKernel 0 0 0 ≠ 0 ∧ B_shiftDerivativeKernel 0 0 0 ≠ 0 ∧
      (∀ n, HasDerivAt (fun t => kernelCoefficient halfLineMeasure (B_fredholmKernel t) n)
        (airyFredholmCoefficientShiftDerivative 0 n) 0) := by
  obtain ⟨C,hC,hb⟩ := airyFredholm_joint_derivative_bound (-1)
  refine ⟨C,hC,?_,airyFredholmDerivativeWeight_sq_integrable,B_fredholmKernel_measurable,
    B_shiftDerivativeKernel_measurable,hasDerivAt_B_fredholmKernel,
    (fun t ht x y => hb t ht.le x y),?_,?_,hasDerivAt_airyFredholmCoefficient 0⟩
  · intro x
    exact Real.exp_pos _
  · simpa [B_fredholmKernel,positiveExtension] using airyAiReal_zero_pos.ne'
  · simpa [B_shiftDerivativeKernel,positiveExtension] using deriv_airyAiReal_zero_neg.ne

/-- The series theorem's local region, all-term majorant, convergence and all couplings coexist. -/
theorem airy_series_differentiation_joint_probe :
    ∃ M : ℝ, 0 ≤ M ∧ IsOpen (Ioi (-1 : ℝ)) ∧ IsPreconnected (Ioi (-1 : ℝ)) ∧
      (0 : ℝ) ∈ Ioi (-1 : ℝ) ∧
      (∀ n t, t ∈ Ioi (-1 : ℝ) →
        HasDerivAt (fun r => kernelCoefficient halfLineMeasure (B_fredholmKernel r) n)
          (airyFredholmCoefficientShiftDerivative t n) t) ∧
      (∀ n t, t ∈ Ioi (-1 : ℝ) →
        |airyFredholmCoefficientShiftDerivative t n| ≤ (n : ℝ) * hadamardMajorant M n) ∧
      (∀ z : ℝ, Summable (fun n => kernelCoefficient halfLineMeasure (B_fredholmKernel 0) n * z ^ n)) ∧
      (∀ z : ℝ, HasDerivAt
        (fun t => ∑' n, kernelCoefficient halfLineMeasure (B_fredholmKernel t) n * z ^ n)
        (∑' n, airyFredholmCoefficientShiftDerivative 0 n * z ^ n) 0) ∧
      B_fredholmKernel 0 0 0 ≠ 0 := by
  obtain ⟨M,hM,hb⟩ := airyFredholmCoefficientShiftDerivative_local_bound (-1)
  refine ⟨M,hM,isOpen_Ioi,(convex_Ioi (-1 : ℝ)).isPreconnected,by norm_num,
    (fun n t _ => hasDerivAt_airyFredholmCoefficient t n),
    (fun n t ht => hb t ht.le n),B_fredholm_realSeries_absolute 0,
    hasDerivAt_B_realFredholmSeries 0,?_⟩
  simpa [B_fredholmKernel,positiveExtension] using airyAiReal_zero_pos.ne'



noncomputable def airyCoordinateDerivative
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    : ℝ := finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
      (coordinateDirection n (fun i j => deriv airyAiReal (x i+x j+s)) k)

noncomputable def airyMinorShiftDerivative
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    : ℝ := finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
      (fun i j => deriv airyAiReal (x i+x j+s))

theorem airyCoordinateDerivative_measurable
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : Measurable (airyCoordinateDerivative n s k) := by
  classical
  unfold airyCoordinateDerivative
  simp_rw [finiteDetDerivative_leibniz]
  apply Finset.measurable_sum
  intro σ _
  apply measurable_const.mul
  apply Finset.measurable_sum
  intro j _
  apply Measurable.mul
  · apply Finset.measurable_prod
    intro i _
    exact (Ai_continuous.comp (((continuous_apply (σ i)).add (continuous_apply i)).add continuous_const)).measurable
  · unfold coordinateDirection
    split_ifs <;> fun_prop

theorem airyCoordinateDerivative_integrable
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : Integrable (airyCoordinateDerivative n s k) (Measure.pi (fun _ => halfLineMeasure)) := by
  classical
  obtain ⟨C,hC,hb⟩ := airy_entry_pair_bound s
  have hi : Integrable (fun x : Fin n → ℝ => ∏ i, Real.exp (-x i / 2)^2)
      (Measure.pi (fun _ => halfLineMeasure)) :=
    Integrable.fintype_prod (fun _ => airyFredholmDerivativeWeight_sq_integrable)
  apply (hi.const_mul ((n:ℝ)*(Real.sqrt n*(2*C))^n)).mono'
    (airyCoordinateDerivative_measurable n s k).aestronglyMeasurable
  have hn : ∀ᵐ x ∂Measure.pi (fun _ : Fin n => halfLineMeasure), ∀ i, 0 ≤ x i :=
    eventually_all.2 (fun i => Measure.tendsto_eval_ae_ae.eventually
      ((ae_restrict_mem measurableSet_Ioi).mono (fun x hx => hx.le)))
  filter_upwards [hn] with x hx
  rw [Real.norm_eq_abs]
  apply finiteDetDerivative_bound n _ _ (2*C) _ (by positivity) (fun i => by positivity)
  · intro i j
    exact (hb _ _ (hx i) (hx j)).1.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (show C ≤ 2*C by linarith) (Real.exp_pos _).le) (Real.exp_pos _).le)
  · intro i j
    have he := (hb _ _ (hx i) (hx j)).2
    have hp : 0 ≤ C*Real.exp (-x i/2)*Real.exp (-x j/2) := by positivity
    unfold coordinateDirection
    calc
      _ ≤ |if i=k then deriv airyAiReal (x i+x j+s) else 0| +
          |if j=k then deriv airyAiReal (x i+x j+s) else 0| := abs_add_le _ _
      _ ≤ (2*C)*Real.exp (-x i/2)*Real.exp (-x j/2) := by
        split_ifs <;> (try simp only [abs_zero]) <;> nlinarith

theorem airyMinorShiftDerivative_integrable
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    : Integrable (airyMinorShiftDerivative n s) (Measure.pi (fun _ => halfLineMeasure)) := by
  classical
  have hi := integrable_finsetSum Finset.univ
    (fun k _ => airyCoordinateDerivative_integrable n s k)
  have he : (fun x => ∑ k : Fin n, airyCoordinateDerivative n s k x) =
      fun x => (2:ℝ)*airyMinorShiftDerivative n s x := by
    funext x
    exact airy_minor_coordinate_derivative_sum n x s
  rw [he] at hi
  exact (integrable_const_mul_iff (isUnit_iff_ne_zero.mpr (by norm_num : (2:ℝ) ≠ 0)) (airyMinorShiftDerivative n s)).mp hi

/-- Actual finite-product Fubini, retaining every coordinate and its genuine measure. -/
theorem integral_pi_coordinate
    (n : ℕ /- [definition] -/ )
    (f : (Fin (n+1) → ℝ) → ℝ /- [definition] -/ )
    (k : Fin (n+1)  /- [definition] -/ )
    (hf : Integrable f (Measure.pi (fun _ => halfLineMeasure))  /- [standing] -/ )
    : (∫ x, f x ∂Measure.pi (fun _ => halfLineMeasure)) =
      ∫ x : Fin n → ℝ, ∫ t, f (Fin.insertNth (α := fun _ => ℝ) k t x) ∂halfLineMeasure
        ∂Measure.pi (fun _ => halfLineMeasure) := by
  let e := (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n+1) => ℝ) k).symm
  have hp := (measurePreserving_piFinSuccAbove (fun _ : Fin (n+1) => halfLineMeasure) k).symm
  have hi := (hp.integrable_comp_emb e.measurableEmbedding).mpr hf
  rw [← hp.integral_comp' f]
  simpa only [e, MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv,
    Equiv.coe_fn_mk, Function.comp_def] using integral_prod_symm _ hi

theorem airyCoordinateDerivative_integral_boundary
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (k : Fin (n+1)  /- [definition] -/ )
    : (∫ x, airyCoordinateDerivative (n+1) s k x ∂Measure.pi (fun _ => halfLineMeasure)) =
      -(∫ x : Fin n → ℝ, kernelMinor (fun u v => airyAiReal (u+v+s)) (n+1)
        (Fin.insertNth (α := fun _ => ℝ) k 0 x) ∂Measure.pi (fun _ => halfLineMeasure)) := by
  classical
  rw [integral_pi_coordinate n _ k (airyCoordinateDerivative_integrable _ _ _), ← integral_neg]
  apply integral_congr_ae
  have hn : ∀ᵐ x ∂Measure.pi (fun _ : Fin n => halfLineMeasure), ∀ i, 0 ≤ x i :=
    eventually_all.2 (fun i => Measure.tendsto_eval_ae_ae.eventually
      ((ae_restrict_mem measurableSet_Ioi).mono (fun x hx => hx.le)))
  filter_upwards [hn] with x hx
  have hy : ∀ i, 0 ≤ Fin.insertNth (α := fun _ => ℝ) k (0:ℝ) x i := by
    intro i
    refine Fin.succAboveCases k ?_ ?_ i
    · simp
    · intro j; simpa using hx j
  have he (t : ℝ) : Function.update (Fin.insertNth (α := fun _ => ℝ) k (0:ℝ) x) k t = Fin.insertNth (α := fun _ => ℝ) k t x := by
    funext i
    refine Fin.succAboveCases k ?_ ?_ i
    · simp
    · intro j; simp
  simpa only [airyCoordinateDerivative,he] using
    airy_minor_coordinate_integral_boundary (n+1) (Fin.insertNth (α := fun _ => ℝ) k 0 x) hy s k

/-- All-order integrated factor-two identity, with all remaining-coordinate integrals discharged. -/
theorem airyMinorShiftDerivative_integral_boundary_sum
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    : (∫ x, airyMinorShiftDerivative (n+1) s x ∂Measure.pi (fun _ => halfLineMeasure)) =
      -(∑ k : Fin (n+1), ∫ x : Fin n → ℝ,
        kernelMinor (fun u v => airyAiReal (u+v+s)) (n+1) (Fin.insertNth (α := fun _ => ℝ) k 0 x)
        ∂Measure.pi (fun _ => halfLineMeasure)) / 2 := by
  classical
  have he : (fun x => ∑ k : Fin (n+1), airyCoordinateDerivative (n+1) s k x) =
      fun x => (2:ℝ)*airyMinorShiftDerivative (n+1) s x := by
    funext x
    exact airy_minor_coordinate_derivative_sum (n+1) x s
  have h := congrArg (fun f : (Fin (n+1) → ℝ) → ℝ => ∫ x, f x ∂Measure.pi (fun _ => halfLineMeasure)) he
  rw [integral_finsetSum _ (fun k _ => airyCoordinateDerivative_integrable _ _ _),integral_const_mul] at h
  simp_rw [airyCoordinateDerivative_integral_boundary] at h
  rw [Finset.sum_neg_distrib] at h
  linarith

theorem kernelMinor_permutation
    (n : ℕ /- [definition] -/ )
    (k : ℝ → ℝ → ℝ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (e : Equiv.Perm (Fin n)  /- [definition] -/ )
    : kernelMinor k n (x ∘ e) = kernelMinor k n x := by
  exact Matrix.det_submatrix_equiv_self e (fun i j => k (x i) (x j) : Matrix (Fin n) (Fin n) ℝ)

theorem airyCoordinateDerivative_permutation
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    (e : Equiv.Perm (Fin n)  /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : airyCoordinateDerivative n s k (x ∘ e) = airyCoordinateDerivative n s (e k) x := by
  classical
  have he (t : ℝ) : Function.update (x ∘ e) k t = (Function.update x (e k) t) ∘ e := by
    funext i
    by_cases h : i=k
    · subst i; simp
    · simp [Function.update_of_ne h, Function.comp_def, Function.update_of_ne (e.injective.ne h)]
  have hfun : (fun t => kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update (x ∘ e) k t)) =
      fun t => kernelMinor (fun u v => airyAiReal (u+v+s)) n (Function.update x (e k) t) := by
    funext t
    rw [he,kernelMinor_permutation]
  have h1 := hasDerivAt_airy_minor_coordinate n (x ∘ e) s k
  have h2 := hasDerivAt_airy_minor_coordinate n x s (e k)
  rw [hfun] at h1
  exact h1.unique h2

theorem airyCoordinateDerivative_integral_permutation
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    (e : Equiv.Perm (Fin n)  /- [definition] -/ )
    (k : Fin n /- [definition] -/ )
    : (∫ x, airyCoordinateDerivative n s k x ∂Measure.pi (fun _ => halfLineMeasure)) =
      ∫ x, airyCoordinateDerivative n s (e k) x ∂Measure.pi (fun _ => halfLineMeasure) := by
  have hp := measurePreserving_piCongrLeft (fun _ : Fin n => halfLineMeasure) e.symm
  have hi := hp.integral_comp' (airyCoordinateDerivative n s k)
  have he (x : Fin n → ℝ) : (MeasurableEquiv.piCongrLeft (fun _ : Fin n => ℝ) e.symm) x = x ∘ e := by
    funext i
    simp only [MeasurableEquiv.coe_piCongrLeft, Equiv.piCongrLeft_apply_eq_cast, Equiv.symm_symm, cast_eq, Function.comp_def]
  simp_rw [he] at hi
  exact hi.symm.trans (integral_congr_ae (ae_of_all _ (fun x => airyCoordinateDerivative_permutation n s x e k)))

/-- Permutation invariance discharges ALL coordinate sites, without assuming their equality. -/
theorem airyMinorShiftDerivative_integral_boundary
    (n : ℕ /- [definition] -/ )
    (s : ℝ /- [definition] -/ )
    : (∫ x, airyMinorShiftDerivative (n+1) s x ∂Measure.pi (fun _ => halfLineMeasure)) =
      -(n+1:ℝ)/2 * (∫ x : Fin n → ℝ,
        kernelMinor (fun u v => airyAiReal (u+v+s)) (n+1) (Fin.cons 0 x)
        ∂Measure.pi (fun _ => halfLineMeasure)) := by
  classical
  have he (k : Fin (n+1)) :
      (∫ x, airyCoordinateDerivative (n+1) s k x ∂Measure.pi (fun _ => halfLineMeasure)) =
      ∫ x, airyCoordinateDerivative (n+1) s 0 x ∂Measure.pi (fun _ => halfLineMeasure) := by
    simpa using airyCoordinateDerivative_integral_permutation (n+1) s (Equiv.swap k 0) k
  have hi : (∫ x, ∑ k : Fin (n+1), airyCoordinateDerivative (n+1) s k x
      ∂Measure.pi (fun _ => halfLineMeasure)) =
      (n+1:ℝ)*(∫ x, airyCoordinateDerivative (n+1) s 0 x ∂Measure.pi (fun _ => halfLineMeasure)) := by
    rw [integral_finsetSum _ (fun k _ => airyCoordinateDerivative_integrable _ _ _)]
    simp_rw [he]
    simp
  have hsum : (fun x => ∑ k : Fin (n+1), airyCoordinateDerivative (n+1) s k x) =
      fun x => (2:ℝ)*airyMinorShiftDerivative (n+1) s x := by
    funext x
    exact airy_minor_coordinate_derivative_sum (n+1) x s
  rw [hsum,integral_const_mul,airyCoordinateDerivative_integral_boundary] at hi
  simp only [Fin.insertNth_zero,cast_eq] at hi
  linarith

noncomputable def airyBoundaryFredholmCoefficient
    (s : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    : ℝ := (∫ x : Fin n → ℝ, kernelMinor (fun u v => airyAiReal (u+v+s)) (n+1)
      (Fin.cons 0 x) ∂Measure.pi (fun _ => halfLineMeasure)) / (n.factorial:ℝ)

theorem airyFredholmCoefficientShiftDerivative_physical
    (s : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    : airyFredholmCoefficientShiftDerivative s n =
      (∫ x, airyMinorShiftDerivative n s x ∂Measure.pi (fun _ => halfLineMeasure)) / (n.factorial:ℝ) := by
  unfold airyFredholmCoefficientShiftDerivative kernelCoefficientDerivative
  congr 1
  apply integral_congr_ae
  have hn : ∀ᵐ x ∂Measure.pi (fun _ : Fin n => halfLineMeasure), ∀ i, 0 ≤ x i :=
    eventually_all.2 (fun i => Measure.tendsto_eval_ae_ae.eventually
      ((ae_restrict_mem measurableSet_Ioi).mono (fun x hx => hx.le)))
  filter_upwards [hn] with x hx
  unfold kernelMinorDerivative airyMinorShiftDerivative
  congr 1
  · funext i j
    exact if_pos ⟨hx i,hx j⟩
  · funext i j
    exact if_pos ⟨hx i,hx j⟩

theorem airyFredholmCoefficientShiftDerivative_succ_boundary
    (s : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    : airyFredholmCoefficientShiftDerivative s (n+1) = -airyBoundaryFredholmCoefficient s n / 2 := by
  rw [airyFredholmCoefficientShiftDerivative_physical, airyMinorShiftDerivative_integral_boundary]
  unfold airyBoundaryFredholmCoefficient
  rw [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
  have hn : (n+1:ℝ) ≠ 0 := by positivity
  have hf : (n.factorial:ℝ) ≠ 0 := by positivity
  field_simp


theorem airyFredholmCoefficientShiftDerivative_zero
    (s : ℝ /- [definition] -/ )
    : airyFredholmCoefficientShiftDerivative s 0 = 0 := by
  simp [airyFredholmCoefficientShiftDerivative,kernelCoefficientDerivative,kernelMinorDerivative,
    finiteDetDerivative]

theorem airyBoundaryFredholmCoefficient_zero
    (s : ℝ /- [definition] -/ )
    : airyBoundaryFredholmCoefficient s 0 = airyAiReal s := by
  simp [airyBoundaryFredholmCoefficient,kernelMinor,measureReal_def,Measure.pi_empty_univ]

theorem airyBoundaryFredholmSeries_absolute
    (s : ℝ /- [definition] -/ )
    : Summable (fun n => ‖airyBoundaryFredholmCoefficient s n * (-1:ℝ)^n‖) := by
  have hi := (airyFredholmShiftDerivative_absolute s (-1)).comp_injective Nat.succ_injective
  have he : (fun n => ‖airyBoundaryFredholmCoefficient s n * (-1:ℝ)^n‖) =
      fun n => (2:ℝ)*‖airyFredholmCoefficientShiftDerivative s (n+1) * (-1:ℝ)^(n+1)‖ := by
    funext n
    rw [airyFredholmCoefficientShiftDerivative_succ_boundary]
    simp only [Real.norm_eq_abs,abs_mul,abs_div,abs_neg,abs_pow]
    norm_num
    ring
  rw [he]
  exact hi.mul_left 2

theorem TW1R_derivative_eq_boundaryFredholmSeries
    (s : ℝ /- [definition] -/ )
    : deriv TW1R s = (∑' n, airyBoundaryFredholmCoefficient s n * (-1:ℝ)^n) / 2 := by
  have hi := (airyFredholmShiftDerivative_absolute s (-1)).of_norm
  rw [(hasDerivAt_TW1R_series s).deriv, hi.tsum_eq_zero_add]
  rw [airyFredholmCoefficientShiftDerivative_zero]
  simp only [zero_mul,zero_add]
  calc
    _ = ∑' n, (airyBoundaryFredholmCoefficient s n * (-1:ℝ)^n)/2 := by
      apply tsum_congr
      intro n
      rw [airyFredholmCoefficientShiftDerivative_succ_boundary,pow_succ]
      ring
    _ = _ := tsum_div_const

theorem hasDerivAt_TW1R_boundaryFredholmSeries
    (s : ℝ /- [definition] -/ )
    : HasDerivAt TW1R ((∑' n, airyBoundaryFredholmCoefficient s n * (-1:ℝ)^n)/2) s := by
  rw [← TW1R_derivative_eq_boundaryFredholmSeries]
  exact (hasDerivAt_TW1R_series s).differentiableAt.hasDerivAt

theorem boundary_identification_iff_marked_series
    (s : ℝ /- [definition] -/ )
    : HasDerivAt TW1R (TW1R s * (airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)))/2) s ↔
      (∑' n, airyBoundaryFredholmCoefficient s n * (-1:ℝ)^n) =
        TW1R s * (airyAiReal s + inner ℝ (airyBoundaryVector s)
          (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) := by
  constructor
  · intro h
    have he := h.unique (hasDerivAt_TW1R_boundaryFredholmSeries s)
    linarith
  · intro h
    rw [← h]
    exact hasDerivAt_TW1R_boundaryFredholmSeries s

theorem coordinate_fubini_joint_probe :
    ∃ f : (Fin 2 → ℝ) → ℝ,
      Integrable f (Measure.pi (fun _ => halfLineMeasure)) ∧ f (fun _ => 0) ≠ 0 ∧
      (∫ x, f x ∂Measure.pi (fun _ => halfLineMeasure)) =
        ∫ x : Fin 1 → ℝ, ∫ t, f (Fin.insertNth 0 t x) ∂halfLineMeasure
          ∂Measure.pi (fun _ => halfLineMeasure) := by
  let f : (Fin 2 → ℝ) → ℝ := fun x => ∏ i, Real.exp (-x i)
  have hi : Integrable f (Measure.pi (fun _ => halfLineMeasure)) :=
    Integrable.fintype_prod (fun _ => integrableOn_exp_neg_Ioi 0)
  exact ⟨f,hi,by simp [f],integral_pi_coordinate 1 f 0 hi⟩

theorem airy_boundary_series_all_binder_joint_probe :
    airyBoundaryVector 0 ≠ 0 ∧ 0 < TW1R 0 ∧ TW1R 0 < 1 ∧
    airyBoundaryFredholmCoefficient 0 0 ≠ 0 ∧
    (∀ n, airyFredholmCoefficientShiftDerivative 0 (n+1) = -airyBoundaryFredholmCoefficient 0 n/2) ∧
    Summable (fun n => ‖airyBoundaryFredholmCoefficient 0 n * (-1:ℝ)^n‖) ∧
    HasDerivAt TW1R ((∑' n, airyBoundaryFredholmCoefficient 0 n * (-1:ℝ)^n)/2) 0 := by
  exact ⟨airyBoundaryVector_ne_zero 0,(TW1R_positive_bounds 0).1,TW1R_lt_one 0,
    by rw [airyBoundaryFredholmCoefficient_zero]; exact airyAiReal_zero_pos.ne',
    airyFredholmCoefficientShiftDerivative_succ_boundary 0,airyBoundaryFredholmSeries_absolute 0,
    hasDerivAt_TW1R_boundaryFredholmSeries 0⟩

theorem airyBoundaryFredholmSeries_all_couplings_absolute
    (s z : ℝ /- [definition] -/ )
    : Summable (fun n => ‖airyBoundaryFredholmCoefficient s n*z^n‖) := by
  classical
  by_cases hz : z=0
  · subst z
    apply summable_of_ne_finset_zero (s := {0})
    intro n hn
    have hn0 : n ≠ 0 := by simpa using hn
    simp [hn0]
  · have hi := (airyFredholmShiftDerivative_absolute s z).comp_injective Nat.succ_injective
    have he : (fun n => ‖airyBoundaryFredholmCoefficient s n*z^n‖) =
        fun n => (2/|z|)*‖airyFredholmCoefficientShiftDerivative s (n+1)*z^(n+1)‖ := by
      funext n
      rw [airyFredholmCoefficientShiftDerivative_succ_boundary]
      simp only [Real.norm_eq_abs,abs_mul,abs_div,abs_neg,abs_pow]
      norm_num
      rw [pow_succ]
      field_simp [abs_ne_zero.mpr hz]
    rw [he]
    exact hi.mul_left _

theorem airyShiftDerivative_series_eq_marked_series
    (s z : ℝ /- [definition] -/ )
    : (∑' n, airyFredholmCoefficientShiftDerivative s n*z^n) =
      -(z/2)*(∑' n, airyBoundaryFredholmCoefficient s n*z^n) := by
  have hi := (airyFredholmShiftDerivative_absolute s z).of_norm
  rw [hi.tsum_eq_zero_add,airyFredholmCoefficientShiftDerivative_zero]
  simp only [zero_mul,zero_add]
  calc
    _ = ∑' n, -(z/2)*(airyBoundaryFredholmCoefficient s n*z^n) := by
      apply tsum_congr
      intro n
      rw [airyFredholmCoefficientShiftDerivative_succ_boundary,pow_succ]
      ring
    _ = _ := tsum_mul_left

theorem hasDerivAt_airy_realOperatorDet_marked_series
    {ι : Type* /- [definition] -/ }
    [Countable ι /- [definition] -/ ]
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (s z : ℝ /- [definition] -/ )
    : HasDerivAt (fun t => realOperatorDet b (airyHankelShift t) z)
      (-(z/2)*(∑' n, airyBoundaryFredholmCoefficient s n*z^n)) s := by
  rw [← airyShiftDerivative_series_eq_marked_series]
  exact hasDerivAt_airyHankel_realOperatorDet_series b s z

theorem airy_marked_series_all_couplings_joint_probe :
    ∃ b : HilbertBasis (canonicalIndex ℝ (Lp ℝ 2 halfLineMeasure)) ℝ (Lp ℝ 2 halfLineMeasure),
      Countable (canonicalIndex ℝ (Lp ℝ 2 halfLineMeasure)) ∧ airyBoundaryVector 0 ≠ 0 ∧
      (∀ z : ℝ, Summable (fun n => ‖airyBoundaryFredholmCoefficient 0 n*z^n‖)) ∧
      (∀ z : ℝ, HasDerivAt (fun t => realOperatorDet b (airyHankelShift t) z)
        (-(z/2)*(∑' n, airyBoundaryFredholmCoefficient 0 n*z^n)) 0) := by
  let b := canonicalBasis ℝ (Lp ℝ 2 halfLineMeasure)
  letI := airyL2_basis_countable b
  exact ⟨b,inferInstance,airyBoundaryVector_ne_zero 0,
    airyBoundaryFredholmSeries_all_couplings_absolute 0,hasDerivAt_airy_realOperatorDet_marked_series b 0⟩
open scoped BigOperators

theorem finite_marked_rankOne_determinant
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    (hM : M.det ≠ 0 /- [standing] -/ )
    (t : ℝ /- [definition] -/ )
    : (M + Matrix.of (fun i j => t*u i*v j)).det = M.det * (1+t*(dotProduct v (Matrix.mulVec M⁻¹ u))) := by
  classical
  have he : (Matrix.of (fun i j => t*u i*v j)) =
      Matrix.replicateCol (Fin 1) (fun i => t*u i) * Matrix.replicateRow (Fin 1) v := by
    ext i j
    simp [Matrix.mul_apply]
  have h : (M + Matrix.replicateCol (Fin 1) (fun i => t*u i) * Matrix.replicateRow (Fin 1) v).det =
      M.det * (1 + Matrix.replicateRow (Fin 1) v * M⁻¹ * Matrix.replicateCol (Fin 1) (fun i => t*u i)).det :=
    Matrix.det_add_replicateCol_mul_replicateRow (ι := Fin 1) (A := M) (isUnit_iff_ne_zero.mpr hM) (fun i => t*u i) v
  rw [he,h,Matrix.det_fin_one]
  simp only [Matrix.add_apply,Matrix.one_apply_eq,Matrix.mul_apply,
    Matrix.replicateRow_apply,Matrix.replicateCol_apply,Matrix.mulVec,dotProduct]
  congr 2
  simp_rw [Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem finite_marked_rankOne_derivative
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    (hM : M.det ≠ 0 /- [standing] -/ )
    : HasDerivAt (fun t => (M + Matrix.of (fun i j => t*u i*v j)).det)
      (M.det*(dotProduct v (Matrix.mulVec M⁻¹ u))) 0 := by
  have he : (fun t => (M + Matrix.of (fun i j => t*u i*v j)).det) =
      fun t => M.det*(1+t*(dotProduct v (Matrix.mulVec M⁻¹ u))) :=
    funext (finite_marked_rankOne_determinant n M u v hM)
  rw [he]
  simpa using (((hasDerivAt_id (0:ℝ)).mul_const (dotProduct v (Matrix.mulVec M⁻¹ u))).const_add 1).const_mul M.det

theorem finite_marked_rankOne_joint_probe :
    ∃ (M : Matrix (Fin 2) (Fin 2) ℝ) (u v : Fin 2 → ℝ),
      M.det ≠ 0 ∧ u ≠ 0 ∧ v ≠ 0 ∧
      HasDerivAt (fun t => (M + Matrix.of (fun i j => t*u i*v j)).det)
        (M.det*(dotProduct v (Matrix.mulVec M⁻¹ u))) 0 := by
  let M : Matrix (Fin 2) (Fin 2) ℝ := !![2,0;0,3]
  let u : Fin 2 → ℝ := ![1,2]
  let v : Fin 2 → ℝ := ![3,4]
  have hM : M.det ≠ 0 := by norm_num [M,Matrix.det_fin_two]
  have hu : u ≠ 0 := by intro h; have he := congrFun h 0; norm_num [u] at he
  have hv : v ≠ 0 := by intro h; have he := congrFun h 0; norm_num [v] at he
  exact ⟨M,u,v,hM,hu,hv,finite_marked_rankOne_derivative 2 M u v hM⟩


noncomputable def airyRankOneKernel
    (s t x y : ℝ /- [definition] -/ )
    : ℝ := B_fredholmKernel s x y + t*B_fredholmKernel s x 0*B_fredholmKernel s 0 y

noncomputable def airyRankOneDirection
    (s x y : ℝ /- [definition] -/ )
    : ℝ := B_fredholmKernel s x 0*B_fredholmKernel s 0 y

theorem airyRankOneKernel_measurable
    (s t : ℝ /- [definition] -/ )
    : Measurable (Function.uncurry (airyRankOneKernel s t)) := by
  have h := B_fredholmKernel_measurable s
  exact h.add ((measurable_const.mul (h.comp (measurable_fst.prodMk measurable_const))).mul
    (h.comp (measurable_const.prodMk measurable_snd)))

theorem airyRankOneDirection_measurable
    (s : ℝ /- [definition] -/ )
    : Measurable (Function.uncurry (airyRankOneDirection s)) := by
  have h := B_fredholmKernel_measurable s
  exact (h.comp (measurable_fst.prodMk measurable_const)).mul
    (h.comp (measurable_const.prodMk measurable_snd))

theorem hasDerivAt_airyRankOneKernel
    (s t x y : ℝ /- [definition] -/ )
    : HasDerivAt (fun τ => airyRankOneKernel s τ x y) (airyRankOneDirection s x y) t := by
  simpa only [airyRankOneKernel,airyRankOneDirection,one_mul,id_eq] using
    (((hasDerivAt_id t).mul_const (B_fredholmKernel s x 0)).mul_const (B_fredholmKernel s 0 y)).const_add
      (B_fredholmKernel s x y)

theorem airyRankOneKernel_local_bounds
    (s : ℝ /- [definition] -/ )
    : ∃ C : ℝ, 0 < C ∧ ∀ t ∈ Ioo (-1:ℝ) 1, ∀ x y : ℝ,
      |airyRankOneKernel s t x y| ≤ C*Real.exp (-x)*Real.exp (-y) ∧
      |airyRankOneDirection s x y| ≤ C*Real.exp (-x)*Real.exp (-y) := by
  obtain ⟨C,hC,hb⟩ := B_fredholmKernel_bound_uniform s
  refine ⟨C+C^2,by positivity,?_⟩
  intro t ht x y
  have hd : |airyRankOneDirection s x y| ≤ C^2*Real.exp (-x)*Real.exp (-y) := by
    unfold airyRankOneDirection
    rw [abs_mul]
    have hx := hb s le_rfl x 0
    have hy := hb s le_rfl 0 y
    simp only [neg_zero,Real.exp_zero,mul_one] at hx hy
    calc
      _ ≤ (C*Real.exp (-x))*(C*Real.exp (-y)) := mul_le_mul hx hy (abs_nonneg _) (by positivity)
      _ = _ := by ring
  have he : C^2*Real.exp (-x)*Real.exp (-y) ≤ (C+C^2)*Real.exp (-x)*Real.exp (-y) := by
    apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
    apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
    linarith
  refine ⟨?_,hd.trans he⟩
  have ht' : |t| ≤ 1 := (abs_lt.mpr ht).le
  calc
    _ ≤ |B_fredholmKernel s x y| + |t| * |airyRankOneDirection s x y| := by
      simpa only [airyRankOneKernel,airyRankOneDirection,mul_assoc,abs_mul] using
        abs_add_le (B_fredholmKernel s x y) (t*(B_fredholmKernel s x 0*B_fredholmKernel s 0 y))
    _ ≤ C*Real.exp (-x)*Real.exp (-y) + C^2*Real.exp (-x)*Real.exp (-y) :=
      add_le_add (hb s le_rfl x y) ((mul_le_mul_of_nonneg_right ht' (abs_nonneg _)).trans (by simpa using hd))
    _ = _ := by ring

theorem hasDerivAt_airyRankOneCoefficient
    (s : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    : HasDerivAt (fun t => kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n)
      (kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel s) (airyRankOneDirection s) n) 0 := by
  obtain ⟨C,hC,hb⟩ := airyRankOneKernel_local_bounds s
  have he : airyRankOneKernel s 0 = B_fredholmKernel s := by funext x y; simp [airyRankOneKernel]
  rw [← he]
  apply hasDerivAt_kernelCoefficient halfLineMeasure (airyRankOneKernel s) (fun _ => airyRankOneDirection s)
    0 (Ioo (-1:ℝ) 1) (Ioo_mem_nhds (by norm_num) (by norm_num)) C (fun x => Real.exp (-x))
    hC.le (fun x => (Real.exp_pos _).le) RMTFoundations.AiryBounds.integrable_exp_square
    (airyRankOneKernel_measurable s) (fun _ => airyRankOneDirection_measurable s)
    (hasDerivAt_airyRankOneKernel s) (fun t ht x y => (hb t ht x y).1) (fun t ht x y => (hb t ht x y).2) n

theorem airyRankOneCoefficientDerivative_bound
    (s : ℝ /- [definition] -/ )
    : ∃ M : ℝ, 0 ≤ M ∧ ∀ n : ℕ,
      |kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel s) (airyRankOneDirection s) n| ≤
        (n:ℝ)*hadamardMajorant M n := by
  obtain ⟨C,hC,hb⟩ := airyRankOneKernel_local_bounds s
  refine ⟨C*(∫ x, Real.exp (-x)^2 ∂halfLineMeasure),by positivity,?_⟩
  intro n
  have hk (x y : ℝ) : |B_fredholmKernel s x y| ≤ C*Real.exp (-x)*Real.exp (-y) := by
    simpa [airyRankOneKernel] using (hb 0 (by norm_num) x y).1
  exact kernelCoefficientDerivative_bound halfLineMeasure (B_fredholmKernel s) (airyRankOneDirection s)
    C (fun x => Real.exp (-x)) hC.le (fun x => (Real.exp_pos _).le)
    RMTFoundations.AiryBounds.integrable_exp_square hk (fun x y => (hb 0 (by norm_num) x y).2) n

theorem airy_rankOne_kernel_joint_probe :
    B_fredholmKernel 0 0 0 ≠ 0 ∧ airyRankOneDirection 0 0 0 ≠ 0 ∧
    (∀ n, HasDerivAt (fun t => kernelCoefficient halfLineMeasure (airyRankOneKernel 0 t) n)
      (kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel 0) (airyRankOneDirection 0) n) 0) := by
  have h : B_fredholmKernel 0 0 0 ≠ 0 := by
    simpa [B_fredholmKernel,positiveExtension] using airyAiReal_zero_pos.ne'
  exact ⟨h,mul_ne_zero h h,hasDerivAt_airyRankOneCoefficient 0⟩

theorem airyRankOneKernel_physical
    (s t x y : ℝ /- [definition] -/ )
    (hx : 0 ≤ x /- [standing] -/ )
    (hy : 0 ≤ y /- [standing] -/ )
    : airyRankOneKernel s t x y = airyAiReal (x+y+s)+t*airyAiReal (x+s)*airyAiReal (y+s) := by
  simp [airyRankOneKernel,B_fredholmKernel,positiveExtension,hx,hy]

theorem hasDerivAt_airyRankOneCoefficient_local
    (s t : ℝ /- [definition] -/ )
    (ht : t ∈ Ioo (-1:ℝ) 1 /- [standing] -/ )
    (n : ℕ /- [definition] -/ )
    : HasDerivAt (fun τ => kernelCoefficient halfLineMeasure (airyRankOneKernel s τ) n)
      (kernelCoefficientDerivative halfLineMeasure (airyRankOneKernel s t) (airyRankOneDirection s) n) t := by
  obtain ⟨C,hC,hb⟩ := airyRankOneKernel_local_bounds s
  apply hasDerivAt_kernelCoefficient halfLineMeasure (airyRankOneKernel s) (fun _ => airyRankOneDirection s)
    t (Ioo (-1:ℝ) 1) (isOpen_Ioo.mem_nhds ht) C (fun x => Real.exp (-x))
    hC.le (fun x => (Real.exp_pos _).le) RMTFoundations.AiryBounds.integrable_exp_square
    (airyRankOneKernel_measurable s) (fun _ => airyRankOneDirection_measurable s)
    (hasDerivAt_airyRankOneKernel s) (fun τ hτ x y => (hb τ hτ x y).1) (fun τ hτ x y => (hb τ hτ x y).2) n

theorem hasDerivAt_airyRankOneKernel_series
    (s z : ℝ /- [definition] -/ )
    : HasDerivAt
      (fun t => ∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n*z^n)
      (∑' n, kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel s) (airyRankOneDirection s) n*z^n) 0 := by
  obtain ⟨C,hC,hb⟩ := airyRankOneKernel_local_bounds s
  let M := C*(∫ x, Real.exp (-x)^2 ∂halfLineMeasure)
  have hd (n : ℕ) (t : ℝ) (ht : t ∈ Ioo (-1:ℝ) 1) := hasDerivAt_airyRankOneCoefficient_local s t ht n
  have hbound (n : ℕ) (t : ℝ) (ht : t ∈ Ioo (-1:ℝ) 1) :
      |kernelCoefficientDerivative halfLineMeasure (airyRankOneKernel s t) (airyRankOneDirection s) n| ≤
        (n:ℝ)*hadamardMajorant M n :=
    kernelCoefficientDerivative_bound halfLineMeasure (airyRankOneKernel s t) (airyRankOneDirection s)
      C (fun x => Real.exp (-x)) hC.le (fun x => (Real.exp_pos _).le)
      RMTFoundations.AiryBounds.integrable_exp_square (fun x y => (hb t ht x y).1) (fun x y => (hb t ht x y).2) n
  have he : airyRankOneKernel s 0 = B_fredholmKernel s := by funext x y; simp [airyRankOneKernel]
  have hc : Summable (fun n => kernelCoefficient halfLineMeasure (airyRankOneKernel s 0) n*z^n) := by
    rw [he]
    exact B_fredholm_realSeries_absolute s z
  have h := hasDerivAt_real_kernelSeries
    (fun t n => kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n)
    (fun t n => kernelCoefficientDerivative halfLineMeasure (airyRankOneKernel s t) (airyRankOneDirection s) n)
    (Ioo (-1:ℝ) 1) isOpen_Ioo (convex_Ioo (-1:ℝ) 1).isPreconnected
    0 (by norm_num) M (by dsimp [M]; positivity) hd hbound z hc
  simpa only [he] using h

theorem airyRankOne_series_all_binder_joint_probe :
    airyRankOneDirection 0 0 0 ≠ 0 ∧
    (∀ z : ℝ, HasDerivAt
      (fun t => ∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel 0 t) n*z^n)
      (∑' n, kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel 0) (airyRankOneDirection 0) n*z^n) 0) ∧
    airyRankOneKernel 0 0 0 0 = airyAiReal 0 := by
  exact ⟨(airy_rankOne_kernel_joint_probe).2.1,hasDerivAt_airyRankOneKernel_series 0,
    by simp [airyRankOneKernel_physical 0 0 0 0 le_rfl le_rfl]⟩

noncomputable def markedBorder
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (a : ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    : Matrix (Fin 1 ⊕ Fin n) (Fin 1 ⊕ Fin n) ℝ :=
  Matrix.fromBlocks (fun _ _ => a) (Matrix.replicateRow (Fin 1) v)
    (Matrix.replicateCol (Fin 1) u) M

theorem markedBorder_updateRow
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (a : ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    : (markedBorder n M 0 u 0).updateRow (Sum.inl 0) (Sum.elim (fun _ => a) v) =
      markedBorder n M a u v := by
  classical
  ext i j
  rcases i with i | i
  · have hi : i = 0 := Subsingleton.elim _ _
    subst i
    rcases j with j | j <;> simp [markedBorder,Matrix.updateRow_self]
  · rcases j with j | j <;> simp [markedBorder,Matrix.updateRow_ne]

theorem markedBorder_affine
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (a : ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    : (markedBorder n M a u v).det = a*M.det + (markedBorder n M 0 u v).det := by
  classical
  let B := markedBorder n M 0 u 0
  let w : Fin 1 ⊕ Fin n → ℝ := Sum.elim (fun _ => 1) (fun _ => 0)
  let q : Fin 1 ⊕ Fin n → ℝ := Sum.elim (fun _ => 0) v
  have he : Sum.elim (fun _ : Fin 1 => a) v = a • w + q := by
    funext i
    rcases i with i | i <;> simp [w,q]
  rw [← markedBorder_updateRow n M a u v,he,Matrix.det_updateRow_add,Matrix.det_updateRow_smul]
  have hw : w = Sum.elim (fun _ : Fin 1 => (1:ℝ)) (0 : Fin n → ℝ) := rfl
  rw [hw,markedBorder_updateRow,markedBorder_updateRow]
  have htri : (markedBorder n M 1 u 0).det = M.det := by
    have hz : Matrix.replicateRow (Fin 1) (0 : Fin n → ℝ) = 0 := rfl
    rw [markedBorder,hz,Matrix.det_fromBlocks_zero₁₂,Matrix.det_fin_one]
    simp
  rw [htri]

theorem markedBorder_rankOne
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    (t : ℝ /- [definition] -/ )
    : (M + Matrix.of (fun i j => t*u i*v j)).det =
      M.det - t*(markedBorder n M 0 u v).det := by
  classical
  have hblock := Matrix.det_fromBlocks_one₁₁
    (Matrix.replicateRow (Fin 1) (fun j => -t*v j)) (Matrix.replicateCol (Fin 1) u) M
  have hM : M - Matrix.replicateCol (Fin 1) u * Matrix.replicateRow (Fin 1) (fun j => -t*v j) =
      M + Matrix.of (fun i j => t*u i*v j) := by
    ext i j
    simp [Matrix.mul_apply]
    ring
  have hleft : Matrix.fromBlocks (1 : Matrix (Fin 1) (Fin 1) ℝ)
      (Matrix.replicateRow (Fin 1) (fun j => -t*v j)) (Matrix.replicateCol (Fin 1) u) M =
      markedBorder n M 1 u (fun j => -t*v j) := by
    ext i j
    rcases i with i | i <;> rcases j with j | j
    · simp [markedBorder,Subsingleton.elim i j]
    · rfl
    · rfl
    · rfl
  rw [hleft,hM] at hblock
  rw [← hblock,markedBorder_affine]
  have hv : Sum.elim (fun _ : Fin 1 => (0:ℝ)) (fun j => -t*v j) =
      (-t) • Sum.elim (fun _ : Fin 1 => (0:ℝ)) v := by
    funext i
    rcases i with i | i <;> simp
  rw [← markedBorder_updateRow n M 0 u (fun j => -t*v j),hv,
    Matrix.det_updateRow_smul,markedBorder_updateRow]
  ring

theorem markedBorder_eq_finiteDetDerivative
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (a : ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    : (markedBorder n M a u v).det = a*M.det -
      finiteDetDerivative n M (Matrix.of (fun i j => u i*v j)) := by
  have h1 : HasDerivAt (fun t => (M + Matrix.of (fun i j => t*u i*v j)).det)
      (-(markedBorder n M 0 u v).det) 0 := by
    have he := funext (markedBorder_rankOne n M u v)
    rw [he]
    simpa using (hasDerivAt_const (0:ℝ) M.det).fun_sub
      ((hasDerivAt_id (0:ℝ)).mul_const (markedBorder n M 0 u v).det)
  have h2 := hasDerivAt_matrix_det n (fun t => M + Matrix.of (fun i j => t*u i*v j))
    (Matrix.of (fun i j => u i*v j)) 0 (fun i j => by
      simpa using (((hasDerivAt_id (0:ℝ)).mul_const (u i)).mul_const (v j)).const_add (M i j))
  have he : (M + Matrix.of (fun i j => (0:ℝ)*u i*v j)) = M := by ext i j; simp
  rw [he] at h2
  rw [markedBorder_affine]
  linarith [h1.unique h2]

theorem finiteDetDerivative_rankOne_adjugate
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    : finiteDetDerivative n M (Matrix.of (fun i j => u i*v j)) =
      dotProduct v (M.adjugate.mulVec u) := by
  classical
  unfold finiteDetDerivative
  rw [← Matrix.cramer_eq_adjugate_mulVec]
  apply Finset.sum_congr rfl
  intro j hj
  have he : (fun i => Matrix.of (fun i j => u i*v j) i j) = v j • u := by
    funext i
    simp [mul_comm]
  rw [he,Matrix.det_updateCol_smul,Matrix.cramer_apply]

theorem markedBorder_adjugate
    (n : ℕ /- [definition] -/ )
    (M : Matrix (Fin n) (Fin n) ℝ /- [definition] -/ )
    (a : ℝ /- [definition] -/ )
    (u v : Fin n → ℝ /- [definition] -/ )
    : (markedBorder n M a u v).det = a*M.det - dotProduct v (M.adjugate.mulVec u) := by
  rw [markedBorder_eq_finiteDetDerivative,finiteDetDerivative_rankOne_adjugate]

theorem markedBorder_singular_joint_probe :
    ∃ (M : Matrix (Fin 2) (Fin 2) ℝ) (u v : Fin 2 → ℝ),
      M ≠ 0 ∧ M.det = 0 ∧ u ≠ 0 ∧ v ≠ 0 ∧
      (markedBorder 2 M 1 u v).det ≠ 0 ∧
      (markedBorder 2 M 1 u v).det = M.det - dotProduct v (M.adjugate.mulVec u) := by
  let M : Matrix (Fin 2) (Fin 2) ℝ := !![1,0;0,0]
  let u : Fin 2 → ℝ := ![0,1]
  let v : Fin 2 → ℝ := ![0,1]
  have hn : M ≠ 0 := by intro h; have he := congrFun (congrFun h 0) 0; norm_num [M] at he
  have hu : u ≠ 0 := by intro h; have he := congrFun h 1; norm_num [u] at he
  have hv : v ≠ 0 := hu
  have hd : M.det = 0 := by norm_num [M,Matrix.det_fin_two]
  have hb : (markedBorder 2 M 1 u v).det = -1 := by
    rw [markedBorder_adjugate]
    norm_num [M,u,v,Matrix.det_fin_two,Matrix.adjugate_fin_two,dotProduct,Matrix.mulVec,Fin.sum_univ_two]
  exact ⟨M,u,v,hn,hd,hu,hv,by rw [hb]; norm_num,by simpa using markedBorder_adjugate 2 M 1 u v⟩
noncomputable def markedBorderIndexEquiv
    (n : ℕ /- [definition] -/ )
    : Fin 1 ⊕ Fin n ≃ Fin (n+1) where
  toFun := Sum.elim (fun _ => 0) Fin.succ
  invFun := Fin.cases (Sum.inl 0) Sum.inr
  left_inv := by
    intro i
    rcases i with i | i
    · have hi : i = 0 := Subsingleton.elim _ _
      subst i
      simp
    · simp
  right_inv := by
    intro i
    induction i using Fin.cases with
    | zero => rfl
    | succ i => rfl

theorem airy_boundary_minor_eq_rankOneDerivative
    (s : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    (x : Fin n → ℝ /- [definition] -/ )
    : kernelMinor (fun u v => airyAiReal (u+v+s)) (n+1) (Fin.cons 0 x) =
      airyAiReal s * kernelMinor (fun u v => airyAiReal (u+v+s)) n x -
        finiteDetDerivative n (fun i j => airyAiReal (x i+x j+s))
          (fun i j => airyAiReal (x i+s)*airyAiReal (x j+s)) := by
  classical
  let M : Matrix (Fin n) (Fin n) ℝ := fun i j => airyAiReal (x i+x j+s)
  let g : Fin n → ℝ := fun i => airyAiReal (x i+s)
  let K : Matrix (Fin (n+1)) (Fin (n+1)) ℝ :=
    fun i j => airyAiReal (Fin.cons (α := fun _ : Fin (n+1) => ℝ) 0 x i+Fin.cons (α := fun _ : Fin (n+1) => ℝ) 0 x j+s)
  have he : K.submatrix (markedBorderIndexEquiv n) (markedBorderIndexEquiv n) =
      markedBorder n M (airyAiReal s) g g := by
    ext i j
    rcases i with i | i <;> rcases j with j | j <;>
      simp [K,markedBorderIndexEquiv,markedBorder,M,g,add_comm]
  have hdet := Matrix.det_submatrix_equiv_self (markedBorderIndexEquiv n) K
  rw [he,markedBorder_eq_finiteDetDerivative] at hdet
  exact hdet.symm

theorem airyRankOne_minorDerivative_integrable
    (s : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    : Integrable (kernelMinorDerivative (B_fredholmKernel s) (airyRankOneDirection s) n)
        (Measure.pi (fun _ => halfLineMeasure)) := by
  obtain ⟨C,hC,hb⟩ := airyRankOneKernel_local_bounds s
  have hk (x y : ℝ) : |B_fredholmKernel s x y| ≤ C*Real.exp (-x)*Real.exp (-y) := by
    simpa [airyRankOneKernel] using (hb 0 (by norm_num) x y).1
  have hi : Integrable (fun x : Fin n → ℝ => ∏ i, Real.exp (-x i)^2)
      (Measure.pi (fun _ => halfLineMeasure)) := Integrable.fintype_prod (fun _ => integrable_exp_square)
  apply (hi.const_mul ((n:ℝ)*(Real.sqrt n*C)^n)).mono'
    (kernelMinorDerivative_measurable (B_fredholmKernel s) (airyRankOneDirection s)
      (B_fredholmKernel_measurable s) (airyRankOneDirection_measurable s) n).aestronglyMeasurable
  apply Eventually.of_forall
  intro x
  simpa only [Real.norm_eq_abs,mul_assoc] using
    kernelMinorDerivative_bound (B_fredholmKernel s) (airyRankOneDirection s) C (fun x => Real.exp (-x))
      hC.le (fun x => (Real.exp_pos _).le) hk (fun x y => (hb 0 (by norm_num) x y).2) n x

theorem airyBoundaryFredholmCoefficient_rankOne
    (s : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    : airyBoundaryFredholmCoefficient s n =
      airyAiReal s*kernelCoefficient halfLineMeasure (B_fredholmKernel s) n -
        kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel s) (airyRankOneDirection s) n := by
  have hp : ∀ᵐ x ∂Measure.pi (fun _ : Fin n => halfLineMeasure), ∀ i, 0 < x i :=
    eventually_all.2 (fun i => Measure.tendsto_eval_ae_ae.eventually (ae_restrict_mem measurableSet_Ioi))
  have he : (fun x : Fin n → ℝ => kernelMinor (fun u v => airyAiReal (u+v+s)) (n+1) (Fin.cons 0 x)) =ᵐ[
      Measure.pi (fun _ => halfLineMeasure)]
      (fun x => airyAiReal s*kernelMinor (B_fredholmKernel s) n x -
        kernelMinorDerivative (B_fredholmKernel s) (airyRankOneDirection s) n x) := by
    filter_upwards [hp] with x hx
    rw [airy_boundary_minor_eq_rankOneDerivative]
    have hk : (fun i j : Fin n => B_fredholmKernel s (x i) (x j)) =
        fun i j => airyAiReal (x i+x j+s) := by
      funext i j
      simp [B_fredholmKernel,positiveExtension,(hx i).le,(hx j).le]
    have hd : (fun i j : Fin n => airyRankOneDirection s (x i) (x j)) =
        fun i j => airyAiReal (x i+s)*airyAiReal (x j+s) := by
      funext i j
      simp [airyRankOneDirection,B_fredholmKernel,positiveExtension,(hx i).le,(hx j).le]
    simp only [kernelMinor,kernelMinorDerivative,hk,hd]
  have hk : Integrable (kernelMinor (B_fredholmKernel s) n) (Measure.pi (fun _ => halfLineMeasure)) := by
    have hc := kernelMinor_congr_on_full_measure halfLineMeasure (B_fredholmKernel s)
      (fun u v => airyAiReal (u+v+s)) (Ioi 0) (ae_restrict_mem measurableSet_Ioi)
      (fun u hu v hv => if_pos ⟨hu.le,hv.le⟩) n
    exact (B_physical_minor_integrable s n).congr hc.symm
  unfold airyBoundaryFredholmCoefficient kernelCoefficient kernelCoefficientDerivative
  rw [integral_congr_ae he,integral_sub (hk.const_mul _) (airyRankOne_minorDerivative_integrable s n),integral_const_mul]
  ring

theorem airyBoundaryFredholmSeries_rankOne
    (s z : ℝ /- [definition] -/ )
    : (∑' n, airyBoundaryFredholmCoefficient s n*z^n) =
      airyAiReal s*(∑' n, kernelCoefficient halfLineMeasure (B_fredholmKernel s) n*z^n) -
        (∑' n, kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel s) (airyRankOneDirection s) n*z^n) := by
  have hk := B_fredholm_realSeries_absolute s z
  have hb := (airyBoundaryFredholmSeries_all_couplings_absolute s z).of_norm
  have hd : Summable (fun n => kernelCoefficientDerivative halfLineMeasure
      (B_fredholmKernel s) (airyRankOneDirection s) n*z^n) := by
    have hi := (hk.mul_left (airyAiReal s)).sub hb
    apply hi.congr
    intro n
    rw [airyBoundaryFredholmCoefficient_rankOne]
    ring
  simp_rw [airyBoundaryFredholmCoefficient_rankOne,sub_mul,mul_assoc]
  rw [Summable.tsum_sub (hk.mul_left (airyAiReal s)) hd,tsum_mul_left]

theorem airyBoundaryFredholmSeries_eq_rankOne_deriv
    (s : ℝ /- [definition] -/ )
    : (∑' n, airyBoundaryFredholmCoefficient s n*(-1:ℝ)^n) =
      airyAiReal s*TW1R s - deriv
        (fun t => ∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n*(-1:ℝ)^n) 0 := by
  rw [airyBoundaryFredholmSeries_rankOne,(hasDerivAt_airyRankOneKernel_series s (-1)).deriv,
    ← TW1R_eq_realFredholmSeries]

theorem airyBoundary_rankOne_all_binder_joint_probe :
    airyBoundaryVector 0 ≠ 0 ∧
    (∀ n, airyBoundaryFredholmCoefficient 0 n =
      airyAiReal 0*kernelCoefficient halfLineMeasure (B_fredholmKernel 0) n -
        kernelCoefficientDerivative halfLineMeasure (B_fredholmKernel 0) (airyRankOneDirection 0) n) ∧
    (∑' n, airyBoundaryFredholmCoefficient 0 n*(-1:ℝ)^n) =
      airyAiReal 0*TW1R 0 - deriv
        (fun t => ∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel 0 t) n*(-1:ℝ)^n) 0 := by
  exact ⟨airyBoundaryVector_ne_zero 0,airyBoundaryFredholmCoefficient_rankOne 0,
    airyBoundaryFredholmSeries_eq_rankOne_deriv 0⟩
noncomputable def airyMarkedFactor
    (s t : ℝ /- [definition] -/ )
    : (Lp ℝ 2 halfLineMeasure) →L[ℝ] (Lp ℝ 2 halfLineMeasure) :=
  airyDerivativeFactor s + t • rankOne ℝ
    (sliceLp halfLineMeasure (airyDerivativeFactorKernel s) 0) (airyBoundaryVector s)

noncomputable def airyMarkedFactorRow
    (s t x : ℝ /- [definition] -/ )
    : Lp ℝ 2 halfLineMeasure :=
  sliceLp halfLineMeasure (airyDerivativeFactorKernel s) x +
    (t*airyAiReal (x+s)) • sliceLp halfLineMeasure (airyDerivativeFactorKernel s) 0

theorem airyMarkedFactor_isHilbertSchmidt
    (s t : ℝ /- [definition] -/ )
    : IsHilbertSchmidt (airyMarkedFactor s t) := by
  have h := (isHilbertSchmidt_kernelOperator (memLp_airyDerivativeFactorKernel s)).sub
    (isHilbertSchmidt_rankOne (𝕜 := ℝ)
      (sliceLp halfLineMeasure (airyDerivativeFactorKernel s) 0) ((-t) • airyBoundaryVector s))
  convert h using 1
  apply ContinuousLinearMap.ext
  intro f
  simp [airyMarkedFactor,airyDerivativeFactor,rankOne_apply,smul_smul,sub_eq_add_neg,mul_comm]

theorem airyMarkedFactor_comp
    (s t : ℝ /- [definition] -/ )
    : airyMarkedFactor s t ∘L airyVolterraFactor.adjoint =
      airyHankelShift s + t • rankOne ℝ (airyBoundaryVector s) (airyBoundaryVector s) := by
  apply ContinuousLinearMap.ext
  intro f
  have he := airyVolterraFactor_derivative_row s 0 le_rfl
  change airyVolterraFactor (sliceLp halfLineMeasure (airyDerivativeFactorKernel s) 0) = airyBoundaryVector s at he
  simp only [airyMarkedFactor,ContinuousLinearMap.comp_apply,ContinuousLinearMap.add_apply,
    ContinuousLinearMap.smul_apply,rankOne_apply]
  rw [airyVolterraFactor.adjoint_inner_right,he]
  rw [airyHankelShift_eq_derivative_volterra]
  rfl

theorem airyMarkedFactor_eval_inner
    (s t : ℝ /- [definition] -/ )
    (f : Lp ℝ 2 halfLineMeasure /- [definition] -/ )
    : ∀ᵐ x ∂halfLineMeasure, (airyMarkedFactor s t f) x = inner ℝ (airyMarkedFactorRow s t x) f := by
  let r0 := sliceLp halfLineMeasure (airyDerivativeFactorKernel s) 0
  let g := airyBoundaryVector s
  have he : airyMarkedFactor s t f = airyDerivativeFactor s f + (t*inner ℝ r0 f) • g := by
    simp [airyMarkedFactor,r0,g,rankOne_apply,smul_smul]
  rw [he]
  filter_upwards [Lp.coeFn_add (airyDerivativeFactor s f) ((t*inner ℝ r0 f) • g),
    Lp.coeFn_smul (t*inner ℝ r0 f) g,
    kernelOperator_eval_inner_ae (memLp_airyDerivativeFactorKernel s) f,
    airyBoundaryVector_apply_ae s] with x hadd hsmul hA hg
  change (airyDerivativeFactor s f + (t*inner ℝ r0 f) • g) x = _
  rw [hadd]
  simp only [Pi.add_apply]
  rw [hsmul]
  simp only [Pi.smul_apply,smul_eq_mul]
  change (airyDerivativeFactor s f) x + (t*inner ℝ r0 f)*g x = _
  change (airyDerivativeFactor s f) x = inner ℝ (sliceLp halfLineMeasure (airyDerivativeFactorKernel s) x) f at hA
  change g x = airyAiReal (s+x) at hg
  rw [hA,hg]
  simp only [airyMarkedFactorRow,inner_add_left,real_inner_smul_left]
  change _ = _ + (t*airyAiReal (x+s))*inner ℝ r0 f
  rw [add_comm s x]
  ring

theorem airyMarkedFactorRow_memLp
    {ι : Type* /- [definition] -/ }
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (s t : ℝ /- [definition] -/ )
    : MemLp (airyMarkedFactorRow s t) 2 halfLineMeasure := by
  letI := airyL2_basis_countable b
  exact l2_operator_rows_memLp halfLineMeasure b (airyMarkedFactor s t)
    (summable_norm_sq_apply_basis (airyMarkedFactor_isHilbertSchmidt s t) b)
    (airyMarkedFactorRow s t) (airyMarkedFactor_eval_inner s t)

theorem airyVolterraRow_memLp
    {ι : Type* /- [definition] -/ }
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    : MemLp (sliceLp halfLineMeasure airyVolterraFactorKernel) 2 halfLineMeasure := by
  letI := airyL2_basis_countable b
  exact l2_operator_rows_memLp halfLineMeasure b airyVolterraFactor
    (summable_norm_sq_apply_basis (isHilbertSchmidt_kernelOperator memLp_airyVolterraFactorKernel) b)
    (sliceLp halfLineMeasure airyVolterraFactorKernel)
    (kernelOperator_eval_inner_ae memLp_airyVolterraFactorKernel)

theorem airyFactorRow_inner
    (s x y : ℝ /- [definition] -/ )
    (hx : 0 ≤ x /- [standing] -/ )
    (hy : 0 ≤ y /- [standing] -/ )
    : inner ℝ (sliceLp halfLineMeasure (airyDerivativeFactorKernel s) x)
        (sliceLp halfLineMeasure airyVolterraFactorKernel y) = airyAiReal (x+y+s) := by
  rw [L2.inner_def]
  have he : (∫ z, inner ℝ ((sliceLp halfLineMeasure (airyDerivativeFactorKernel s) x) z)
      ((sliceLp halfLineMeasure airyVolterraFactorKernel y) z) ∂halfLineMeasure) =
      ∫ z, airyDerivativeFactorKernel s (x,z)*airyVolterraFactorKernel (y,z) ∂halfLineMeasure := by
    apply integral_congr_ae
    filter_upwards [sliceLp_apply_ae (memLp_airyDerivativeFactorRow s x),
      sliceLp_apply_ae (memLp_airyVolterraFactorRow y)] with z hr hc
    simp [hr,hc,RCLike.inner_apply,mul_comm]
  rw [he,airyDerivative_volterra_convolution s x y hx hy]

theorem airyMarkedFactorRow_inner
    (s t x y : ℝ /- [definition] -/ )
    (hx : 0 ≤ x /- [standing] -/ )
    (hy : 0 ≤ y /- [standing] -/ )
    : inner ℝ (airyMarkedFactorRow s t x) (sliceLp halfLineMeasure airyVolterraFactorKernel y) =
      airyRankOneKernel s t x y := by
  simp only [airyMarkedFactorRow,inner_add_left,real_inner_smul_left]
  rw [airyFactorRow_inner s x y hx hy,airyFactorRow_inner s 0 y le_rfl hy,
    airyRankOneKernel_physical s t x y hx hy]
  ring

theorem airyRankOneKernel_eq_realOperatorDet
    {ι : Type* /- [definition] -/ }
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (s t z : ℝ /- [definition] -/ )
    : (∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n*z^n) =
      realOperatorDet b (airyHankelShift s + t • rankOne ℝ (airyBoundaryVector s) (airyBoundaryVector s)) z := by
  letI := airyL2_basis_countable b
  have hA := summable_norm_sq_apply_basis (airyMarkedFactor_isHilbertSchmidt s t) b
  have hB := summable_norm_sq_apply_basis (isHilbertSchmidt_kernelOperator memLp_airyVolterraFactorKernel).adjoint b
  have hr := airyMarkedFactorRow_memLp b s t
  have hc := airyVolterraRow_memLp b
  have hevalB (f : Lp ℝ 2 halfLineMeasure) : ∀ᵐ x ∂halfLineMeasure,
      (airyVolterraFactor.adjoint.adjoint f) x = inner ℝ (sliceLp halfLineMeasure airyVolterraFactorKernel x) f := by
    rw [ContinuousLinearMap.adjoint_adjoint]
    exact kernelOperator_eval_inner_ae memLp_airyVolterraFactorKernel f
  have h := kernelIntegralSeries_eq_gram halfLineMeasure (airyMarkedFactorRow s t)
    (sliceLp halfLineMeasure airyVolterraFactorKernel) hr hc (airyRankOneKernel s t)
    (Ioi 0) (ae_restrict_mem measurableSet_Ioi)
    (fun x hx y hy => (airyMarkedFactorRow_inner s t x y hx.le hy.le).symm) z
  rw [kernelFredholmSeries_eq_realOperatorDet_comp halfLineMeasure b
    (airyMarkedFactor s t) airyVolterraFactor.adjoint hA hB (airyMarkedFactorRow s t)
    (sliceLp halfLineMeasure airyVolterraFactorKernel) hr hc (airyMarkedFactor_eval_inner s t)
    hevalB,airyMarkedFactor_comp] at h
  have hs := (kernelFredholmSeries_absolute (𝕜 := ℝ) halfLineMeasure (airyMarkedFactorRow s t)
    (sliceLp halfLineMeasure airyVolterraFactorKernel) hr.aestronglyMeasurable hc.aestronglyMeasurable
    (hr.norm.integrable_mul hc.norm) z).of_norm
  have he (n : ℕ) : kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n =
      kernelFredholmCoeff (𝕜 := ℝ) halfLineMeasure (airyMarkedFactorRow s t)
        (sliceLp halfLineMeasure airyVolterraFactorKernel) n := by
    unfold kernelCoefficient kernelFredholmCoeff
    congr 1
    apply integral_congr_ae
    have hp : ∀ᵐ x ∂Measure.pi (fun _ : Fin n => halfLineMeasure), ∀ i, 0 < x i :=
      eventually_all.2 (fun i => Measure.tendsto_eval_ae_ae.eventually (ae_restrict_mem measurableSet_Ioi))
    filter_upwards [hp] with x hx
    unfold kernelMinor kernelGramMinor
    congr 1
    funext i j
    exact (airyMarkedFactorRow_inner s t (x i) (x j) (hx i).le (hx j).le).symm
  simp_rw [he]
  rw [← kernelFredholmSeries]
  exact kernelFredholmSeries_eq_realOperatorDet_comp halfLineMeasure b
    (airyMarkedFactor s t) airyVolterraFactor.adjoint hA hB (airyMarkedFactorRow s t)
    (sliceLp halfLineMeasure airyVolterraFactorKernel) hr hc (airyMarkedFactor_eval_inner s t) hevalB z |>.trans
      (congrArg (fun T => realOperatorDet b T z) (airyMarkedFactor_comp s t))

theorem airy_rankOne_operator_all_binder_joint_probe :
    ∃ b : HilbertBasis (canonicalIndex ℝ (Lp ℝ 2 halfLineMeasure)) ℝ (Lp ℝ 2 halfLineMeasure),
      airyBoundaryVector 0 ≠ 0 ∧
      (∀ t : ℝ, IsHilbertSchmidt (airyMarkedFactor 0 t)) ∧
      (∀ t z : ℝ, (∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel 0 t) n*z^n) =
        realOperatorDet b (airyHankelShift 0 + t • rankOne ℝ (airyBoundaryVector 0) (airyBoundaryVector 0)) z) := by
  let b := canonicalBasis ℝ (Lp ℝ 2 halfLineMeasure)
  exact ⟨b,airyBoundaryVector_ne_zero 0,airyMarkedFactor_isHilbertSchmidt 0,
    airyRankOneKernel_eq_realOperatorDet b 0⟩
open scoped Classical
set_option maxHeartbeats 1000000
theorem finite_diagonal_rankOne_determinant
    {ι : Type* /- [definition] -/ }
    [Fintype ι /- [definition] -/ ]
    [DecidableEq ι /- [definition] -/ ]
    (d u : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, d i ≠ 0 /- [standing] -/ )
    (t : ℝ /- [definition] -/ )
    : (Matrix.diagonal d + Matrix.of (fun i j => t*u i*u j)).det =
      (∏ i, d i)*(1+t*(∑ i, (u i)^2/d i)) := by
  classical
  have hD : IsUnit (Matrix.diagonal d).det := by
    rw [Matrix.det_diagonal,isUnit_iff_ne_zero]
    exact Finset.prod_ne_zero_iff.mpr (fun i _ => hd i)
  have he : Matrix.of (fun i j => t*u i*u j) =
      Matrix.replicateCol (Fin 1) (fun i => t*u i) * Matrix.replicateRow (Fin 1) u := by
    ext i j
    simp [Matrix.mul_apply]
  have h : (Matrix.diagonal d + Matrix.replicateCol (Fin 1) (fun i => t*u i) * Matrix.replicateRow (Fin 1) u).det =
      (Matrix.diagonal d).det * (1 + Matrix.replicateRow (Fin 1) u * (Matrix.diagonal d)⁻¹ * Matrix.replicateCol (Fin 1) (fun i => t*u i)).det :=
    Matrix.det_add_replicateCol_mul_replicateRow (ι := Fin 1) (A := Matrix.diagonal d) hD (fun i => t*u i) u
  rw [he,h,Matrix.det_fin_one,Matrix.det_diagonal]
  simp only [Matrix.add_apply,Matrix.one_apply_eq]
  congr 2
  have hinv : (Matrix.diagonal d)⁻¹ = Matrix.diagonal (fun i => (d i)⁻¹) := by
    apply Matrix.inv_eq_right_inv
    rw [Matrix.diagonal_mul_diagonal]
    have hv : (fun i => d i*(d i)⁻¹) = fun _ => (1:ℝ) := funext (fun i => mul_inv_cancel₀ (hd i))
    rw [hv,Matrix.diagonal_one]
  simp [Matrix.mul_apply,hinv,Matrix.diagonal_apply]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  ring

theorem airy_eigenvalue_lt_one
    {ι : Type* /- [definition] -/ }
    (s : ℝ /- [definition] -/ )
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (lam : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, airyHankelShift s (b i) = lam i • b i /- [standing] -/ )
    (i : ι /- [definition] -/ )
    : lam i < 1 := by
  have h := (airyHankelShift s).le_opNorm (b i)
  rw [hd i,norm_smul,b.orthonormal.norm_eq_one i,Real.norm_eq_abs,mul_one,mul_one] at h
  exact (le_abs_self _).trans_lt (h.trans_lt (norm_airyHankelShift_lt_one s))

theorem airy_eigenbasis_inverse_coefficient
    {ι : Type* /- [definition] -/ }
    (s : ℝ /- [definition] -/ )
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (lam : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, airyHankelShift s (b i) = lam i • b i /- [standing] -/ )
    (g : Lp ℝ 2 halfLineMeasure /- [definition] -/ )
    (i : ι /- [definition] -/ )
    : inner ℝ (b i) (Ring.inverse (1-airyHankelShift s) g) = inner ℝ (b i) g/(1-lam i) := by
  have h := congrArg (inner ℝ (b i))
    (contraction_ringInverse_right (airyHankelShift s) (norm_airyHankelShift_lt_one s) g)
  rw [inner_sub_right] at h
  have hs := (isSelfAdjoint_airyHankelShift s).isSymmetric
  have hsym : inner ℝ (b i) (airyHankelShift s (Ring.inverse (1-airyHankelShift s) g)) =
      lam i*inner ℝ (b i) (Ring.inverse (1-airyHankelShift s) g) := by
    calc
      _ = inner ℝ (airyHankelShift s (b i)) (Ring.inverse (1-airyHankelShift s) g) := by
        exact (hs (b i) (Ring.inverse (1-airyHankelShift s) g)).symm
      _ = _ := by rw [hd i,real_inner_smul_left]
  rw [hsym] at h
  have hn : 1-lam i ≠ 0 := (sub_pos.mpr (airy_eigenvalue_lt_one s b lam hd i)).ne'
  apply (eq_div_iff hn).mpr
  nlinarith [h]

theorem airy_eigenbasis_inverse_quadratic_hasSum
    {ι : Type* /- [definition] -/ }
    (s : ℝ /- [definition] -/ )
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (lam : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, airyHankelShift s (b i) = lam i • b i /- [standing] -/ )
    (g : Lp ℝ 2 halfLineMeasure /- [definition] -/ )
    : HasSum (fun i => (inner ℝ (b i) g)^2/(1-lam i))
        (inner ℝ g (Ring.inverse (1-airyHankelShift s) g)) := by
  have h := (b.hasSum_repr (Ring.inverse (1-airyHankelShift s) g)).mapL (innerSL ℝ g)
  simpa only [b.repr_apply_apply,innerSL_apply_apply,inner_smul_right,real_inner_comm g,
    airy_eigenbasis_inverse_coefficient s b lam hd,pow_two,div_mul_eq_mul_div] using h

theorem airy_eigenbasis_rankOne_compression_det
    {ι : Type* /- [definition] -/ }
    (s : ℝ /- [definition] -/ )
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (lam : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, airyHankelShift s (b i) = lam i • b i /- [standing] -/ )
    (g : Lp ℝ 2 halfLineMeasure /- [definition] -/ )
    (t : ℝ /- [definition] -/ )
    (v : Finset ι /- [definition] -/ )
    : Matrix.det ((1 : Matrix v v ℝ) - Matrix.of (fun i j : v =>
        inner ℝ (b i) ((airyHankelShift s + t • rankOne ℝ g g) (b j)))) =
      (∏ i ∈ v, (1-lam i))*(1-t*(∑ i ∈ v, (inner ℝ (b i) g)^2/(1-lam i))) := by
  classical
  let d : v → ℝ := fun i => 1-lam i
  let u : v → ℝ := fun i => inner ℝ (b i) g
  have he : (1 : Matrix v v ℝ) - Matrix.of (fun i j : v =>
      inner ℝ (b i) ((airyHankelShift s + t • rankOne ℝ g g) (b j))) =
      Matrix.diagonal d + Matrix.of (fun i j => (-t)*u i*u j) := by
    ext i j
    simp only [Matrix.sub_apply,Matrix.of_apply,ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply,rankOne_apply,inner_add_right,inner_smul_right,hd,
      Matrix.add_apply,Matrix.diagonal_apply,d,u,Matrix.one_apply]
    by_cases hij : i = j
    · subst j
      simp [b.orthonormal.norm_eq_one,real_inner_comm]
      ring
    · have hne : (i : ι) ≠ (j : ι) := fun h => hij (Subtype.ext h)
      simp [hij,orthonormal_iff_ite.mp b.orthonormal,hne,real_inner_comm]
      ring
  rw [he,finite_diagonal_rankOne_determinant d u (fun i =>
    (sub_pos.mpr (airy_eigenvalue_lt_one s b lam hd i)).ne')]
  simp only [d,u]
  rw [Finset.prod_coe_sort v (fun i => 1-lam i),
    Finset.sum_coe_sort v (fun i => (inner ℝ (b i) g)^2/(1-lam i))]
  ring

theorem airy_rankOne_operatorDet_eigenbasis
    {ι : Type* /- [definition] -/ }
    (s : ℝ /- [definition] -/ )
    (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)  /- [definition] -/ )
    (lam : ι → ℝ /- [definition] -/ )
    (hd : ∀ i, airyHankelShift s (b i) = lam i • b i /- [standing] -/ )
    (t : ℝ /- [definition] -/ )
    : realOperatorDet b (airyHankelShift s + t • rankOne ℝ (airyBoundaryVector s) (airyBoundaryVector s)) (-1) =
      TW1R s * (1-t*inner ℝ (airyBoundaryVector s) (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) := by
  letI := airyL2_basis_countable b
  have hfac : ∃ A B : (Lp ℝ 2 halfLineMeasure) →L[ℝ] (Lp ℝ 2 halfLineMeasure),
      airyHankelShift s + t • rankOne ℝ (airyBoundaryVector s) (airyBoundaryVector s) = A ∘L B ∧
      Summable (fun i => ‖A (b i)‖^2) ∧ Summable (fun i => ‖B (b i)‖^2) :=
    ⟨airyMarkedFactor s t,airyVolterraFactor.adjoint,(airyMarkedFactor_comp s t).symm,
      summable_norm_sq_apply_basis (airyMarkedFactor_isHilbertSchmidt s t) b,
      summable_norm_sq_apply_basis (isHilbertSchmidt_kernelOperator memLp_airyVolterraFactorKernel).adjoint b⟩
  have hleft : Tendsto (fun v : Finset ι => Matrix.det ((1 : Matrix v v ℝ) -
      Matrix.of (fun i j : v => inner ℝ (b i)
        ((airyHankelShift s + t • rankOne ℝ (airyBoundaryVector s) (airyBoundaryVector s)) (b j)))))
      atTop (𝓝 (realOperatorDet b (airyHankelShift s + t • rankOne ℝ (airyBoundaryVector s) (airyBoundaryVector s)) (-1))) := by
    simpa only [neg_one_smul,sub_eq_add_neg] using realOperatorDet_matrix_det_tendsto b _ hfac (-1)
  have hp : HasProd (fun i => 1-lam i) (TW1R s) := by
    have ha : Summable (fun i => ‖(-lam i)‖) := by
      simpa only [norm_neg] using airy_eigenbasis_absolute_on s b lam hd
    have hm := multipliable_one_add_of_summable ha
    have hv : TW1R s = ∏' i, (1-lam i) := by
      simpa only [TW1R,TW1,B_fredholm_physical,Complex.ofReal_neg,Complex.ofReal_one,
        neg_one_mul,sub_eq_add_neg] using airy_eigenbasis_product_on s b lam hd (-1)
    rw [hv]
    simpa only [neg_one_mul,sub_eq_add_neg] using hm.hasProd
  have hq := airy_eigenbasis_inverse_quadratic_hasSum s b lam hd (airyBoundaryVector s)
  have hpt : Tendsto (fun v : Finset ι => ∏ i ∈ v, (1-lam i)) atTop (𝓝 (TW1R s)) := hp
  have hqt : Tendsto (fun v : Finset ι => ∑ i ∈ v, (inner ℝ (b i) (airyBoundaryVector s))^2/(1-lam i))
      atTop (𝓝 (inner ℝ (airyBoundaryVector s) (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)))) := hq
  have hright := hpt.mul ((tendsto_const_nhds (x := (1:ℝ))).sub ((tendsto_const_nhds (x := t)).mul hqt))
  simp_rw [airy_eigenbasis_rankOne_compression_det s b lam hd (airyBoundaryVector s) t] at hleft
  exact tendsto_nhds_unique hleft hright

theorem airy_rankOne_operatorDet_canonical
    (s t : ℝ /- [definition] -/ )
    : realOperatorDet (canonicalBasis ℝ (Lp ℝ 2 halfLineMeasure))
        (airyHankelShift s + t • rankOne ℝ (airyBoundaryVector s) (airyBoundaryVector s)) (-1) =
      TW1R s * (1-t*inner ℝ (airyBoundaryVector s) (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) := by
  obtain ⟨ι,b,lam,hd⟩ := compact_symmetric_real_eigenbasis (airyHankelShift s)
    (isTraceClass_airyHankelShift s).isCompactOperator (isSelfAdjoint_airyHankelShift s).isSymmetric
  have h := airy_rankOne_operatorDet_eigenbasis s b lam hd t
  rw [← airyRankOneKernel_eq_realOperatorDet b s t (-1)] at h
  rw [← airyRankOneKernel_eq_realOperatorDet (canonicalBasis ℝ (Lp ℝ 2 halfLineMeasure)) s t (-1)]
  exact h
theorem airyRankOneKernel_series_exact
    (s t : ℝ /- [definition] -/ )
    : (∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n*(-1:ℝ)^n) =
      TW1R s*(1-t*inner ℝ (airyBoundaryVector s) (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) := by
  rw [airyRankOneKernel_eq_realOperatorDet (canonicalBasis ℝ (Lp ℝ 2 halfLineMeasure)),
    airy_rankOne_operatorDet_canonical]

theorem hasDerivAt_airyRankOneKernel_series_resolvent
    (s : ℝ /- [definition] -/ )
    : HasDerivAt
      (fun t => ∑' n, kernelCoefficient halfLineMeasure (airyRankOneKernel s t) n*(-1:ℝ)^n)
      (-TW1R s*inner ℝ (airyBoundaryVector s) (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) 0 := by
  have he := funext (airyRankOneKernel_series_exact s)
  rw [he]
  simpa using
    ((hasDerivAt_const (0:ℝ) (1:ℝ)).fun_sub
      ((hasDerivAt_id (0:ℝ)).mul_const
        (inner ℝ (airyBoundaryVector s) (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))))).const_mul (TW1R s)

theorem airyBoundaryFredholmSeries_eq_canonical_resolvent
    (s : ℝ /- [definition] -/ )
    : (∑' n, airyBoundaryFredholmCoefficient s n*(-1:ℝ)^n) =
      TW1R s*(airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) := by
  rw [airyBoundaryFredholmSeries_eq_rankOne_deriv,
    (hasDerivAt_airyRankOneKernel_series_resolvent s).deriv]
  ring

theorem hasDerivAt_TW1R_canonical_resolvent
    (s : ℝ /- [definition] -/ )
    : HasDerivAt TW1R
      (TW1R s*(airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)))/2) s := by
  rw [← airyBoundaryFredholmSeries_eq_canonical_resolvent]
  exact hasDerivAt_TW1R_boundaryFredholmSeries s

theorem airyFredholmShiftDerivative_eq_canonical_resolvent
    (s : ℝ /- [definition] -/ )
    : (∑' n, airyFredholmCoefficientShiftDerivative s n*(-1:ℝ)^n) =
      TW1R s*(airyAiReal s + inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)))/2 := by
  exact (hasDerivAt_TW1R_series s).unique (hasDerivAt_TW1R_canonical_resolvent s)

theorem finite_diagonal_rankOne_all_binder_joint_probe :
    ∃ d u : Fin 2 → ℝ,
      (∀ i, d i ≠ 0) ∧ (∀ i, u i ≠ 0) ∧
      (∀ t : ℝ, (Matrix.diagonal d + Matrix.of (fun i j => t*u i*u j)).det =
        (∏ i, d i)*(1+t*(∑ i, (u i)^2/d i))) := by
  let d : Fin 2 → ℝ := ![1/2,4/3]
  let u : Fin 2 → ℝ := ![1,2]
  have hd : ∀ i, d i ≠ 0 := by intro i; fin_cases i <;> norm_num [d]
  have hu : ∀ i, u i ≠ 0 := by intro i; fin_cases i <;> norm_num [u]
  exact ⟨d,u,hd,hu,finite_diagonal_rankOne_determinant d u hd⟩

theorem airy_eigenbasis_rankOne_all_binder_joint_probe :
    ∃ (ι : Type) (b : HilbertBasis ι ℝ (Lp ℝ 2 halfLineMeasure)) (lam : ι → ℝ),
      (∀ i, airyHankelShift 0 (b i) = lam i • b i) ∧ airyBoundaryVector 0 ≠ 0 ∧
