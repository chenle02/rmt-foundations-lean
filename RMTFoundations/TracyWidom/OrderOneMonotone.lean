/-- Every positive-coordinate interval uses exactly ordinary Lebesgue integration. -/
theorem airy_completed_interval_eq_restricted
    (s a b : ℝ /- [definition] -/ )
    (ha : 0 ≤ a /- [standing] -/ )
    (hab : a ≤ b /- [standing] -/ )
    : (∫ x in a..b,airyCompletedRow s x^2) =
      ∫ x in Ioc a b,airyCompletedRow s x^2 ∂halfLineMeasure := by
  rw [intervalIntegral.integral_of_le hab]
  have hm : halfLineMeasure.restrict (Ioc a b) = volume.restrict (Ioc a b) :=
    Measure.restrict_restrict_of_subset (by intro x hx; exact lt_of_le_of_lt ha hx.1)
  rw [hm]

/-- A genuine finite rectangle table bounds the full completed-square norm;
no omitted-tail, quadrature-convergence or measurability premise remains. -/
theorem airy_completed_rectangle_norm_lower
    (s a h : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    (q : ℕ → ℝ /- [definition] -/ )
    (ha : 0 ≤ a /- [standing] -/ )
    (hh : 0 ≤ h /- [standing] -/ )
    (hrect : ∀ j < n, ∀ x∈Icc (a+(j:ℝ)*h) (a+((j:ℝ)+1)*h),
      q j ≤ airyCompletedRow s x^2 /- [standing] -/ )
    : h*(∑ j ∈ Finset.range n,q j)  ≤ 
      ‖airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s)‖^2 := by
  have hc : Continuous (fun x => airyCompletedRow s x^2) := (airyCompletedRow_continuous s).pow 2
  have hint (j : ℕ) : IntervalIntegrable (fun x => airyCompletedRow s x^2) volume
      (a+(j:ℝ)*h) (a+((j+1:ℕ):ℝ)*h) := hc.intervalIntegrable _ _
  have hcell (j : ℕ) (hj : j < n) :
      h*q j ≤ ∫ x in (a+(j:ℝ)*h)..(a+((j+1:ℕ):ℝ)*h),airyCompletedRow s x^2 := by
    have hb : a+(j:ℝ)*h ≤ a+((j+1:ℕ):ℝ)*h := by
      rw [Nat.cast_add,Nat.cast_one]; nlinarith
    have hm := intervalIntegral.integral_mono_on hb (intervalIntegrable_const)
      (hint j) (fun x hx => hrect j hj x (by simpa only [Nat.cast_add,Nat.cast_one] using hx))
    simpa only [intervalIntegral.integral_const,smul_eq_mul,Nat.cast_add,Nat.cast_one,
      show a+((j:ℝ)+1)*h-(a+(j:ℝ)*h)=h by ring] using hm
  have hs := Finset.sum_le_sum (fun j hj => hcell j (Finset.mem_range.mp hj))
  rw [←Finset.mul_sum,intervalIntegral.sum_integral_adjacent_intervals
    (fun j _ => hint j)] at hs
  simp only [Nat.cast_zero,zero_mul,add_zero] at hs
  have hab : a ≤ a+(n:ℝ)*h := le_add_of_nonneg_right (mul_nonneg (Nat.cast_nonneg n) hh)
  rw [airy_completed_interval_eq_restricted s a (a+(n:ℝ)*h) ha hab] at hs
  have ht := setIntegral_le_integral (s := Ioc a (a+(n:ℝ)*h))
    (airy_completed_row_sq_integrable s) (Eventually.of_forall fun x => sq_nonneg (airyCompletedRow s x))
  rw [airy_completed_row_sq_integral s] at ht
  exact hs.trans ht

