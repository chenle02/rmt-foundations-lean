/-- Finite derivative approximation uses only the ACTUAL shifted hypergeometric coefficients. -/
noncomputable def complexAiryDerivPartial
    (z : ℂ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    : ℂ := (3:ℂ)^(-2/3:ℂ)*(3*z^2/9)*
        (∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(5/3:ℂ)} n*(z^3/9)^n)-
      (3:ℂ)^(-4/3:ℂ)*(∑ n ∈ Finset.range N,
        complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} n*(z^3/9)^n)-
      (3:ℂ)^(-4/3:ℂ)*z*(3*z^2/9)*(∑ n ∈ Finset.range N,
        complex_regularizedHGFunCoeff 0 {(7/3:ℂ)} n*(z^3/9)^n)

/-- Genuine derivative-series remainder follows from three absolutely convergent
hypergeometric series, with one shared rational ratio budget. -/
theorem complex_airy_deriv_actual_remainder
    (z : ℂ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hq0 : 0≤q /- [standing] -/ )
    (hq1 : q<1 /- [standing] -/ )
    (hz : ‖z^3/9‖≤q*((4/3+(N:ℝ))*(N+1))  /- [standing] -/ )
    : ‖deriv complex_airyAi z-complexAiryDerivPartial z N‖≤
      (‖(3:ℂ)^(-2/3:ℂ)*(3*z^2/9)‖*
          ‖complex_regularizedHGFunCoeff 0 {(5/3:ℂ)} N*(z^3/9)^N‖+
        ‖(3:ℂ)^(-4/3:ℂ)‖*
          ‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} N*(z^3/9)^N‖+
        ‖(3:ℂ)^(-4/3:ℂ)*z*(3*z^2/9)‖*
          ‖complex_regularizedHGFunCoeff 0 {(7/3:ℂ)} N*(z^3/9)^N‖)/(1-q) := by
  have hz5 : ‖z^3/9‖≤q*((5/3+(N:ℝ))*(N+1)) := by apply hz.trans; gcongr; norm_num
  have hz7 : ‖z^3/9‖≤q*((7/3+(N:ℝ))*(N+1)) := by apply hz.trans; gcongr; norm_num
  have h4 := hg_actual_remainder (4/3) (z^3/9) N q (by norm_num) hq0 hq1 hz
  have h5 := hg_actual_remainder (5/3) (z^3/9) N q (by norm_num) hq0 hq1 hz5
  have h7 := hg_actual_remainder (7/3) (z^3/9) N q (by norm_num) hq0 hq1 hz7
  norm_num only [Complex.ofReal_div,Complex.ofReal_ofNat] at h4 h5 h7
  simp only [norm_mul] at h4 h5 h7
  have he : deriv complex_airyAi z-complexAiryDerivPartial z N=
      (3:ℂ)^(-2/3:ℂ)*(3*z^2/9)*(complex_regularizedHGFun 0 {(5/3:ℂ)} (z^3/9)-
        ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(5/3:ℂ)} n*(z^3/9)^n)-
      (3:ℂ)^(-4/3:ℂ)*(complex_regularizedHGFun 0 {(4/3:ℂ)} (z^3/9)-
        ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} n*(z^3/9)^n)-
      (3:ℂ)^(-4/3:ℂ)*z*(3*z^2/9)*(complex_regularizedHGFun 0 {(7/3:ℂ)} (z^3/9)-
        ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(7/3:ℂ)} n*(z^3/9)^n) := by
    rw [complex_deriv_airyAi,complex_deriv_regularizedHGFun_zero_singleton_comp_cube_div_nine,
      complex_deriv_z_mul_four_thirds]
    norm_num only [show (2/3:ℂ)+1=(5/3:ℂ) by norm_num,
      show (4/3:ℂ)+1=(7/3:ℂ) by norm_num]
    unfold complexAiryDerivPartial
    ring
  rw [he]
  calc _ ≤ ‖(3:ℂ)^(-2/3:ℂ)*(3*z^2/9)*(complex_regularizedHGFun 0 {(5/3:ℂ)} (z^3/9)-
          ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(5/3:ℂ)} n*(z^3/9)^n)‖+
        ‖(3:ℂ)^(-4/3:ℂ)*(complex_regularizedHGFun 0 {(4/3:ℂ)} (z^3/9)-
          ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} n*(z^3/9)^n)‖+
        ‖(3:ℂ)^(-4/3:ℂ)*z*(3*z^2/9)*(complex_regularizedHGFun 0 {(7/3:ℂ)} (z^3/9)-
          ∑ n ∈ Finset.range N,complex_regularizedHGFunCoeff 0 {(7/3:ℂ)} n*(z^3/9)^n)‖ :=
          (norm_sub_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
       _ ≤ ‖(3:ℂ)^(-2/3:ℂ)*(3*z^2/9)‖*
          (‖complex_regularizedHGFunCoeff 0 {(5/3:ℂ)} N*(z^3/9)^N‖/(1-q))+
        ‖(3:ℂ)^(-4/3:ℂ)‖*
          (‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} N*(z^3/9)^N‖/(1-q))+
        ‖(3:ℂ)^(-4/3:ℂ)*z*(3*z^2/9)‖*
          (‖complex_regularizedHGFunCoeff 0 {(7/3:ℂ)} N*(z^3/9)^N‖/(1-q)) := by
          simp only [norm_mul]; gcongr
       _ = _ := by ring

/-- Nonzero negative scalar and nonzero ratio jointly inhabit every derivative-remainder binder. -/
theorem airy_deriv_remainder_joint_probe :
    ∃ z : ℂ,∃ N : ℕ,∃ q : ℝ,z≠0 ∧ 0<q ∧ q<1 ∧
      ‖z^3/9‖≤q*((4/3+(N:ℝ))*(N+1)) ∧
      ‖deriv complex_airyAi z-complexAiryDerivPartial z N‖≤
      (‖(3:ℂ)^(-2/3:ℂ)*(3*z^2/9)‖*
          ‖complex_regularizedHGFunCoeff 0 {(5/3:ℂ)} N*(z^3/9)^N‖+
        ‖(3:ℂ)^(-4/3:ℂ)‖*
          ‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} N*(z^3/9)^N‖+
        ‖(3:ℂ)^(-4/3:ℂ)*z*(3*z^2/9)‖*
          ‖complex_regularizedHGFunCoeff 0 {(7/3:ℂ)} N*(z^3/9)^N‖)/(1-q) := by
  refine ⟨-3,8,1/2,by norm_num,by norm_num,by norm_num,?_,?_⟩
  · norm_num [norm_div,norm_pow]
  · apply complex_airy_deriv_actual_remainder _ _ _ (by norm_num) (by norm_num)
    norm_num [norm_div,norm_pow]


/-- All generic normed-space tail hypotheses are realized together by a
nonzero geometric sequence in the actual real normed space. -/
theorem ratio_tail_real_all_binder_joint_probe :
    ∃ f : ℕ→ℝ,∃ a : ℝ,∃ N : ℕ,∃ q : ℝ,
      f N≠0 ∧ 0<q ∧ q<1 ∧ Summable f ∧ (∑' n,f n)=a ∧
      (∀ n,N≤n→‖f (n+1)‖≤q*‖f n‖) ∧
      ‖a-∑ n ∈ Finset.range N,f n‖≤‖f N‖/(1-q) := by
  have hs : HasSum (fun n : ℕ => (1/2:ℝ)^n) 2 := by
    convert! hasSum_geometric_of_lt_one (by norm_num : (0:ℝ)≤1/2)
      (by norm_num : (1/2:ℝ)<1) using 1 <;> norm_num
  have hr : ∀ n : ℕ,1≤n→‖(1/2:ℝ)^(n+1)‖≤(1/2)*‖(1/2:ℝ)^n‖ := by
    intro n _
    have hh : ‖(1/2:ℝ)‖=(1/2:ℝ) := by norm_num
    rw [pow_succ,norm_mul,hh,mul_comm]
  refine ⟨fun n => (1/2:ℝ)^n,2,1,1/2,by norm_num,by norm_num,by norm_num,
    hs.summable,hs.tsum_eq,hr,?_⟩
  exact ratio_tail_remainder (fun n => (1/2:ℝ)^n) 2 1 (1/2)
    (by norm_num) (by norm_num) hs.summable hs.tsum_eq hr


/-- Shift the actual initial hypergeometric coefficient by the Gamma equation. -/
theorem hg_initial_shift_normalized
    (b : ℝ /- [definition] -/ )
    (hb : 0 < b /- [standing] -/ )
    : complex_regularizedHGFunCoeff 0 {((b+1:ℝ):ℂ)} 0 =
      complex_regularizedHGFunCoeff 0 {(b:ℂ)} 0/(b:ℂ) := by
  have hbn : (b:ℂ) ≠ 0 := by exact_mod_cast hb.ne'
  simp only [complex_regularizedHGFunCoeff,Multiset.map_zero,Multiset.prod_zero,
    Multiset.map_singleton,Multiset.prod_singleton,Nat.factorial_zero,Nat.cast_one,
    Nat.cast_zero,add_zero,one_mul]
  rw [Complex.ofReal_add,Complex.ofReal_one,Complex.Gamma_add_one _ hbn]
  ring

/-- Actual derivative polynomial with rational recurrences and the SAME actual initial data. -/
theorem airy_deriv_partial_normalized
    (x : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    : (complexAiryDerivPartial (x:ℂ) N).re =
      airyAiReal 0*(x^2/2)*(∑ n ∈ Finset.range N,normalizedHGCoeff (5/3) n*(x^3/9)^n)+
      deriv airyAiReal 0*((∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n)+
        (x^3/4)*(∑ n ∈ Finset.range N,normalizedHGCoeff (7/3) n*(x^3/9)^n)) := by
  have h5 := hg_initial_shift_normalized (2/3) (by norm_num)
  have h7 := hg_initial_shift_normalized (4/3) (by norm_num)
  norm_num at h5 h7
  have ha := actual_hg_partial_normalized (5/3) (x^3/9) N (by norm_num)
  have hb := actual_hg_partial_normalized (4/3) (x^3/9) N (by norm_num)
  have hc := actual_hg_partial_normalized (7/3) (x^3/9) N (by norm_num)
  norm_num only [Complex.ofReal_div,Complex.ofReal_pow,Complex.ofReal_ofNat] at ha hb hc
  have he : complexAiryDerivPartial (x:ℂ) N =
      ((airyAiReal 0*(x^2/2)*(∑ n ∈ Finset.range N,normalizedHGCoeff (5/3) n*(x^3/9)^n)+
      deriv airyAiReal 0*((∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n)+
        (x^3/4)*(∑ n ∈ Finset.range N,normalizedHGCoeff (7/3) n*(x^3/9)^n)):ℝ):ℂ) := by
    unfold complexAiryDerivPartial
    rw [ha,hb,hc,h5,h7]
    norm_num only [Complex.ofReal_add,Complex.ofReal_mul,Complex.ofReal_div,Complex.ofReal_pow,Complex.ofReal_ofNat]
    rw [show (3:ℂ)*(x:ℂ)^2/9=(x:ℂ)^2/3 by ring]
    have h0 := airy_actual_normalization_factors.1
    have h1 := airy_actual_normalization_factors.2
    norm_num at h0 h1
    linear_combination h0*((x:ℂ)^2/2)*
      ((∑ n ∈ Finset.range N,normalizedHGCoeff (5/3) n*(x^3/9)^n:ℝ):ℂ)-
      h1*(((∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n:ℝ):ℂ)+
      (x:ℂ)^3/4*((∑ n ∈ Finset.range N,normalizedHGCoeff (7/3) n*(x^3/9)^n:ℝ):ℂ))
  rw [he,Complex.ofReal_re]

/-- Rational normalized derivative tail, with no numerical coefficient hypotheses. -/
theorem airy_deriv_actual_normalized_remainder
    (x : ℝ /- [definition] -/ )
    (N : ℕ /- [definition] -/ )
    (q : ℝ /- [definition] -/ )
    (hq0 : 0≤q /- [standing] -/ )
    (hq1 : q<1 /- [standing] -/ )
    (hx : |x^3/9|≤q*((4/3+(N:ℝ))*(N+1))  /- [standing] -/ )
    : |deriv airyAiReal x-
      (airyAiReal 0*(x^2/2)*(∑ n ∈ Finset.range N,normalizedHGCoeff (5/3) n*(x^3/9)^n)+
      deriv airyAiReal 0*((∑ n ∈ Finset.range N,normalizedHGCoeff (4/3) n*(x^3/9)^n)+
        (x^3/4)*(∑ n ∈ Finset.range N,normalizedHGCoeff (7/3) n*(x^3/9)^n)))| ≤
      (|airyAiReal 0| *(x^2/2)*normalizedHGCoeff (5/3) N+
        |deriv airyAiReal 0| *normalizedHGCoeff (4/3) N+
        |deriv airyAiReal 0| *(|x|^3/4)*normalizedHGCoeff (7/3) N)*|x^3/9|^N/(1-q) := by
  have hz : ‖(x:ℂ)^3/9‖=|x^3/9| := by
    rw [← Complex.ofReal_pow,← Complex.ofReal_ofNat,← Complex.ofReal_div,Complex.norm_real,Real.norm_eq_abs]
  have h := complex_airy_deriv_actual_remainder (x:ℂ) N q hq0 hq1 (by rwa [hz])
  have hre : |deriv airyAiReal x-(complexAiryDerivPartial (x:ℂ) N).re|≤
      ‖deriv complex_airyAi (x:ℂ)-complexAiryDerivPartial (x:ℂ) N‖ := by
    simpa only [deriv_airyAiReal,Complex.sub_re] using
      Complex.abs_re_le_norm (deriv complex_airyAi (x:ℂ)-complexAiryDerivPartial (x:ℂ) N)
  rw [airy_deriv_partial_normalized] at hre
  have h5 := hg_initial_shift_normalized (2/3) (by norm_num)
  have h7 := hg_initial_shift_normalized (4/3) (by norm_num)
  norm_num at h5 h7
  have e4 := actual_hg_coeff_normalized (4/3) N (by norm_num)
  have e5 := actual_hg_coeff_normalized (5/3) N (by norm_num)
  have e7 := actual_hg_coeff_normalized (7/3) N (by norm_num)
  norm_num only [Complex.ofReal_div,Complex.ofReal_ofNat] at e4 e5 e7
  have hn0 : ‖(3:ℂ)^(-2/3:ℂ)‖*‖complex_regularizedHGFunCoeff 0 {(2/3:ℂ)} 0‖=|airyAiReal 0| := by
    simpa only [norm_mul,Complex.norm_real,Real.norm_eq_abs] using congrArg norm airy_actual_normalization_factors.1
  have hn1 : ‖(3:ℂ)^(-4/3:ℂ)‖*‖complex_regularizedHGFunCoeff 0 {(4/3:ℂ)} 0‖=|deriv airyAiReal 0| := by
    simpa only [norm_mul,norm_neg,Complex.norm_real,Real.norm_eq_abs] using congrArg norm airy_actual_normalization_factors.2
  norm_num at hn0 hn1
  rw [e4,e5,e7,h5,h7] at h
  simp only [norm_mul,norm_pow,norm_div,Complex.norm_real,Real.norm_eq_abs,hz,
    abs_of_pos (normalized_hg_coeff_positive (4/3) N (by norm_num)),
    abs_of_pos (normalized_hg_coeff_positive (5/3) N (by norm_num)),
    abs_of_pos (normalized_hg_coeff_positive (7/3) N (by norm_num))] at h
  norm_num only [Complex.norm_ofNat,abs_of_pos (by norm_num : (0:ℝ)<3)] at h
  apply hre.trans
  convert! h using 1
  rw [←hn0,←hn1]
  ring_nf
  rw [sq_abs]
  ring

/-- Uniform rational derivative error on the exact scalar grid evaluation range. -/
theorem airy_deriv_actual_uniform_rational_remainder
    (x : ℝ /- [definition] -/ )
    (hx : |x|≤6 /- [standing] -/ )
    : |deriv airyAiReal x-
      (airyAiReal 0*(x^2/2)*(∑ n ∈ Finset.range 32,normalizedHGCoeff (5/3) n*(x^3/9)^n)+
      deriv airyAiReal 0*((∑ n ∈ Finset.range 32,normalizedHGCoeff (4/3) n*(x^3/9)^n)+
        (x^3/4)*(∑ n ∈ Finset.range 32,normalizedHGCoeff (7/3) n*(x^3/9)^n)))|≤1/10^18 := by
  have hw : |x^3/9|≤24 := by
    rw [abs_div,abs_pow]
    norm_num only [abs_of_pos (by norm_num : (0:ℝ)<9)]
    calc |x|^3/9≤(6:ℝ)^3/9 := by gcongr
         _ = 24 := by norm_num
  have h := airy_deriv_actual_normalized_remainder x 32 (1/2) (by norm_num) (by norm_num)
    (by norm_num; linarith)
  have hi := airy_actual_initial_rational_bounds
  have h0 : |airyAiReal 0|≤1 := by rw [abs_of_pos airyAiReal_zero_pos]; linarith [hi.2.1]
  have h1 : |deriv airyAiReal 0|≤1 := by rw [abs_of_neg deriv_airyAiReal_zero_neg]; linarith [hi.2.2.1]
  have hx2 : x^2≤36 := by simpa only [sq_abs,show (6:ℝ)^2=36 by norm_num] using pow_le_pow_left₀ (abs_nonneg x) hx 2
  have hp4 := (normalized_hg_coeff_positive (4/3) 32 (by norm_num)).le
  have hp5 := (normalized_hg_coeff_positive (5/3) 32 (by norm_num)).le
  have hp7 := (normalized_hg_coeff_positive (7/3) 32 (by norm_num)).le
  have hmul0 : |airyAiReal 0| *(x^2/2)≤18 := by
    calc _ ≤ (1:ℝ)*(36/2) := by gcongr
         _ = 18 := by norm_num
  have hmul1 : |deriv airyAiReal 0| *(|x|^3/4)≤54 := by
    calc _ ≤ (1:ℝ)*(6^3/4) := by gcongr
         _ = 54 := by norm_num
  have hc : (18*normalizedHGCoeff (5/3) 32+normalizedHGCoeff (4/3) 32+
      54*normalizedHGCoeff (7/3) 32)*(24:ℝ)^32/(1-(1/2:ℝ))≤1/10^18 := by
    norm_num [normalizedHGCoeff]
  apply h.trans
  apply le_trans _ hc
  gcongr
  simpa only [one_mul] using mul_le_mul_of_nonneg_right h1 hp4

/-- Shared genuine initial values inhabit every derivative approximation binder jointly. -/
theorem airy_deriv_normalized_joint_probe :
    airyAiReal 0 ≠ 0 ∧ deriv airyAiReal 0 ≠ 0 ∧
      (-3:ℝ) ≠ 0 ∧ |(-3:ℝ)|≤6 ∧
      |deriv airyAiReal (-3)-
      (airyAiReal 0*((-3:ℝ)^2/2)*(∑ n ∈ Finset.range 32,normalizedHGCoeff (5/3) n*(-3:ℝ)^n)+
      deriv airyAiReal 0*((∑ n ∈ Finset.range 32,normalizedHGCoeff (4/3) n*(-3:ℝ)^n)+
        ((-3:ℝ)^3/4)*(∑ n ∈ Finset.range 32,normalizedHGCoeff (7/3) n*(-3:ℝ)^n)))|≤1/10^18 := by
  refine ⟨airyAiReal_zero_pos.ne',deriv_airyAiReal_zero_neg.ne,by norm_num,by norm_num,?_⟩
  simpa only [show (-3:ℝ)^3/9=(-3:ℝ) by norm_num] using
    airy_deriv_actual_uniform_rational_remainder (-3) (by norm_num)


/-- Four rational corners certify a product for arbitrary signed real inputs. -/
theorem real_box_mul
    (u v ul uh vl vh lo hi : ℝ /- [definition] -/ )
    (hu : ul≤u ∧ u≤uh /- [standing] -/ )
