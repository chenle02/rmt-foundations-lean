/-- The exact closed rational cells cover the full compact shift window. -/
theorem airy_first_square_nonneg_rational_window
    (s : ℝ /- [definition] -/ )
    (hs : s∈Icc (-27/5:ℝ) 0 /- [standing] -/ )
    : 0≤airyAiReal s+(airyEnergy s+
      ‖airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s)‖^2)/2 := by
  have hm : s∈Icc (-27/5:ℝ) ((-27/5:ℝ)+(270:ℝ)*(1/50)) := by
    norm_num at hs ⊢
    exact hs
  obtain ⟨j,hj,hd⟩ := real_closed_slab_grid_cover (-27/5) (1/50) 270
    (by norm_num) (by norm_num) s hm
  have hb := abs_le.mp hd
  have hc : s∈Icc ((-27/5:ℝ)+(j:ℝ)/50) ((-27/5:ℝ)+((j:ℝ)+1)/50) := by
    constructor <;> linarith [hb.1,hb.2]
  exact airy_closed_slab_first_square_nonneg j (Finset.mem_range.mp hj) s hc

/-- The canonical physical boundary resolvent has its sign discharged on the whole real line. -/
theorem airy_canonical_boundary_nonnegative
    (s : ℝ /- [definition] -/ )
    : 0≤airyAiReal s+inner ℝ (airyBoundaryVector s)
      (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s)) := by
  by_cases hl : s≤(-27/5:ℝ)
  · exact airy_boundary_nonneg_left_of_rational_endpoint s hl
  by_cases hr : 0 ≤ s
  · exact (airy_hankel_inverse_boundary_pos_of_nonneg s hr).le
  exact (airy_first_square_nonneg_rational_window s
    ⟨(le_of_not_ge hl),(le_of_not_ge hr)⟩).trans (airy_square_one_term_lower s)

/-- The physical GOE Fredholm function is monotone on the entire real line. -/
theorem monotone_TW1R : Monotone TW1R :=
  monotone_TW1R_iff_canonical_boundary_nonneg.mpr airy_canonical_boundary_nonnegative

/-- All interval and global theorems coexist on actual nonzero negative Airy data. -/
theorem airy_global_monotonicity_all_binder_joint_probe :
    airyBoundaryVector (-3)≠0 ∧ airyAiReal (-3)<0 ∧ (-3:ℝ)∈Icc (-27/5) 0 ∧
      (0:ℝ)≤airyAiReal (-3)+(airyEnergy (-3)+
        ‖airyBoundaryVector (-3)+airyHankelShift (-3) (airyBoundaryVector (-3))‖^2)/2 ∧
      (∀ (j : ℕ),j<270 → ∀ s∈Icc ((-27/5:ℝ)+(j:ℝ)/50) ((-27/5:ℝ)+((j:ℝ)+1)/50),
        (0:ℝ)≤airyAiReal s+(airyEnergy s+
          ‖airyBoundaryVector s+airyHankelShift s (airyBoundaryVector s)‖^2)/2) ∧
      (∀ s : ℝ,(0:ℝ)≤airyAiReal s+inner ℝ (airyBoundaryVector s)
        (Ring.inverse (1-airyHankelShift s) (airyBoundaryVector s))) ∧ Monotone TW1R := by
  exact ⟨airyBoundaryVector_ne_zero _,by linarith [airy_anchor_three_scalar_boxes.2.1],
    by norm_num,airy_first_square_nonneg_rational_window (-3) (by norm_num),
    airy_closed_slab_first_square_nonneg,airy_canonical_boundary_nonnegative,monotone_TW1R⟩

end RMTFoundations.TWOneMonotone

