  exact div_pos (mul_pos (TW1R_positive_bounds s).1
    (airy_hankel_inverse_boundary_pos_of_nonneg s hn)) (by norm_num)

theorem airy_monotonicity_assembly_joint_probe :
    airyBoundaryVector 0 ≠ 0 ∧ 0 < TW1R 0 ∧
