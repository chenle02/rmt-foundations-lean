/-- Closed centered cells exhaust the exact interval, including its right endpoint. -/
theorem real_closed_slab_grid_cover
    (a h : ℝ /- [definition] -/ )
    (n : ℕ /- [definition] -/ )
    (hh : 0 < h /- [standing] -/ )
    (hn : 0 < n /- [standing] -/ )
    (s : ℝ /- [definition] -/ )
    (hs : s ∈ Icc a (a+(n:ℝ)*h)  /- [standing] -/ )
    : ∃ j ∈ Finset.range n, |s-(a+((j:ℝ)+1/2)*h)| ≤ h/2 := by
  by_cases he : s=a+(n:ℝ)*h
  · refine ⟨n-1,Finset.mem_range.mpr (Nat.sub_lt hn (by norm_num)),?_⟩
    rw [he,Nat.cast_sub (Nat.succ_le_iff.mpr hn)]
    norm_num only [Nat.cast_succ,Nat.cast_zero,zero_add]
    have hdiff : a+(n:ℝ)*h-(a+((n:ℝ)-1+1/2)*h)=h/2 := by ring
    rw [hdiff,abs_of_pos (by positivity : 0<h/2)]
  · have hslt : s<a+(n:ℝ)*h := lt_of_le_of_ne hs.2 he
    let q := (s-a)/h
    have hq : 0 ≤ q := div_nonneg (sub_nonneg.mpr hs.1) hh.le
    have hqn : q < (n:ℝ) := by
      dsimp [q]
      apply (div_lt_iff₀ hh).mpr
      linarith
    let j := Nat.floor q
    have hj : j < n := (Nat.floor_lt hq).mpr hqn
    have hlo := Nat.floor_le hq
    have hhi := Nat.lt_floor_add_one q
    have hl : a+(j:ℝ)*h ≤ s := by
      have h := (le_div_iff₀ hh).mp hlo
      dsimp [q,j] at h ⊢
      linarith
    have hu : s < a+((j:ℝ)+1)*h := by
      have h := (div_lt_iff₀ hh).mp hhi
      dsimp [q,j] at h ⊢
      linarith
    refine ⟨j,Finset.mem_range.mpr hj,abs_le.mpr ⟨?_,?_⟩⟩ <;> linarith



